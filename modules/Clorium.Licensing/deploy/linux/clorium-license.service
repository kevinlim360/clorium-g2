[Unit]
Description=Clorium license server
After=network-online.target
Wants=network-online.target

[Service]
User=clorium-license
Group=clorium-license
WorkingDirectory=/opt/clorium-license/current
ExecStart=/usr/bin/dotnet /opt/clorium-license/current/Clorium.LicenseServer.dll --data /var/lib/clorium-license/data --urls http://127.0.0.1:5088
Environment=DOTNET_gcServer=0
Environment=DOTNET_GCConserveMemory=7
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=ASPNETCORE_ENVIRONMENT=Production
# systemd ignores names containing dots, so only the default level can be set here.
Environment=Logging__LogLevel__Default=Warning
Restart=on-failure
RestartSec=5
MemoryMax=300M
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/clorium-license
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
