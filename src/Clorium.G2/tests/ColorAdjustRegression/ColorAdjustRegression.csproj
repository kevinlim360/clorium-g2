<Project Sdk="Microsoft.NET.Sdk">
  <!-- G2 colour correction engine regression: real Magick.NET 14.12 (netstandard2.0) + native Magick.Native-Q8-x64 from the dev runtime. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../projects/CameraControl/CameraControl/Classes/G2ImageAdjust.cs" Link="G2ImageAdjust.cs" />
    <Compile Include="../../projects/CameraControl/CameraControl/Classes/G2ColorTemplates.cs" Link="G2ColorTemplates.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Magick.NET-Q8-x64"><HintPath>../../dependencies/Managed/Magick.NET-Q8-x64.dll</HintPath></Reference>
    <Reference Include="Magick.NET.Core"><HintPath>../../dependencies/Managed/Magick.NET.Core.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="../../../../.local/g2-runtime/Magick.Native-Q8-x64.dll" Link="Magick.Native-Q8-x64.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../../../.local/g2-runtime/Magick.Native-Q8-x64.dll')" />
  </ItemGroup>
</Project>
