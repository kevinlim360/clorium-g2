<?xml version="1.0" encoding="utf-8"?>
<!--
  Clorium G2 · design A (light) shared theme.
  Tokens, fonts, stroke icons and control styles drawn fresh for the G2 UI.
  Merged by MainWindow, LayoutNormal and Controler. No legacy MaterialDesign/MahApps visuals are used here.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== fonts (embedded, OFL) ===== -->
  <FontFamily x:Key="G2Font">pack://application:,,,/CameraControl;component/fonts/#Noto Sans KR, Malgun Gothic</FontFamily>
  <FontFamily x:Key="G2Mono">pack://application:,,,/CameraControl;component/fonts/#JetBrains Mono, Consolas</FontFamily>

  <!-- ===== colour tokens ===== -->
  <Color x:Key="G2AccentColor">#FF1F5FD6</Color>
  <SolidColorBrush x:Key="G2Page" Color="#FFF3F4F6" />
  <SolidColorBrush x:Key="G2Panel" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="G2Panel2" Color="#FFF3F4F6" />
