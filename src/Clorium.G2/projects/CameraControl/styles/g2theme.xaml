  <Style x:Key="G2IconPath" TargetType="Path">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
  </Style>

  <!-- ===== typography ===== -->
  <Style x:Key="G2MonoText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource G2Mono}" />
  </Style>
  <Style x:Key="G2SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource G2Fs13_5}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource G2Text}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="G2Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource G2Fs11_5}" />
    <Setter Property="Foreground" Value="{StaticResource G2Sub}" />
  </Style>

  <!-- ===== buttons ===== -->
  <!-- Tag carries the corner radius so one template serves every button size. -->
  <ControlTemplate x:Key="G2PlainButtonTemplate" TargetType="ButtonBase">
    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="bd" Property="Background" Value="{StaticResource G2Hover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="bd" Property="Background" Value="{StaticResource G2AccentSoft}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.4" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="G2ButtonBase" TargetType="ButtonBase">
    <Setter Property="Template" Value="{StaticResource G2PlainButtonTemplate}" />
    <Setter Property="Tag" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource G2Text}" />
    <Setter Property="FontFamily" Value="{StaticResource G2Font}" />
    <Setter Property="FontSize" Value="{DynamicResource G2Fs12_5}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- left rail: icon over label, 60x56 -->
  <Style x:Key="G2RailButton" TargetType="Button" BasedOn="{StaticResource G2ButtonBase}">
    <Setter Property="Tag" Value="10" />
    <Setter Property="Width" Value="{DynamicResource G2RailBtnW}" />
    <Setter Property="Height" Value="{DynamicResource G2RailBtnH}" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="Foreground" Value="{StaticResource G2Sub}" />
    <Setter Property="FontSize" Value="{DynamicResource G2Fs11}" />
  </Style>

  <!-- small square icon button (toolbar, card headers) -->
  <Style x:Key="G2IconButton" TargetType="Button" BasedOn="{StaticResource G2ButtonBase}">
    <Setter Property="Tag" Value="7" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
  </Style>

  <!-- quiet bordered button with text -->
  <Style x:Key="G2GhostButton" TargetType="Button" BasedOn="{StaticResource G2ButtonBase}">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="{StaticResource G2Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource G2Line}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- large tile (F / B / D, background capture) -->
  <Style x:Key="G2TileButton" TargetType="Button" BasedOn="{StaticResource G2ButtonBase}">
    <Setter Property="Tag" Value="12" />
    <Setter Property="Height" Value="70" />
    <Setter Property="Background" Value="{StaticResource G2Panel2}" />
    <Setter Property="BorderBrush" Value="{StaticResource G2Line}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- popup tool tile (icon + label) -->
  <Style x:Key="G2ToolTile" TargetType="Button" BasedOn="{StaticResource G2ButtonBase}">
    <Setter Property="Tag" Value="10" />
    <Setter Property="Width" Value="{DynamicResource G2ToolTileW}" />
    <Setter Property="Height" Value="{DynamicResource G2ToolTileH}" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Foreground" Value="{StaticResource G2Sub}" />
    <Setter Property="FontSize" Value="{DynamicResource G2Fs11}" />
  </Style>

  <Style x:Key="G2PrimaryButton" TargetType="Button">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="{StaticResource G2Accent}" />
    <Setter Property="FontFamily" Value="{StaticResource G2Font}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource G2AccentHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource G2SwitchOff}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="G2IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource G2ButtonBase}">
    <Setter Property="Foreground" Value="{StaticResource G2Sub}" />
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="{StaticResource G2Accent}" />
        <Setter Property="Background" Value="{StaticResource G2AccentSoft}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== switch (CheckBox / ToggleButton) ===== -->
  <Style x:Key="G2Switch" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{StaticResource G2Text}" />
    <Setter Property="FontFamily" Value="{StaticResource G2Font}" />
    <Setter Property="FontSize" Value="{DynamicResource G2Fs12_5}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <DockPanel>
              <Border x:Name="pill" DockPanel.Dock="Right" Width="34" Height="20" CornerRadius="10" Background="{StaticResource G2SwitchOff}" Padding="2" VerticalAlignment="Center" Margin="8,0,0,0">
                <Ellipse x:Name="knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" />
              </Border>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="pill" Property="Background" Value="{StaticResource G2Accent}" />
              <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- segmented choice (RadioButton) -->
  <Style x:Key="G2Segment" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{StaticResource G2Sub}" />
    <Setter Property="FontFamily" Value="{StaticResource G2Font}" />
    <Setter Property="FontSize" Value="{DynamicResource G2Fs12}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Height="28" CornerRadius="6" Background="Transparent" Padding="10,0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource G2Panel}" />
              <Setter Property="Foreground" Value="{StaticResource G2Accent}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource G2Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- plain square check (implicit CheckBox look) -->
  <Style x:Key="G2CheckBox" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{StaticResource G2Text}" />
    <Setter Property="FontFamily" Value="{StaticResource G2Font}" />
    <Setter Property="FontSize" Value="{DynamicResource G2Fs12_5}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="box" Width="16" Height="16" CornerRadius="4" BorderThickness="1.5" BorderBrush="{StaticResource G2Line2}" Background="{StaticResource G2Panel}" VerticalAlignment="Center">
              <Path x:Name="mark" Data="M3.5,8 L6.5,11 L12.5,4.5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
            </Border>
            <ContentPresenter x:Name="cp" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Background" Value="{StaticResource G2Accent}" />
              <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource G2Accent}" />
              <Setter TargetName="mark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="cp" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== cards / lists ===== -->
  <Style x:Key="G2Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource G2Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource G2Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style x:Key="G2Divider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource G2Line}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="G2ListItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource G2Text}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bd" MinHeight="28" Padding="7,0" CornerRadius="7" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource G2Panel2}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource G2AccentSoft}" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource G2Accent}" />
              <Setter Property="FontWeight" Value="Bold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="G2List" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource G2Text}" />
    <Setter Property="FontFamily" Value="{StaticResource G2Font}" />
    <Setter Property="FontSize" Value="{DynamicResource G2Fs12_5}" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource G2ListItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== expander (section with chevron) ===== -->
  <Style x:Key="G2Expander" TargetType="Expander">
    <Setter Property="Foreground" Value="{StaticResource G2Text}" />
    <Setter Property="FontFamily" Value="{StaticResource G2Font}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Top" Height="36" Cursor="Hand" FocusVisualStyle="{x:Null}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="hb" Background="Transparent" CornerRadius="7" Padding="2,0,4,0">
                    <DockPanel>
                      <Path x:Name="chev" DockPanel.Dock="Right" Width="24" Height="24" Data="{StaticResource G2IcoChevron}" Stroke="{StaticResource G2Sub}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5">
                        <Path.LayoutTransform>
                          <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                        </Path.LayoutTransform>
                        <Path.RenderTransform>
                          <RotateTransform x:Name="rt" Angle="-90" />
                        </Path.RenderTransform>
                      </Path>
                      <ContentPresenter VerticalAlignment="Center" />
                    </DockPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="hb" Property="Background" Value="{StaticResource G2Panel2}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="chev" Property="RenderTransform">
                        <Setter.Value>
                          <RotateTransform Angle="0" />
                        </Setter.Value>
                      </Setter>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
              <TextBlock Style="{StaticResource G2SectionTitle}" Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" />
            </ToggleButton>
            <ContentPresenter x:Name="body" Margin="0,2,0,6" Visibility="Collapsed" />
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="body" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== combo box ===== -->
  <Style x:Key="G2ComboItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource G2Text}" />
    <Setter Property="FontFamily" Value="{StaticResource G2Font}" />
    <Setter Property="FontSize" Value="{DynamicResource G2Fs12_5}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bd" MinHeight="28" Padding="8,3" CornerRadius="6" Background="Transparent">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource G2Panel2}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource G2AccentSoft}" />
              <Setter Property="Foreground" Value="{StaticResource G2Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="G2ComboBox" TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource G2Text}" />
    <Setter Property="Background" Value="{StaticResource G2Panel2}" />
    <Setter Property="BorderBrush" Value="{StaticResource G2Line}" />
    <Setter Property="FontFamily" Value="{StaticResource G2Mono}" />
    <Setter Property="FontSize" Value="{DynamicResource G2Fs12_5}" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource G2ComboItem}" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="tg" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="bd" CornerRadius="7" BorderThickness="1" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                    <Path HorizontalAlignment="Right" Margin="0,0,4,0" Width="24" Height="24" Data="{StaticResource G2IcoChevron}" Stroke="{StaticResource G2Sub}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                      <Path.LayoutTransform>
                        <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
                      </Path.LayoutTransform>
                    </Path>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource G2Line2}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource G2Accent}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Margin="10,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None" VerticalOffset="4" IsOpen="{TemplateBinding IsDropDownOpen}">
              <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,0,8,8" Padding="4" CornerRadius="9" Background="{StaticResource G2Panel}" BorderBrush="{StaticResource G2Line2}" BorderThickness="1">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.2" />
                </Border.Effect>
                <ScrollViewer>
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== text box ===== -->
  <Style x:Key="G2TextBox" TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource G2Text}" />
    <Setter Property="Background" Value="{StaticResource G2Panel2}" />
    <Setter Property="BorderBrush" Value="{StaticResource G2Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource G2Font}" />
    <Setter Property="FontSize" Value="{DynamicResource G2Fs12_5}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CaretBrush" Value="{StaticResource G2Accent}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource G2Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== slider ===== -->
  <Style x:Key="G2SliderRepeat" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent">
            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="G2Slider" TargetType="Slider">
    <Setter Property="Height" Value="22" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Track x:Name="PART_Track">
            <Track.DecreaseRepeatButton>
              <RepeatButton Style="{StaticResource G2SliderRepeat}" Background="{StaticResource G2Accent}" Command="Slider.DecreaseLarge" />
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
              <RepeatButton Style="{StaticResource G2SliderRepeat}" Background="{StaticResource G2Line}" Command="Slider.IncreaseLarge" />
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Ellipse Width="16" Height="16" Fill="White" Stroke="{StaticResource G2Accent}" StrokeThickness="2" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== thin scroll bar ===== -->
  <Style x:Key="G2ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="t" CornerRadius="3" Background="#FFC9CED5" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="t" Property="Background" Value="{StaticResource G2Line2}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="G2ScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="G2ScrollBar" TargetType="ScrollBar">
    <Setter Property="Width" Value="8" />
    <Setter Property="MinWidth" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,2">
            <Track.DecreaseRepeatButton>
              <RepeatButton Style="{StaticResource G2ScrollPage}" Command="ScrollBar.PageUpCommand" />
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
              <RepeatButton Style="{StaticResource G2ScrollPage}" Command="ScrollBar.PageDownCommand" />
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
              <Thumb Style="{StaticResource G2ScrollThumb}" />
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="8" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2,1">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource G2ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource G2ScrollPage}" Command="ScrollBar.PageRightCommand" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource G2ScrollThumb}" />
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== menus (logo menu, context menus) ===== -->
  <Style x:Key="G2ContextMenu" TargetType="ContextMenu">
    <Setter Property="FontFamily" Value="{StaticResource G2Font}" />
    <Setter Property="FontSize" Value="{DynamicResource G2Fs13}" />
    <Setter Property="Foreground" Value="{StaticResource G2Text}" />
    <Setter Property="HasDropShadow" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Margin="0,0,10,10" Padding="5" CornerRadius="10" Background="{StaticResource G2Panel}" BorderBrush="{StaticResource G2Line2}" BorderThickness="1">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.22" />
            </Border.Effect>
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="G2MenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource G2Text}" />
    <Setter Property="FontFamily" Value="{StaticResource G2Font}" />
    <Setter Property="FontSize" Value="{DynamicResource G2Fs13}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Grid>
            <Border x:Name="bd" MinWidth="200" Height="32" CornerRadius="6" Background="Transparent" Padding="10,0,8,0">
              <DockPanel>
                <Path x:Name="sub" DockPanel.Dock="Right" Width="24" Height="24" Data="{StaticResource G2IcoChevronR}" Stroke="{StaticResource G2Sub}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed">
                  <Path.LayoutTransform>
                    <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
                  </Path.LayoutTransform>
                </Path>
                <TextBlock x:Name="gesture" DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource G2Mono}" FontSize="{DynamicResource G2Fs11}" Foreground="{StaticResource G2Sub}" Text="{TemplateBinding InputGestureText}" />
                <Border x:Name="check" DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" CornerRadius="4" BorderThickness="1.5" BorderBrush="{StaticResource G2Line2}" VerticalAlignment="Center" Visibility="Collapsed">
                  <Path x:Name="mark" Data="M3.5,8 L6.5,11 L12.5,4.5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                </Border>
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </DockPanel>
            </Border>
            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="2" VerticalOffset="-6" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
              <Border Margin="0,0,10,10" Padding="5" CornerRadius="10" Background="{StaticResource G2Panel}" BorderBrush="{StaticResource G2Line2}" BorderThickness="1">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.22" />
                </Border.Effect>
                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="True">
              <Setter TargetName="sub" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsCheckable" Value="True">
              <Setter TargetName="check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="check" Property="Background" Value="{StaticResource G2Accent}" />
              <Setter TargetName="check" Property="BorderBrush" Value="{StaticResource G2Accent}" />
              <Setter TargetName="mark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource G2Panel2}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource G2AccentSoft}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="G2MenuSeparator" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="6,4" Background="{StaticResource G2Line}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== tool tip ===== -->
  <Style x:Key="G2ToolTip" TargetType="ToolTip">
    <Setter Property="FontFamily" Value="{StaticResource G2Font}" />
    <Setter Property="FontSize" Value="{DynamicResource G2Fs12}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="#E6202328" CornerRadius="6" Padding="9,5" Margin="0,0,6,6" MaxWidth="360">
            <ContentPresenter>
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- implicit styles: every standard control inside a G2 surface gets the G2 look -->
  <Style TargetType="ComboBox" BasedOn="{StaticResource G2ComboBox}" />
  <Style TargetType="ComboBoxItem" BasedOn="{StaticResource G2ComboItem}" />
  <Style TargetType="CheckBox" BasedOn="{StaticResource G2CheckBox}" />
  <Style TargetType="TextBox" BasedOn="{StaticResource G2TextBox}" />
  <Style TargetType="Slider" BasedOn="{StaticResource G2Slider}" />
  <Style TargetType="ScrollBar" BasedOn="{StaticResource G2ScrollBar}" />
  <Style TargetType="ToolTip" BasedOn="{StaticResource G2ToolTip}" />
  <Style TargetType="ContextMenu" BasedOn="{StaticResource G2ContextMenu}" />
  <Style TargetType="MenuItem" BasedOn="{StaticResource G2MenuItem}" />
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource G2MenuSeparator}" />
  <Style TargetType="Label">
    <Setter Property="Foreground" Value="{StaticResource G2Text}" />
    <Setter Property="FontFamily" Value="{StaticResource G2Font}" />
    <Setter Property="Padding" Value="0" />
  </Style>
</ResourceDictionary>
