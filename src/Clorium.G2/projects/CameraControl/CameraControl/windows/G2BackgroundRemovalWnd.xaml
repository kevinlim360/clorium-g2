<?xml version="1.0" encoding="utf-8"?>
<!--
  Clorium G2 · 배경제거. G2's own screen for the local Matting Studio engine (Classes/CloriumBackgroundRemoval.cs):
  pick photos or a folder, scan (nothing is written), then process into *_bgr folders next to the originals.
  Tokens/styles: styles/g2theme.xaml (밝은/어두운 화면 via DynamicResource).
-->
<Window x:Class="CameraControl.windows.G2BackgroundRemovalWnd" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="배경제거" Width="1200" Height="800" MinWidth="960" MinHeight="620" WindowStartupLocation="CenterOwner" Background="{DynamicResource G2Page}" FontFamily="{DynamicResource G2Font}" TextElement.Foreground="{DynamicResource G2Text}" TextElement.FontSize="13" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True" Closing="Window_Closing">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/CameraControl;component/styles/g2theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="BrLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource G2Sub}" />
        <Setter Property="Margin" Value="0,12,0,6" />
      </Style>
      <Style x:Key="BrProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ProgressBar">
              <Grid>
                <Border x:Name="PART_Track" CornerRadius="3" Background="{DynamicResource G2Panel2}" />
                <Border x:Name="PART_Indicator" CornerRadius="3" Background="{DynamicResource G2Accent}" HorizontalAlignment="Left" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>      <Style x:Key="BrSegments" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource G2Panel2}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
      </Style>
      <Style x:Key="BrStageLabel" TargetType="Border">
        <Setter Property="Background" Value="#CC16181C" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
      </Style>
      <!-- transparency checkerboard over G2Stage (fixed half-tone so it reads in both themes) -->
      <DrawingBrush x:Key="BrChecker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
          <DrawingGroup>
            <GeometryDrawing Brush="#00000000" Geometry="M0,0 H2 V2 H0 Z" />
            <GeometryDrawing Brush="#26808080" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
          </DrawingGroup>
        </DrawingBrush.Drawing>
      </DrawingBrush>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="360" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===================== settings ===================== -->
    <Border Grid.Column="0" Background="{DynamicResource G2Panel}" BorderBrush="{DynamicResource G2Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="18,16,16,16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Viewbox Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0">
            <Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoLayers}" Stroke="{DynamicResource G2Accent}" />
          </Viewbox>
          <TextBlock Grid.Column="1" Style="{StaticResource G2SectionTitle}" FontSize="16" Text="배경제거" />
          <Border x:Name="EngineChip" Grid.Column="2" CornerRadius="10" Padding="10,2" Background="{DynamicResource G2Neutral}" VerticalAlignment="Center">
            <TextBlock x:Name="EngineText" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource G2NeutralText}" Text="엔진 확인 중" />
          </Border>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock x:Name="SettingsHint" Style="{StaticResource G2Caption}" TextWrapping="Wrap" Margin="0,0,0,10" Text="원본은 그대로 두고, 옆의 _bgr 폴더에 투명 배경 PNG로 저장합니다." />
          <Grid>
            <Button x:Name="StartButton" Style="{StaticResource G2PrimaryButton}" Height="42" FontSize="14" FontWeight="SemiBold" IsEnabled="False" Click="Start_Click">
              <TextBlock HorizontalAlignment="Center" Text="배경 제거 시작" />
            </Button>
            <Button x:Name="StopButton" Style="{StaticResource G2GhostButton}" Height="42" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource G2Err}" Visibility="Collapsed" Click="Stop_Click" Content="중지" />
          </Grid>
          <Button x:Name="OpenOutputButton" Style="{StaticResource G2GhostButton}" Height="36" Margin="0,8,0,0" IsEnabled="False" Click="OpenOutput_Click">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Viewbox Width="15" Height="15" Margin="0,0,7,0"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoFolder}" /></Viewbox>
              <TextBlock VerticalAlignment="Center" Text="결과 폴더 열기" />
            </StackPanel>
          </Button>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,12" Padding="0,0,8,0">
          <StackPanel>
            <!-- target -->
            <Border Style="{StaticResource G2Card}" Padding="14,12">
              <StackPanel>
                <TextBlock Style="{StaticResource G2SectionTitle}" Text="대상" />
                <Border Style="{StaticResource BrSegments}" Margin="0,10,0,0">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ModeFile" Style="{StaticResource G2Segment}" GroupName="br-mode" IsChecked="True" Checked="Mode_Checked" Content="사진" />
                    <RadioButton x:Name="ModeFolder" Style="{StaticResource G2Segment}" GroupName="br-mode" Checked="Mode_Checked" Content="폴더 전체" />
                  </StackPanel>
                </Border>
                <TextBox x:Name="TargetBox" Style="{StaticResource G2TextBox}" Margin="0,10,0,0" MinHeight="58" MaxHeight="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource G2Mono}" FontSize="11.5" TextChanged="TargetBox_TextChanged" ToolTip="사진 경로(한 줄에 하나) 또는 폴더 경로" />
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Button x:Name="BrowseButton" Style="{StaticResource G2GhostButton}" Click="Browse_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                      <Viewbox Width="15" Height="15" Margin="0,0,7,0"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoPhotos}" /></Viewbox>
                      <TextBlock x:Name="BrowseText" VerticalAlignment="Center" Text="사진 선택" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="ScanButton" Grid.Column="2" Style="{StaticResource G2GhostButton}" Padding="14,0" Click="Scan_Click" Content="확인" ToolTip="처리할 사진과 저장 위치를 확인합니다. 아직 아무것도 저장하지 않습니다." />
                </Grid>
                <Border x:Name="ScanCard" Margin="0,10,0,0" Background="{DynamicResource G2Panel2}" CornerRadius="8" Padding="10,8" Visibility="Collapsed">
                  <StackPanel>
                    <TextBlock x:Name="ScanSummary" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ScanOutput" Style="{StaticResource G2Caption}" Margin="0,4,0,0" FontFamily="{StaticResource G2Mono}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <TextBlock x:Name="ScanError" Style="{StaticResource G2Caption}" Margin="0,8,0,0" Foreground="{DynamicResource G2Err}" TextWrapping="Wrap" Visibility="Collapsed" />
              </StackPanel>
            </Border>

            <!-- options -->
            <Border Style="{StaticResource G2Card}" Padding="14,12" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource G2SectionTitle}" Text="처리 설정" />
                <TextBlock Style="{StaticResource BrLabel}" Text="처리 품질" />
                <Border Style="{StaticResource BrSegments}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Quality1024" Style="{StaticResource G2Segment}" GroupName="br-quality" IsChecked="True" Content="빠르게" ToolTip="1024 px로 추론합니다." />
                    <RadioButton x:Name="Quality2048" Style="{StaticResource G2Segment}" GroupName="br-quality" Content="고품질" ToolTip="2048 px로 추론합니다. 메모리와 시간이 더 듭니다." />
                  </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource BrLabel}" Text="경계 선명도" />
                <Border Style="{StaticResource BrSegments}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Edge0" Style="{StaticResource G2Segment}" GroupName="br-edge" Content="부드럽게" />
                    <RadioButton x:Name="Edge1" Style="{StaticResource G2Segment}" GroupName="br-edge" IsChecked="True" Content="선명하게" />
                    <RadioButton x:Name="Edge2" Style="{StaticResource G2Segment}" GroupName="br-edge" Content="더 선명하게" />
                  </StackPanel>
                </Border>
                <ToggleButton x:Name="OpaqueSwitch" Style="{StaticResource G2Switch}" Margin="0,14,0,0" IsChecked="True" Content="제품 불투명도 유지" ToolTip="유리·비닐이 아닌 일반 제품은 켜 두세요. 제품 안쪽이 비치지 않게 합니다." />
                <ToggleButton x:Name="DetailSwitch" Style="{StaticResource G2Switch}" Margin="0,10,0,0" Content="확대 촬영 보정" ToolTip="제품을 가까이 확대해 찍은 사진의 세부 경계를 한 번 더 다듬습니다. 시간이 더 걸립니다." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ===================== progress + preview ===================== -->
    <DockPanel Grid.Column="1" Margin="16,16,16,16">
      <Grid DockPanel.Dock="Top" Margin="2,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="StatusTitle" Style="{StaticResource G2SectionTitle}" Text="사진이나 폴더를 고른 뒤 확인을 눌러 주세요" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="StatusText" Style="{StaticResource G2Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Text="" />
        </StackPanel>
        <TextBlock x:Name="CountText" Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource G2Mono}" FontSize="15" FontWeight="SemiBold" Text="" />
      </Grid>
      <ProgressBar x:Name="Progress" DockPanel.Dock="Top" Style="{StaticResource BrProgress}" Margin="0,0,0,10" Minimum="0" Maximum="1" Value="0" />
      <!-- zoom: both panes move together so the same spot is compared -->
      <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock x:Name="ZoomText" VerticalAlignment="Center" Margin="0,0,10,0" FontFamily="{StaticResource G2Mono}" FontSize="12" FontWeight="SemiBold" Text="맞춤" />
          <Button Style="{StaticResource G2GhostButton}" Height="28" Width="32" Padding="0" Margin="0,0,4,0" ToolTip="축소" Click="ZoomOut_Click">
            <Viewbox Width="14" Height="14"><Path Style="{StaticResource G2IconPath}" Data="M10,4 A6,6 0 1 0 10.001,4 Z M14.5,14.5 L20,20 M7,10 H13" /></Viewbox>
          </Button>
          <Button Style="{StaticResource G2GhostButton}" Height="28" Width="32" Padding="0" Margin="0,0,4,0" ToolTip="확대" Click="ZoomIn_Click">
            <Viewbox Width="14" Height="14"><Path Style="{StaticResource G2IconPath}" Data="M10,4 A6,6 0 1 0 10.001,4 Z M14.5,14.5 L20,20 M7,10 H13 M10,7 V13" /></Viewbox>
          </Button>
          <Button Style="{StaticResource G2GhostButton}" Height="28" Padding="10,0" Margin="0,0,4,0" FontSize="12" ToolTip="원본 화소 크기(100%)로 봅니다." Click="ZoomActual_Click" Content="100%" />
          <Button Style="{StaticResource G2GhostButton}" Height="28" Padding="10,0" FontSize="12" ToolTip="화면에 맞춥니다. (사진을 두 번 클릭해도 됩니다)" Click="ZoomFit_Click" Content="맞춤" />
        </StackPanel>
        <TextBlock Style="{StaticResource G2Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="마우스 휠로 확대/축소, 끌어서 이동, 두 번 클릭하면 맞춤. 원본과 결과가 함께 움직입니다." />
      </DockPanel>

      <Border x:Name="ErrorsCard" DockPanel.Dock="Bottom" Style="{StaticResource G2Card}" Margin="0,12,0,0" MaxHeight="150" Visibility="Collapsed">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Foreground="{DynamicResource G2Err}" Text="처리하지 못한 사진" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
            <TextBlock x:Name="ErrorsText" Style="{StaticResource G2Caption}" FontFamily="{StaticResource G2Mono}" TextWrapping="Wrap" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource G2Stage}" CornerRadius="12" ClipToBounds="True">
          <Grid x:Name="SourceView" Background="Transparent" Cursor="Hand" MouseWheel="View_MouseWheel" MouseLeftButtonDown="View_MouseLeftButtonDown" MouseMove="View_MouseMove" MouseLeftButtonUp="View_MouseLeftButtonUp">
            <Grid x:Name="SourceCanvas">
              <Image x:Name="SourceImage" Margin="14" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
            <Border Style="{StaticResource BrStageLabel}"><TextBlock Foreground="White" FontSize="11.5" FontWeight="SemiBold" Text="원본" /></Border>
          </Grid>
        </Border>
        <Border Grid.Column="2" Background="{DynamicResource G2Stage}" CornerRadius="12" ClipToBounds="True">
          <Grid x:Name="ResultView" Background="{StaticResource BrChecker}" Cursor="Hand" MouseWheel="View_MouseWheel" MouseLeftButtonDown="View_MouseLeftButtonDown" MouseMove="View_MouseMove" MouseLeftButtonUp="View_MouseLeftButtonUp">
            <Grid x:Name="ResultCanvas">
              <Image x:Name="ResultImage" Margin="14" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
            <Border Style="{StaticResource BrStageLabel}"><TextBlock Foreground="White" FontSize="11.5" FontWeight="SemiBold" Text="배경 제거 결과" /></Border>
            <TextBlock x:Name="ResultEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource G2Sub}" Text="처리하면 여기에 결과가 보입니다" />
          </Grid>
        </Border>
      </Grid>
    </DockPanel>
  </Grid>
</Window>
