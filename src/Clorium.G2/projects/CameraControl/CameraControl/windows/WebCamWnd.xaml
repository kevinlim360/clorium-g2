<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="CameraControl.windows.WebCamWnd" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:CameraControl.windows" Title="웹캠" Height="800" Width="1200" WindowStartupLocation="Manual" Left="608" Top="50" TextElement.Foreground="{DynamicResource MaterialDesignBody}" TextElement.FontWeight="Regular" TextElement.FontSize="13" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto" Background="{DynamicResource MaterialDesignPaper}" FontFamily="{DynamicResource MaterialDesignFont}" Cursor="" Loaded="Window_Loaded" Closed="Window_Closed">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Width="300" Margin="10" VerticalAlignment="Top">
      <TextBlock Text="웹캠 이벤트" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center" />
      <GroupBox Header="해상도" Margin="0,10,0,10">
        <StackPanel Margin="10">
          <ComboBox SelectedValuePath="Value" ItemsSource="{Binding CompressionSetting.Values}" SelectedItem="{Binding SelectedResolution, Mode=TwoWay}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock VerticalAlignment="Center" Text="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </GroupBox>
      <GroupBox Header="포커스 설정" Margin="0,0,0,10">
        <StackPanel Margin="10">
          <CheckBox Content="수동 Focus 활성화" Style="{StaticResource MaterialDesignCheckBox}" IsChecked="{Binding IsManualFocusEnabled, Mode=TwoWay}" />
          <StackPanel IsEnabled="{Binding IsManualFocusEnabled}">
            <TextBlock Margin="0,20,0,5" HorizontalAlignment="Center" Text="{Binding FocusValue, StringFormat=포커스 값 : {0}}" />
            <Slider Minimum="0" Maximum="100" Style="{StaticResource MaterialDesignDiscreteSlider}" ToolTip="슬라이더를 움직여 초점을 맞추세요." Value="{Binding FocusValue, Mode=TwoWay}" />
          </StackPanel>
        </StackPanel>
      </GroupBox>
      <GroupBox Header="저장 시간" Margin="0,0,0,10">
        <StackPanel Margin="10">
          <StackPanel Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="전 :" VerticalAlignment="Center" />
            <TextBox Width="60" Margin="10 0 0 0" HorizontalContentAlignment="Center" Text="{Binding PreSeconds}" />
            <TextBlock Text="  [초]" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="후 :" VerticalAlignment="Center" />
            <TextBox Width="60" Margin="10 0 0 0" HorizontalContentAlignment="Center" Text="{Binding PostSeconds}" />
            <TextBlock Text="  [초]" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </GroupBox>
      <GroupBox Header="상태">
        <TextBlock FontSize="14" Margin="10" HorizontalAlignment="Center" Text="{Binding StatusText}" />
      </GroupBox>
      <Button Content="🚨동영상 저장🚨" Margin="0,30" Command="{Binding RecordCommand}" IsEnabled="{Binding CanRecord}" />
      <Button Content="🚨캡쳐🚨" Command="{Binding CaptureCommand}" />
    </StackPanel>
    <Border Grid.Column="1" BorderBrush="#FF808080" BorderThickness="1">
      <Image Stretch="Uniform" Source="{Binding WepCamBitmap}" />
    </Border>
  </Grid>
</Window>