<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="CameraControl.windows.MultipleCameraWnd" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" xmlns:my1="clr-namespace:CameraControl.windows" xmlns:Core="clr-namespace:CameraControl.Core;assembly=CameraControl.Core" xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro" xmlns:Devices="clr-namespace:CameraControl.Devices;assembly=CameraControl.Devices" xmlns:local="clr-namespace:CameraControl.Controls" xmlns:T="clr-namespace:CameraControl.Core.Translation;assembly=CameraControl.Core" xmlns:dragDrop="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" Height="580" Width="1000" WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow" TextElement.Foreground="{DynamicResource MaterialDesignBody}" TextElement.FontWeight="Regular" TextElement.FontSize="13" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto" Background="{DynamicResource MaterialDesignPaper}" FontFamily="{DynamicResource MaterialDesignFont}" Title="{T:Translate MultipleCameraWindowTitle}" Closing="Window_Closing" PreviewKeyDown="MetroWindow_PreviewKeyDown">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter1" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="363*" />
      <RowDefinition Height="90*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="50" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="32*" />
        <RowDefinition Height="30" />
      </Grid.RowDefinitions>
      <Label Grid.Row="0" Grid.ColumnSpan="2" Content="🛠촬영 조건" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <Border Grid.ColumnSpan="2" Grid.Row="0" Width="200" Height="2" Background="#FFA9A9A9" HorizontalAlignment="Right" Margin="0 15 10 -30" />
      <Label Grid.Row="1" Grid.Column="0" Margin="20 5 0 0" Content="{T:Translate LabelNumberOfCaptures}" />
      <Controls:NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="1000" Margin="5 5 15 5" Value="{Binding Path=NumOfPhotos, RelativeSource={RelativeSource FindAncestor, AncestorType=my1:MultipleCameraWnd, AncestorLevel=1}}" />
      <Label Grid.Row="2" Grid.Column="0" Margin="20 5 0 0" Content="{T:Translate LabelDelay}" />
      <Controls:NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="10" Margin="5 5 15 5" ToolTip="Capture Delay between cameras" Value="{Binding Path=DelaySec, RelativeSource={RelativeSource FindAncestor, AncestorType=my1:MultipleCameraWnd, AncestorLevel=1}}" />
      <Label Grid.Row="3" Grid.Column="0" Margin="20 5 0 0" Content="{T:Translate LabelWaitTime}" />
      <Controls:NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="10" Margin="5 5 15 5" ToolTip="Wait time between Capture count" Value="{Binding Path=WaitSec, RelativeSource={RelativeSource FindAncestor, AncestorType=my1:MultipleCameraWnd, AncestorLevel=1}}" />
      <Border Grid.ColumnSpan="2" Grid.Row="3" Width="200" Height="1" Background="#FF808080" HorizontalAlignment="Right" Margin="0 15 10 -30" />
      <Label Grid.Row="4" ContentStringFormat="🔄현재 반복 회수 : {0}" HorizontalAlignment="Center" Grid.ColumnSpan="2" FontSize="17" Margin="20 30 20 20" Foreground="#FF808080" Content="{Binding PhotoCounter}" />
      <Button Name="btn_shot" Grid.Row="5" Grid.ColumnSpan="2" Margin="20 00 15 30" Content="{T:Translate ButtonCapturePhotos}" Click="btn_Capture_Click" />
      <Button Name="btn_stop" Grid.Row="6" Grid.ColumnSpan="2" Margin="20 0 15 0" Cursor="Hand" Content="{T:Translate ButtonStop}" Click="btn_Stop_Click" />
      <Border Grid.RowSpan="13" Grid.Column="1" Width="1" Background="#FF808080" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0 15 0 -55" />
    </Grid>
    <TabControl Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="10 0 0 0">
      <TabItem Header="{T:Translate LabelGrid}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,5,0,0">
          <ItemsControl Name="listBox1" dragDrop:DragDrop.IsDragSource="True" dragDrop:DragDrop.IsDropTarget="True" ItemsSource="{Binding Source={x:Static Core:ServiceProvider.DeviceManager}, Path=ConnectedDevices}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <HierarchicalDataTemplate>
                <materialDesign:Card VerticalAlignment="Top" Margin="2">
                  <local:ControlerSimple Width="180" Height="410" DataContext="{Binding Path=.}" />
                </materialDesign:Card>
              </HierarchicalDataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>
      <TabItem Cursor="" Header="{T:Translate LabelList}">
        <DataGrid AutoGenerateColumns="False" IsSynchronizedWithCurrentItem="True" ItemsSource="{Binding Source={x:Static Core:ServiceProvider.DeviceManager}, Path=ConnectedDevices}">
          <DataGrid.Columns>
            <DataGridTemplateColumn>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Controls:ProgressRing Width="30" Height="30" IsActive="{Binding IsBusy}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=DisplayName}" Header="{T:Translate LabelCameraname}" />
            <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=SerialNumber}" Header="{T:Translate LabelSerialNumber}" />
            <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=Battery}" Header="{T:Translate Battery}" />
            <DataGridTemplateColumn SortMemberPath="Mode.Value" Header="{T:Translate Mode}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border BorderThickness="1" BorderBrush="{Binding Path=Mode.ErrorColor}">
                    <ComboBox Name="cmb_mode" IsEnabled="{Binding Path=Mode.IsEnabled}" ItemsSource="{Binding Path=Mode.Values}" SelectedValue="{Binding Path=Mode.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn SortMemberPath="IsoNumber.Value" Header="{T:Translate Iso}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border BorderThickness="1" BorderBrush="{Binding Path=IsoNumber.ErrorColor}">
                    <ComboBox IsEnabled="{Binding Path=IsoNumber.IsEnabled}" ItemsSource="{Binding Path=IsoNumber.Values}" SelectedValue="{Binding Path=IsoNumber.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn SortMemberPath="ShutterSpeed.Value" Header="{T:Translate ShutterSpeed}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border BorderThickness="1" BorderBrush="{Binding Path=ShutterSpeed.ErrorColor}">
                    <ComboBox Name="cmb_shutter" IsEnabled="{Binding Path=ShutterSpeed.IsEnabled}" ItemsSource="{Binding Path=ShutterSpeed.Values}" SelectedValue="{Binding Path=ShutterSpeed.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn SortMemberPath="FNumber.Value" Header="{T:Translate Aperture}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border BorderThickness="1" BorderBrush="{Binding Path=FNumber.ErrorColor}">
                    <ComboBox Name="cmb_aperture" IsEnabled="{Binding Path=FNumber.IsEnabled}" ItemsSource="{Binding Path=FNumber.Values}" SelectedValue="{Binding Path=FNumber.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn SortMemberPath="WhiteBalance.Value" Header="{T:Translate WhiteBalance}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border BorderThickness="1" BorderBrush="{Binding Path=WhiteBalance.ErrorColor}">
                    <ComboBox IsEnabled="{Binding Path=WhiteBalance.IsEnabled}" ItemsSource="{Binding Path=WhiteBalance.Values}" SelectedValue="{Binding Path=WhiteBalance.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn SortMemberPath="ExposureCompensation.Value" Header="{T:Translate ExposureComp}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border BorderThickness="1" BorderBrush="{Binding Path=ExposureCompensation.ErrorColor}">
                    <ComboBox IsEnabled="{Binding Path=ExposureCompensation.IsEnabled}" ItemsSource="{Binding Path=ExposureCompensation.Values}" SelectedValue="{Binding Path=ExposureCompensation.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn SortMemberPath="FocusMode.Value" Header="{T:Translate FocusMode}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border BorderThickness="1" BorderBrush="{Binding Path=FocusMode.ErrorColor}">
                    <ComboBox Name="cmb_focus" IsEnabled="{Binding Path=FocusMode.IsEnabled}" ItemsSource="{Binding Path=FocusMode.Values}" SelectedValue="{Binding Path=FocusMode.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
    <Label Name="lbl_message" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="3" Grid.ColumnSpan="2" Content="{Binding Source={x:Static Devices:StaticHelper.Instance}, Path=SystemMessage}" />
  </Grid>
</Window>