<?xml version="1.0" encoding="utf-8"?>
<!--
  Clorium G2 · 세션 검색 (BrowseWnd, WindowsManager "BrowseWnd_Show"). Left: the photo sessions (name, folder, photo count);
  right: the photos of the selected session as tiles with a check box each. Double-click a session (or 이 세션 열기) to make it
  the current session; the window then hides. G2 theme (light/dark) like the other G2 windows.
-->
<Window x:Class="CameraControl.windows.BrowseWnd" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:windows="clr-namespace:CameraControl.windows" xmlns:Core="clr-namespace:CameraControl.Core;assembly=CameraControl.Core" xmlns:T="clr-namespace:CameraControl.Core.Translation;assembly=CameraControl.Core" Height="560" Width="980" MinWidth="640" MinHeight="380" WindowStartupLocation="CenterScreen" Background="{DynamicResource G2Page}" FontFamily="{DynamicResource G2Font}" TextElement.Foreground="{DynamicResource G2Text}" TextElement.FontSize="13" UseLayoutRounding="True" Title="{T:Translate LabelBrowse}" Closing="Window_Closing">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/CameraControl;component/styles/g2theme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- one photo: rounded thumbnail, check box and file name; the selected tile gets the accent outline -->
      <Style x:Key="PhotoTile" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="bd" Padding="6" CornerRadius="10" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource G2Panel2}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource G2AccentSoft}" />
                  <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource G2Accent}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" MinWidth="200" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
      <TextBlock FontSize="{DynamicResource G2Fs20}" FontWeight="Bold" Text="세션 검색" />
      <TextBlock Style="{StaticResource G2Caption}" Margin="0,4,0,0" TextWrapping="Wrap" Text="세션을 고르면 사진을 볼 수 있습니다. 다른 폴더의 세션은 ‘다른 폴더’로 찾습니다. 세션을 두 번 누르거나 ‘이 세션 열기’를 누르면 그 세션으로 바꿉니다." />
    </StackPanel>

    <!-- sessions -->
    <Border Grid.Row="1" Style="{StaticResource G2Card}" Padding="8">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="6,0,0,8">
          <Button Name="btn_folder" DockPanel.Dock="Right" Style="{StaticResource G2GhostButton}" Padding="10,0" Height="28" ToolTip="다른 폴더에 있는 세션(사진 폴더)을 찾습니다" Click="Folder_Click">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoFolder}" /></Viewbox>
              <TextBlock Text="다른 폴더" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <TextBlock Style="{StaticResource G2SectionTitle}" VerticalAlignment="Center" Text="세션" />
        </DockPanel>
        <!-- a folder picked with 다른 폴더 that is not a session yet; 이 세션 열기 adds it -->
        <Border Name="FoundPanel" DockPanel.Dock="Top" Visibility="Collapsed" Cursor="Hand" CornerRadius="7" Padding="7,6" Margin="0,0,0,6" BorderThickness="1.5" MouseLeftButtonUp="FoundPanel_Click">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource G2Panel2}" />
              <Setter Property="BorderBrush" Value="{DynamicResource G2Line}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Path=FoundSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type windows:BrowseWnd}}}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource G2AccentSoft}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource G2Accent}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource G2Accent}" Text="폴더에서 찾음 · 아직 세션 목록에 없음" />
              <TextBlock Text="{Binding Name}" FontSize="{DynamicResource G2Fs13}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
              <TextBlock Text="{Binding Folder}" FontFamily="{StaticResource G2Mono}" FontSize="11" Foreground="{DynamicResource G2Sub}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" Margin="0,2,0,0" />
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="9" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center" Background="{DynamicResource G2Neutral}">
              <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource G2NeutralText}"><Run Text="{Binding Files.Count, Mode=OneWay}" /><Run Text="장" /></TextBlock>
            </Border>
          </Grid>
        </Border>
        <ListBox Name="lst_profiles" Style="{StaticResource G2List}" ItemsSource="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=PhotoSessions}" SelectionChanged="lst_profiles_SelectionChanged" MouseDoubleClick="lst_profiles_MouseDoubleClick">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="{DynamicResource G2Fs13}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Folder}" FontFamily="{StaticResource G2Mono}" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource G2Sub}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="9" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center" Background="{DynamicResource G2Neutral}">
                  <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource G2NeutralText}"><Run Text="{Binding Files.Count, Mode=OneWay}" /><Run Text="장" /></TextBlock>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <GridSplitter Name="gridSplitter1" Grid.Row="1" Grid.Column="1" Width="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" />

    <!-- photos of the selected session -->
    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource G2Card}" Padding="12,8,4,8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource G2SectionTitle}" Margin="2,2,0,10" Text="사진" />
        <Grid>
          <ListBox Name="lst_files" Style="{StaticResource G2List}" ItemContainerStyle="{StaticResource PhotoTile}" ItemsSource="{Binding Path=SelectedPhotoSession.Files, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type windows:BrowseWnd}}}" MouseDoubleClick="lst_files_MouseDoubleClick">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="160">
                  <Border Width="160" Height="106" CornerRadius="8" Background="{DynamicResource G2Stage}" BorderBrush="{DynamicResource G2Line}" BorderThickness="1">
                    <Border.OpacityMask>
                      <VisualBrush>
                        <VisualBrush.Visual>
                          <Border Width="160" Height="106" CornerRadius="8" Background="Black" />
                        </VisualBrush.Visual>
                      </VisualBrush>
                    </Border.OpacityMask>
                    <Image Stretch="UniformToFill" Source="{Binding Path=Thumbnail}" ToolTip="{Binding Path=ToolTip}" />
                  </Border>
                  <CheckBox Style="{StaticResource G2CheckBox}" Margin="2,8,0,0" IsChecked="{Binding Path=IsChecked}">
                    <TextBlock Text="{Binding Path=Name}" TextTrimming="CharacterEllipsis" MaxWidth="134" />
                  </CheckBox>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListBox>
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="이 세션에는 사진이 없습니다." IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource G2Caption}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ElementName=lst_files, Path=HasItems}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </DockPanel>
    </Border>

    <!-- folder and count of the selected session, actions -->
    <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Style="{StaticResource G2GhostButton}" Padding="16,0" Height="34" Margin="8,0,0,0" Content="닫기" Click="Close_Click" />
      <Button Name="OpenButton" DockPanel.Dock="Right" Style="{StaticResource G2PrimaryButton}" Padding="16,0" Height="34" Content="이 세션 열기" Click="Open_Click" />
      <DockPanel Name="statusBar1" VerticalAlignment="Center" Margin="0,0,12,0">
        <Border DockPanel.Dock="Left" CornerRadius="9" Padding="8,1" Margin="0,0,10,0" VerticalAlignment="Center" Background="{DynamicResource G2AccentSoft}">
          <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource G2Accent}"><Run Text="{Binding ElementName=lst_files, Path=Items.Count, Mode=OneWay}" /><Run Text="장" /></TextBlock>
        </Border>
        <TextBlock FontFamily="{StaticResource G2Mono}" Foreground="{DynamicResource G2Sub}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Path=SelectedPhotoSession.Folder, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type windows:BrowseWnd}}}" ToolTip="{Binding Path=SelectedPhotoSession.Folder, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type windows:BrowseWnd}}}" />
      </DockPanel>
    </DockPanel>
  </Grid>
</Window>
