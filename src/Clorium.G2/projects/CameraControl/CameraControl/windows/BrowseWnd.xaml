<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="CameraControl.windows.BrowseWnd" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:windows="clr-namespace:CameraControl.windows" xmlns:Core="clr-namespace:CameraControl.Core;assembly=CameraControl.Core" xmlns:my="clr-namespace:CameraControl.Controls" xmlns:T="clr-namespace:CameraControl.Core.Translation;assembly=CameraControl.Core" Height="423" Width="878" WindowStartupLocation="CenterScreen" TextElement.Foreground="{DynamicResource MaterialDesignBody}" TextElement.FontWeight="Regular" TextElement.FontSize="13" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto" Background="{DynamicResource MaterialDesignPaper}" FontFamily="{DynamicResource MaterialDesignFont}" Title="{T:Translate LabelBrowse}" Closing="Window_Closing">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="Style1" TargetType="{x:Type ListBox}">
        <Setter Property="ItemsPanel">
          <Setter.Value>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      </Style>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter1" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="10" />
      <ColumnDefinition Width="100*" MinWidth="200" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="243*" />
      <ColumnDefinition Width="10" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="10" />
      <RowDefinition Height="193*" />
      <RowDefinition Height="10" />
      <RowDefinition Height="25" />
    </Grid.RowDefinitions>
    <ListBox Name="lst_profiles" Grid.Column="1" Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}" ItemsSource="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=PhotoSessions}" SelectedItem="{Binding Path=SelectedPhotoSession, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type windows:BrowseWnd}}}" MouseDoubleClick="lst_profiles_MouseDoubleClick" />
    <ListBox Name="lst_files" Grid.Column="3" Grid.Row="1" Style="{StaticResource Style1}" Background="{DynamicResource WindowBackgroundBrush}" ItemsSource="{Binding Path=SelectedPhotoSession.Files, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type windows:BrowseWnd}}}" MouseDoubleClick="lst_files_MouseDoubleClick">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel>
            <Border BorderBrush="#FF000000" BorderThickness="2" CornerRadius="5" Margin="6">
              <Image Stretch="Uniform" Width="120" Height="80" Source="{Binding Path=Thumbnail}" ToolTip="{Binding Path=ToolTip}" />
            </Border>
            <StackPanel Orientation="Horizontal">
              <CheckBox IsChecked="{Binding Path=IsChecked}" />
              <Label HorizontalAlignment="Center" Content="{Binding Path=Name}" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ListBox>
    <StatusBar Name="statusBar1" Grid.ColumnSpan="5" Grid.Row="3" Background="{DynamicResource WindowBackgroundBrush}">
      <StatusBarItem Content="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=DefaultSession.Folder}" />
      <StatusBarItem Content="(" />
      <StatusBarItem Content="{Binding ElementName=lst_files, Path=Items.Count}" />
      <StatusBarItem Content=")" />
    </StatusBar>
    <GridSplitter Name="gridSplitter1" Grid.Column="2" Grid.Row="1" ResizeDirection="Columns" Height="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
  </Grid>
</Window>