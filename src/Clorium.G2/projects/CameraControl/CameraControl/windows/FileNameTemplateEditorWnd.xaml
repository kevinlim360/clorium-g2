<?xml version="1.0" encoding="utf-8"?>
<!--
  Clorium G2 · 세션 > 파일 이름 규칙 (FileNameTemplateEditorWnd). The rule text with a live example; each part below is a pill
  button that inserts "_[part]" at the cursor (Button_Click reads the part from Tag).
-->
<Window x:Class="CameraControl.windows.FileNameTemplateEditorWnd" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Core="clr-namespace:CameraControl.Core;assembly=CameraControl.Core" xmlns:my="clr-namespace:CameraControl.windows" Title="파일 이름 규칙" Height="600" Width="620" MinHeight="420" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource G2Page}" FontFamily="{DynamicResource G2Font}" TextElement.Foreground="{DynamicResource G2Text}" TextElement.FontSize="13" UseLayoutRounding="True" Loaded="MetroWindow_Loaded">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/CameraControl;component/styles/g2theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="PartButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Foreground" Value="{DynamicResource G2Text}" />
        <Setter Property="FontFamily" Value="{StaticResource G2Mono}" />
        <Setter Property="FontSize" Value="{DynamicResource G2Fs12}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" CornerRadius="13" Padding="11,4" Background="{DynamicResource G2Neutral}" BorderBrush="{DynamicResource G2Line}" BorderThickness="1">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource G2AccentSoft}" />
                  <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource G2Accent}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource G2Accent}" />
                  <Setter Property="Foreground" Value="{DynamicResource G2OnAccent}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="20,18,20,12">
      <TextBlock FontSize="{DynamicResource G2Fs20}" FontWeight="Bold" Text="파일 이름 규칙" />
      <TextBlock Style="{StaticResource G2Caption}" Margin="0,4,0,14" TextWrapping="Wrap" Text="촬영한 사진의 파일 이름을 정합니다. 아래 항목을 누르면 커서 위치에 들어갑니다." />
      <Border Style="{StaticResource G2Card}" Padding="16,14">
        <StackPanel>
          <TextBlock Style="{StaticResource G2SectionTitle}" Margin="0,0,0,8" Text="규칙" />
          <TextBox Name="txt_templateName" Style="{StaticResource G2TextBox}" FontFamily="{StaticResource G2Mono}" Text="{Binding Path=TemplateString, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource FindAncestor, AncestorType=my:FileNameTemplateEditorWnd, AncestorLevel=1}}" />
          <DockPanel Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Left" Foreground="{DynamicResource G2Sub}" Margin="0,0,10,0" Text="예시" />
            <TextBlock FontFamily="{StaticResource G2Mono}" FontWeight="SemiBold" Foreground="{DynamicResource G2Accent}" TextWrapping="Wrap" Text="{Binding Path=ExampleTemplateString, RelativeSource={RelativeSource FindAncestor, AncestorType=my:FileNameTemplateEditorWnd, AncestorLevel=1}}" />
          </DockPanel>
        </StackPanel>
      </Border>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource G2Card}" Margin="20,0,20,16" Padding="16,14,6,8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource G2SectionTitle}" Margin="0,0,0,10" Text="넣을 수 있는 항목" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Source={x:Static Core:ServiceProvider.FilenameTemplateManager}, Path=ValuesList}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource PartButton}" Content="{Binding Key}" Tag="{Binding Key}" Click="Button_Click" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Border Grid.Row="2" Background="{DynamicResource G2Panel}" BorderBrush="{DynamicResource G2Line}" BorderThickness="0,1,0,0" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Name="btn_cancel" Style="{StaticResource G2GhostButton}" Padding="18,0" Height="34" IsCancel="True" Content="취소" Click="btn_cancel_Click" />
        <Button Name="btn_ok" Style="{StaticResource G2PrimaryButton}" Padding="22,0" Height="34" Margin="8,0,0,0" IsDefault="True" Content="확인" Click="btn_ok_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
