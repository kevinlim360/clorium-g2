<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="CameraControl.windows.FileNameTemplateEditorWnd" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:translation="clr-namespace:CameraControl.Core.Translation;assembly=CameraControl.Core" xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls" xmlns:Core="clr-namespace:CameraControl.Core;assembly=CameraControl.Core" xmlns:my="clr-namespace:CameraControl.windows" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:controls1="clr-namespace:CameraControl.Controls" Title="File Name Template Editor" Height="600" Width="600" ShowInTaskbar="False" WindowStartupLocation="CenterScreen" TextElement.Foreground="{DynamicResource MaterialDesignBody}" TextElement.FontWeight="Regular" TextElement.FontSize="13" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto" Background="{DynamicResource MaterialDesignPaper}" FontFamily="{DynamicResource MaterialDesignFont}" Loaded="MetroWindow_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <controls1:TemplateNameToIconConverter x:Key="TemplateNameToIconConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="193*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Label Content="{translation:Translate LabelFileNameTemplate}" />
    <TextBox Name="txt_templateName" Grid.Row="1" Margin="4" Text="{Binding Path=TemplateString, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource FindAncestor, AncestorType=my:FileNameTemplateEditorWnd, AncestorLevel=1}}" />
    <TextBlock Grid.Row="2" Margin="4" Text="{Binding Path=ExampleTemplateString, RelativeSource={RelativeSource FindAncestor, AncestorType=my:FileNameTemplateEditorWnd, AncestorLevel=1}}" />
    <materialDesign:Card Grid.Row="3" Margin="4" VerticalAlignment="Stretch">
      <ScrollViewer>
        <ItemsControl Grid.Row="3" Margin="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" ItemsSource="{Binding Source={x:Static Core:ServiceProvider.FilenameTemplateManager}, Path=ValuesList}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <materialDesign:Chip Margin="4" Content="{Binding Key}" Icon="{Binding Key, Converter={StaticResource TemplateNameToIconConverter}}" Click="Button_Click" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>
    </materialDesign:Card>
    <Button Name="btn_ok" Grid.Row="4" HorizontalAlignment="Left" Margin="4" VerticalAlignment="Top" Width="100" Content="{translation:Translate ButtonOk}" Click="btn_ok_Click" />
    <Button Name="btn_cancel" Grid.Row="4" HorizontalAlignment="Right" Margin="4" VerticalAlignment="Top" Width="100" Content="{translation:Translate ButtonCancel}" Click="btn_cancel_Click" />
  </Grid>
</Window>