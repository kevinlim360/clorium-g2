<?xml version="1.0" encoding="utf-8"?>
<!--
  Clorium G2 · 세션 추가 / 세션 편집 (EditSession; 메뉴 > 세션, 왼쪽 ‘세션’ 아이콘, 최근 세션의 편집 단추). One page in the G2 theme:
  기본 (이름, 폴더, 파일 이름 규칙), 다운로드·저장 options and 태그. 확인 keeps the changes (Session.EndEdit), 취소 restores them.
-->
<Window x:Class="CameraControl.windows.EditSession" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStartupLocation="CenterOwner" Height="680" Width="600" MinHeight="460" ResizeMode="CanResize" ShowInTaskbar="False" Background="{DynamicResource G2Page}" FontFamily="{DynamicResource G2Font}" TextElement.Foreground="{DynamicResource G2Text}" TextElement.FontSize="13" UseLayoutRounding="True" Title="세션" Loaded="Window_Loaded">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/CameraControl;component/styles/g2theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="Option" TargetType="CheckBox" BasedOn="{StaticResource G2CheckBox}">
        <Setter Property="Margin" Value="0,6,0,6" />
      </Style>
      <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource G2Caption}">
        <Setter Property="Margin" Value="23,0,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="20,18,20,8">
        <TextBlock x:Name="HeaderText" FontSize="{DynamicResource G2Fs20}" FontWeight="Bold" Text="세션" />
        <TextBlock x:Name="HeaderCaption" Style="{StaticResource G2Caption}" Margin="0,4,0,14" TextWrapping="Wrap" Text="세션 이름과 사진 저장 방식을 정합니다." />

        <!-- 기본 -->
        <Border Style="{StaticResource G2Card}" Padding="16,14" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.ColumnSpan="3" Style="{StaticResource G2SectionTitle}" Margin="0,0,0,10" Text="기본" />
            <TextBlock Grid.Row="1" Foreground="{DynamicResource G2Sub}" VerticalAlignment="Center" Text="세션 이름" />
            <TextBox Name="SessionName" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource G2TextBox}" Text="{Binding Path=Name, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock x:Name="FolderLabel" Grid.Row="2" Foreground="{DynamicResource G2Sub}" VerticalAlignment="Center" Margin="0,10,0,0" Text="폴더" />
            <TextBlock x:Name="FolderText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" VerticalAlignment="Center" FontFamily="{StaticResource G2Mono}" Foreground="{DynamicResource G2Sub}" TextTrimming="CharacterEllipsis" Text="{Binding Path=Folder}" ToolTip="{Binding Path=Folder}" />
            <TextBlock Grid.Row="3" Foreground="{DynamicResource G2Sub}" VerticalAlignment="Center" Margin="0,10,0,0" Text="파일 이름 규칙" />
            <TextBox Name="txt_template" Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource G2TextBox}" FontFamily="{StaticResource G2Mono}" IsReadOnly="True" Text="{Binding Path=FileNameTemplate}" ToolTip="{Binding ElementName=txt_template, Path=Text}" />
            <Button Name="btn_template" Grid.Row="3" Grid.Column="2" Margin="8,10,0,0" Style="{StaticResource G2GhostButton}" Padding="12,0" Height="30" Content="바꾸기" ToolTip="파일 이름 규칙을 바꿉니다" Click="btn_template_Click" />
          </Grid>
        </Border>

        <!-- 다운로드 · 저장 -->
        <Border Style="{StaticResource G2Card}" Padding="16,14" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Style="{StaticResource G2SectionTitle}" Margin="0,0,0,6" Text="다운로드 · 저장" />
            <CheckBox Style="{StaticResource Option}" Content="미리보기(썸네일)만 받기" IsChecked="{Binding Path=DownloadThumbOnly}" />
            <TextBlock Style="{StaticResource Hint}" Text="원본 대신 작은 미리보기 파일만 받습니다. WIA 드라이버에서는 동작하지 않습니다." />
            <CheckBox Style="{StaticResource Option}" Content="JPG만 받기" IsChecked="{Binding Path=DownloadOnlyJpg}" />
            <TextBlock Style="{StaticResource Hint}" Text="카메라 메모리 카드에도 저장할 때만 적용됩니다 (RAW는 받지 않음)." />
            <CheckBox Style="{StaticResource Option}" Content="사진 파일에 설명·태그 기록" IsChecked="{Binding Path=WriteComment}" />
            <CheckBox Style="{StaticResource Option}" Content="같은 이름이 있으면 덮어쓰기" IsChecked="{Binding Path=AllowOverWrite}" />
            <CheckBox Style="{StaticResource Option}" Content="확장자를 소문자로 (.jpg)" IsChecked="{Binding Path=LowerCaseExtension}" />
            <CheckBox Style="{StaticResource Option}" Content="촬영할 때마다 저장 위치 묻기" IsChecked="{Binding Path=AskSavePath}" />
            <CheckBox Style="{StaticResource Option}" Content="옮긴 뒤 카메라에서 지우기" IsChecked="{Binding Path=DeleteFileAfterTransfer}" />
          </StackPanel>
        </Border>

        <!-- 태그 -->
        <Border Style="{StaticResource G2Card}" Padding="16,14" Margin="0,0,0,4">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Name="btn_add_tag" Style="{StaticResource G2GhostButton}" Padding="12,0" Height="30" Content="추가" Click="btn_add_tag_Click" />
                <Button Name="btn_edit_tag" Style="{StaticResource G2GhostButton}" Padding="12,0" Height="30" Margin="6,0,0,0" Content="편집" Click="btn_edit_tag_Click" />
                <Button Name="btn_del_tag" Style="{StaticResource G2GhostButton}" Padding="12,0" Height="30" Margin="6,0,0,0" Content="삭제" Click="btn_del_tag_Click" />
              </StackPanel>
              <TextBlock Style="{StaticResource G2SectionTitle}" VerticalAlignment="Center" Text="태그" />
            </DockPanel>
            <Grid MinHeight="90">
              <ListBox Name="lst_tags" Style="{StaticResource G2List}" MaxHeight="180" ItemsSource="{Binding Path=Tags}" />
              <TextBlock IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Text="태그가 없습니다. ‘추가’로 사진에 붙일 태그를 만듭니다.">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource G2Caption}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ElementName=lst_tags, Path=HasItems}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Background="{DynamicResource G2Panel}" BorderBrush="{DynamicResource G2Line}" BorderThickness="0,1,0,0" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Name="button2" Style="{StaticResource G2GhostButton}" Padding="18,0" Height="34" IsCancel="True" Content="취소" Click="btn_Cancel_Click" />
        <Button Name="button1" Style="{StaticResource G2PrimaryButton}" Padding="22,0" Height="34" Margin="8,0,0,0" IsDefault="True" Content="확인" Click="btn_OK_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
