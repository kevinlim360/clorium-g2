        </Border>
        <ContentControl DockPanel.Dock="Left" Focusable="False" VerticalAlignment="Center" Margin="0,0,10,0"><Viewbox Width="20" Height="20"><Path Width="24" Height="24" Stroke="{StaticResource G2Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M4,6 H14 M18,6 H20 M4,12 H8 M12,12 H20 M4,18 H16 M16,4 A2,2 0 1 0 16.01,4 Z M10,10 A2,2 0 1 0 10.01,10 Z M18,16 A2,2 0 1 0 18.01,16 Z" /></Viewbox></ContentControl>
        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource G2Fs16}" FontWeight="Bold" Text="클로리움 설정" />
      </DockPanel>
    </Border>
    <TabControl x:Name="G2Tabs" Grid.Row="1" TabStripPlacement="Left" ItemContainerStyle="{StaticResource G2NavItem}" SelectedIndex="0" Background="Transparent" BorderThickness="0" Padding="0">
