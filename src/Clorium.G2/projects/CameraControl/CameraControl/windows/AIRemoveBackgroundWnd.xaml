<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="CameraControl.windows.AIRemoveBackgroundWnd" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewModel="clr-namespace:CameraControl.ViewModel" xmlns:zoomAndPan="clr-namespace:CameraControl.Core.Controls.ZoomAndPan;assembly=CameraControl.Core" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:local="clr-namespace:CameraControl.windows" Title="AI 배경제거" Height="950" Width="1350" WindowStartupLocation="CenterOwner" TextElement.Foreground="{DynamicResource MaterialDesignBody}" TextElement.FontWeight="Regular" TextElement.FontSize="13" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto" Background="{DynamicResource MaterialDesignPaper}" FontFamily="{DynamicResource MaterialDesignFont}" Cursor="" Loaded="Window_Loaded" Closing="Window_Closing">
  <FrameworkElement.DataContext>
    <viewModel:AIRemoveBackgroundViewModel />
  </FrameworkElement.DataContext>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter1" />
      <Style x:Key="ZoomStyle" TargetType="{x:Type zoomAndPan:ZoomAndPanControl}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type zoomAndPan:ZoomAndPanControl}">
              <Grid Background="{TemplateBinding Control.Background}">
                <ContentPresenter Name="PART_Content" HorizontalAlignment="Left" VerticalAlignment="Top" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" />
      <ColumnDefinition Width="500" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="130" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,5,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="200" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="40" />
          <RowDefinition Height="40" />
          <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <Button Grid.Row="0" Grid.Column="0" Content="구매" Width="180" Height="30" Command="{Binding BuyCreditCommand}" />
        <Label Grid.Row="0" Grid.Column="1" Content="[유효 크레딧]" VerticalAlignment="Center" />
        <TextBlock Grid.Row="0" Grid.Column="2" Width="350" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding ValidCreditCount}" />
        <Button Grid.Row="1" Grid.Column="0" Content="저장" Width="180" Height="30" Command="{Binding SaveLicenseKeyCommand}" />
        <Label Grid.Row="1" Grid.Column="1" Content="[라이센스 키]" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="2" Width="350" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding LicenseKey}" />
        <Button Grid.Row="2" Grid.Column="0" Content="개별 변환" Width="180" Height="30" Command="{Binding ConvertOneCommand}" />
        <Label Grid.Row="2" Grid.Column="1" Content="[이미지 폴더]" VerticalAlignment="Center" />
        <TextBlock Grid.Row="2" Grid.Column="2" Width="500" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding Folder}" />
      </Grid>
    </StackPanel>
    <GroupBox Header="파일 리스트" Grid.Row="1" Grid.Column="0" FontWeight="Bold" FontSize="13">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListBox HorizontalAlignment="Center" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFileItem}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="classes:FileItem">
              <Grid>
                <Image Name="_image" Stretch="Uniform" Width="150" Source="{Binding Path=Thumbnail}" ToolTip="{Binding Path=ToolTip}">
                  <UIElement.Effect>
                    <DropShadowEffect ShadowDepth="2" Color="Black" BlurRadius="15" />
                  </UIElement.Effect>
                  <FrameworkElement.LayoutTransform>
                    <RotateTransform Angle="{Binding RotationAngle}" />
                  </FrameworkElement.LayoutTransform>
                </Image>
                <Button Content="삭제" HorizontalAlignment="Right" VerticalAlignment="Top" Width="60" Height="20" Margin="3" Opacity="0.5" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ListBox>
        <Button Grid.Row="1" Content="리스트 초기화" Command="{Binding ReloadCommand}" />
        <Button Grid.Row="2" Content="전체 변환" Margin="0,5,0,0" Command="{Binding StartConvertCommand}" />
      </Grid>
    </GroupBox>
    <GroupBox Header="보기" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontWeight="Bold" FontSize="13">
      <zoomAndPan:ZoomAndPanControl Name="zoomAndPanControl" Margin="3,3,3,3" Grid.Row="0" Style="{StaticResource ZoomStyle}" ClipToBounds="False" MouseWheel="zoomAndPanControl_MouseWheel" SizeChanged="zoomAndPanControl_SizeChanged" MouseDoubleClick="zoomAndPanControl_MouseDoubleClick">
        <Image Name="Image" RenderTransformOrigin="0.5,0.5" Stretch="Uniform" Source="{Binding PreviewBitmap}" Width="{Binding Path=PreviewBitmap.Width}" Height="{Binding Path=PreviewBitmap.Height}" />
      </zoomAndPan:ZoomAndPanControl>
    </GroupBox>
    <Border Grid.Row="0" Grid.Column="2" Width="500" Height="110" BorderThickness="1" BorderBrush="#FFA9A9A9" Visibility="{Binding StartProgress, ConverterParameter=false, Converter={StaticResource BooleanToVisibilityConverter1}}">
      <StackPanel>
        <Label Height="30" HorizontalContentAlignment="Center" Margin="0,5,0,0" Content="{Binding ProgressRate}" />
        <ProgressBar Height="25" Minimum="0" IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding ConvertedCount}" Maximum="{Binding MaxConvertCount}" />
        <Button Content="정지" Width="150" Margin="0,10,0,0" FontWeight="Bold" Command="{Binding StopConvertCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>