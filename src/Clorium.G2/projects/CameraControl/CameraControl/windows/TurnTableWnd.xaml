<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="CameraControl.windows.TurnTableWnd" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls" xmlns:viewModel="clr-namespace:CameraControl.ViewModel" xmlns:translation="clr-namespace:CameraControl.Core.Translation;assembly=CameraControl.Core" xmlns:local="clr-namespace:CameraControl.windows" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" Title="턴테이블" Width="900" Height="920" WindowStartupLocation="CenterOwner" TextElement.Foreground="{DynamicResource MaterialDesignBody}" TextElement.FontWeight="Regular" TextElement.FontSize="13" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto" Background="{DynamicResource MaterialDesignPaper}" FontFamily="{DynamicResource MaterialDesignFont}" Cursor="" Loaded="Window_Loaded" Closing="Window_Closing">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter1" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Cursor="">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="150*" />
      <ColumnDefinition Width="150*" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="130*" />
      <RowDefinition Height="150*" />
      <RowDefinition Height="210*" />
      <RowDefinition Height="210*" />
      <RowDefinition Height="25*" />
    </Grid.RowDefinitions>
    <materialDesign:Card Grid.Row="0" Grid.Column="0" Margin="4">
      <GroupBox Header="상태 표시" IsEnabled="{Binding IsFree}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
          </Grid.RowDefinitions>
          <Label Content="연결 상태" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Border Grid.Row="1" Grid.Column="0" BorderBrush="#FFA9A9A9" BorderThickness="1" Height="30" Width="59">
            <Rectangle Height="22" Width="50" Fill="{Binding ConnectStatus}" />
          </Border>
          <Label Content="촬영 횟수" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label FontSize="20" Content="{Binding TurnTableCount}" />
            <Label Content="[컷]" VerticalAlignment="Center" />
          </StackPanel>
          <Label Content="목표 위치" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Label Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{Binding TargetPosDisp}" />
          <Label Content="현재 위치" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Label Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF808080" Content="{Binding CurrentPosDisp}" />
        </Grid>
      </GroupBox>
    </materialDesign:Card>
    <materialDesign:Card Grid.Row="1" Grid.Column="0" Margin="4">
      <GroupBox Header="조작 기능" IsEnabled="{Binding IsFree}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25*" />
            <ColumnDefinition Width="25*" />
            <ColumnDefinition Width="25*" />
            <ColumnDefinition Width="25*" />
            <ColumnDefinition Width="50*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
          </Grid.RowDefinitions>
          <Button Grid.Row="0" Grid.Column="0" Width="55" Style="{StaticResource MaterialDesignRaisedButton}" ToolTip="원점 등록" ToolTipService.InitialShowDelay="100" Command="{Binding MoveTeachHomeCommand}">
            <materialDesign:PackIcon Kind="HomeAlertOutline" Height="25" Width="25" />
          </Button>
          <Button Grid.Row="1" Grid.Column="0" Width="55" Style="{StaticResource MaterialDesignRaisedButton}" ToolTip="원점 이동" ToolTipService.InitialShowDelay="100" Command="{Binding MoveHomeCommand}">
            <materialDesign:PackIcon Kind="HomeImportOutline" Height="25" Width="25" />
          </Button>
          <Button Grid.Row="0" Grid.Column="1" Width="55" Style="{StaticResource MaterialDesignRaisedButton}" ToolTip="선택 카메라 촬영" ToolTipService.InitialShowDelay="100" Command="{Binding CameraCaptureCommand}">
            <materialDesign:PackIcon Kind="CameraIris" Height="25" Width="25" />
          </Button>
          <Button Grid.Row="1" Grid.Column="1" Width="55" Style="{StaticResource MaterialDesignRaisedButton}" ToolTip="선택 카메라 포커스" ToolTipService.InitialShowDelay="100" Command="{Binding CameraFocusCommand}">
            <materialDesign:PackIcon Kind="TargetVariant" Height="25" Width="25" />
          </Button>
          <Button Grid.Row="0" Grid.Column="2" Width="55" Style="{StaticResource MaterialDesignRaisedButton}" ToolTip="라이브 시작" ToolTipService.InitialShowDelay="100" Command="{Binding StartLiveViewCommand}">
            <materialDesign:PackIcon Kind="Cctv" Height="25" Width="25" />
          </Button>
          <Button Grid.Row="1" Grid.Column="2" Width="55" Style="{StaticResource MaterialDesignRaisedButton}" ToolTip="라이브 정지" ToolTipService.InitialShowDelay="100" Command="{Binding StopLiveViewCommand}">
            <materialDesign:PackIcon Kind="CctvOff" Height="25" Width="25" />
          </Button>
          <Button Grid.Row="0" Grid.Column="3" Width="55" Style="{StaticResource MaterialDesignRaisedButton}" ToolTip="레이저 포인터 켜기" ToolTipService.InitialShowDelay="100" Command="{Binding LaserOnCommand}">
            <materialDesign:PackIcon Kind="GridOn" Height="25" Width="25" />
          </Button>
          <Button Grid.Row="1" Grid.Column="3" Width="55" Style="{StaticResource MaterialDesignRaisedButton}" ToolTip="레이저 포인터 끄기" ToolTipService.InitialShowDelay="100" Command="{Binding LaserOffCommand}">
            <materialDesign:PackIcon Kind="GridOff" Height="25" Width="25" />
          </Button>
          <ToggleButton Grid.Row="0" Grid.Column="4" Width="100" Style="{DynamicResource MaterialDesignActionToggleButton}" Cursor="Hand" IsEnabled="False" ToolTip="기존 동영상 촬영 비활성화 — 새 기능 준비 중" IsChecked="{Binding Record_Running}" Checked="RecBotton_Checked" Unchecked="RecBotton_Unchecked">
            <ContentControl.Content>
              <StackPanel Orientation="Horizontal" Cursor="">
                <materialDesign:PackIcon Kind="VideoOutline" VerticalAlignment="Center" />
                <TextBlock Text="비디오 촬영" VerticalAlignment="Center" FontSize="13" />
              </StackPanel>
            </ContentControl.Content>
            <materialDesign:ToggleButtonAssist.OnContent>
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="VideoOffOutline" VerticalAlignment="Center" Background="#FFFF0000" />
                <TextBlock Text="비디오 정지" VerticalAlignment="Center" FontSize="13" />
              </StackPanel>
            </materialDesign:ToggleButtonAssist.OnContent>
          </ToggleButton>
          <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Label Name="ElapsedTitle" Content="REC" Width="50" Height="30" VerticalContentAlignment="Center" FontSize="20" />
            <Label Name="ElapsedDisp" Content="00:00" Width="60" Height="30" VerticalContentAlignment="Center" FontSize="20" />
          </StackPanel>
        </Grid>
      </GroupBox>
    </materialDesign:Card>
    <materialDesign:Card Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Margin="0,4,1,4">
      <GroupBox Header="선택 카메라 영상" IsEnabled="{Binding IsFree}">
        <Border BorderBrush="#FF808080" BorderThickness="1">
          <Image Stretch="Uniform" Source="{Binding Bitmap}">
            <FrameworkElement.LayoutTransform>
              <RotateTransform Angle="{Binding Rotation}" />
            </FrameworkElement.LayoutTransform>
          </Image>
        </Border>
      </GroupBox>
    </materialDesign:Card>
    <materialDesign:Card Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Width="365" Height="115" Margin="250,28,230,28" Visibility="{Binding WaitProgressBar, ConverterParameter=true, Converter={StaticResource BooleanToVisibilityConverter1}}">
      <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="#FFD3D3D3" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*" />
            <ColumnDefinition Width="100*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="#FFD3D3D3" BorderThickness="1" Width="350" Height="30" Margin="0,5,0,0">
            <Label Content="📷 - 🕬 촬영중입니다 🕬 - 📷" HorizontalContentAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="#FFD3D3D3" BorderThickness="1" Width="350" Height="30" Margin="0,5,0,0">
            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Width="350" Height="30" IsIndeterminate="True" Foreground="#FF000000" />
          </Border>
          <Button Grid.Row="2" Grid.Column="0" Width="130" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0 7 0 0" Command="{Binding TurnTablePouseCommand}">
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Kind="StopPauseOutline" Height="25" Width="25" />
              <TextBlock Text="일시 정지" Margin="5" VerticalAlignment="Center" FontWeight="Bold" />
            </StackPanel>
          </Button>
          <Button Grid.Row="2" Grid.Column="0" Width="130" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0 7 0 0" Command="{Binding TurnTablePouseStartCommand}" Visibility="{Binding PouseRun, Converter={StaticResource BooleanToVisibilityConverter1}}">
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Kind="Restart" Height="25" Width="25" />
              <TextBlock Text="재시작" Margin="5" VerticalAlignment="Center" FontWeight="Bold" />
            </StackPanel>
          </Button>
          <Button Grid.Row="2" Grid.Column="1" Width="130" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,7,0,0" Command="{Binding TurnTableStopCommand}">
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Kind="StopAlertOutline" Height="25" Width="25" />
              <TextBlock Text="촬영 취소" Margin="5" VerticalAlignment="Center" FontWeight="Bold" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </materialDesign:Card>
    <materialDesign:Card Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="4,4,1,4">
      <GroupBox Header="일반 촬영" IsEnabled="{Binding IsFree}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25*" />
            <ColumnDefinition Width="10*" />
            <ColumnDefinition Width="15*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="50*" />
            <RowDefinition Height="60*" />
            <RowDefinition Height="40*" />
          </Grid.RowDefinitions>
          <Border BorderBrush="#FF808080" BorderThickness="1" Margin="0,0,10,0">
            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="40,10,0,0">
              <RadioButton Content="고속" Cursor="Hand" Margin="10 0 80 0" IsChecked="{Binding Speed_High}" Click="SpeedRadioButton_Click" />
              <RadioButton Content="중속" Cursor="Hand" Margin="10 0 80 0" IsChecked="{Binding Speed_Mid}" Click="SpeedRadioButton_Click" />
              <RadioButton Content="저속" Cursor="Hand" Margin="10 0 0 0" IsChecked="{Binding Speed_Low}" Click="SpeedRadioButton_Click" />
            </StackPanel>
          </Border>
          <ComboBox Name="Vel" Grid.Row="1" Grid.Column="0" Width="115" HorizontalAlignment="Left" Margin="80 20 20 0" HorizontalContentAlignment="Center" materialDesign:HintAssist.Hint="속도" Style="{StaticResource MaterialDesignOutlinedComboBox}" Cursor="Hand" ItemsSource="{Binding Vel_List}" SelectionChanged="Vel_SelectionChanged" />
          <ComboBox Name="Acc" Grid.Row="1" Grid.Column="0" Width="115" HorizontalAlignment="Right" Margin="0 20 80 0" HorizontalContentAlignment="Center" materialDesign:HintAssist.Hint="가속도" Style="{StaticResource MaterialDesignOutlinedComboBox}" Cursor="Hand" ItemsSource="{Binding Acc_List}" SelectionChanged="Acc_SelectionChanged" />
          <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="35,0,0,0">
            <Label Content="촬영횟수" Margin="5" VerticalAlignment="Center" />
            <ComboBox Name="CaptureCount" Width="170" Cursor="Hand" HorizontalContentAlignment="Center" SelectedIndex="{Binding CaptureCount_SelectedIndex}" ItemsSource="{Binding CaptureCount_List}" SelectionChanged="CaptureCountChanged_Click">
              <b:Interaction.Triggers>
                <b:EventTrigger EventName="SelectionChanged">
                  <b:InvokeCommandAction PassEventArgsToCommand="True" Command="{Binding CaptureCount_SelectionChangedCommand}" />
                </b:EventTrigger>
              </b:Interaction.Triggers>
            </ComboBox>
            <Label Content="속도설정" Margin="50 0 0 0" VerticalAlignment="Center" />
            <ToggleButton Name="UserAcc" IsChecked="False" Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}" Cursor="" Content="{materialDesign:PackIcon Kind=WrenchCogOutline, Size=21}" Click="UserAcc_Click" />
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Orientation="Vertical" Margin="0,0,20,0">
            <Label Content="촬영 높이" Width="150" HorizontalContentAlignment="Center" Background="#FF808080" Foreground="#FF000000" ToolTip="카메라 상하 높이 위치단 지정" ToolTipService.InitialShowDelay="100" />
            <Border BorderBrush="#FF808080" BorderThickness="1" Width="150" Height="170">
              <StackPanel>
                <RadioButton Content="  1단" Margin="40,15,0,0" Cursor="Hand" IsChecked="{Binding Pos_Level1}" Click="PosRadioButton_Click" />
                <RadioButton Content="  2단" Margin="40,10,0,0" Cursor="Hand" IsChecked="{Binding Pos_Level2}" Click="PosRadioButton_Click" />
                <RadioButton Content="  3단" Margin="40,10,0,0" Cursor="Hand" IsChecked="{Binding Pos_Level3}" Click="PosRadioButton_Click" />
                <RadioButton Content="  4단" Margin="40,10,0,0" Cursor="Hand" IsChecked="{Binding Pos_Level4}" Click="PosRadioButton_Click" />
                <RadioButton Content="  5단" Margin="40,10,0,0" Cursor="Hand" IsChecked="{Binding Pos_Level5}" Click="PosRadioButton_Click" />
              </StackPanel>
            </Border>
          </StackPanel>
          <Button Grid.Row="0" Grid.Column="2" Width="200" Style="{StaticResource MaterialDesignRaisedButton}" VerticalAlignment="Top" Command="{Binding TurnTableStartCommand}">
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Kind="CameraFlipOutline" Height="25" Width="25" />
              <TextBlock Text="일반 촬영" Margin="5" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <UniformGrid Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center">
            <CheckBox Content="보정" IsChecked="{Binding ProcessCentering}" />
            <Button Content="🛠" Width="35" Margin="5 0 0 0" Padding="0" Command="{Binding TurnTableCenteringCommand}" />
          </UniformGrid>
          <Button Grid.Row="2" Grid.Column="2" Width="200" Style="{StaticResource MaterialDesignRaisedButton}" Command="{Binding TurnTableNonStopStartCommand}" Visibility="{Binding ShowNonStopButton, Converter={StaticResource BooleanToVisibilityConverter1}}">
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Kind="CameraRetakeOutline" Height="25" Width="25" />
              <TextBlock Text="논스톱 촬영" Margin="5" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </GroupBox>
    </materialDesign:Card>
    <materialDesign:Card Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="4,4,1,4">
      <GroupBox Header="지정 촬영" IsEnabled="{Binding IsFree}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25*" />
            <ColumnDefinition Width="10*" />
            <ColumnDefinition Width="15*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="60*" />
            <RowDefinition Height="60*" />
            <RowDefinition Height="40*" />
          </Grid.RowDefinitions>
          <Button Grid.Row="0" Grid.Column="0" ToolTip="연속 이동(시계)" ToolTipService.InitialShowDelay="100" Width="60" Height="60" Margin="0 0 200 10" Style="{StaticResource MaterialDesignFloatingActionLightButton}" PreviewMouseLeftButtonDown="CW_MouseDownClick" PreviewMouseLeftButtonUp="MouseUpClick">
            <Image Source="/Images/CCW.png" Stretch="Fill" />
          </Button>
          <Button Grid.Row="1" Grid.Column="0" ToolTip="연속 이동(반시계)" ToolTipService.InitialShowDelay="100" Width="60" Height="60" Margin="0 0 200 10" Style="{StaticResource MaterialDesignFloatingActionLightButton}" PreviewMouseLeftButtonDown="CCW_MouseDownClick" PreviewMouseLeftButtonUp="MouseUpClick">
            <Image Source="/Images/CW.png" Stretch="Fill" />
          </Button>
          <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource MaterialDesignFloatingActionLightButton}" ToolTip="스텝 이동(시계)" ToolTipService.InitialShowDelay="100" Width="60" Height="60" Margin="200 0 0 10" Padding="0 0 -2 0" Cursor="" Command="{Binding MoveStepCWCommand}">
            <Image Source="/Images/CWStep.png" Stretch="Fill" />
          </Button>
          <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource MaterialDesignFloatingActionLightButton}" ToolTip="스텝 이동(반시계)" ToolTipService.InitialShowDelay="100" Width="60" Height="60" Margin="200 0 0 10" Padding="0 0 -2 0" Command="{Binding MoveStepCCWCommand}">
            <Image Source="/Images/CCWStep.png" Stretch="Fill" />
          </Button>
          <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Content="1회전" Style="{StaticResource MaterialDesignFloatingActionLightButton}" ToolTip="턴테이블 1 회전" ToolTipService.InitialShowDelay="100" Width="50" Height="50" Margin="0 0 0 10" Padding="5 7 5 7" Command="{Binding MoveOneCycleCommand}" />
          <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="35,0,0,0">
            <Label Content="각도선택" Margin="5" VerticalAlignment="Center" />
            <ComboBox Name="CaptureUserAngle" SelectedIndex="0" Width="170" Cursor="Hand">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <CheckBox Margin="0,0,4,0" VerticalAlignment="Top" IsChecked="{Binding Path=UserAngleSelected, UpdateSourceTrigger=PropertyChanged}" Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked" />
                    <TextBlock VerticalAlignment="Top" Margin="5,0,0,0" Text="{Binding UserAngleName}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
            <StackPanel Orientation="Horizontal" Margin="55,0,0,0">
              <TextBlock Text="모두선택" VerticalAlignment="Center" />
              <CheckBox Margin="15,0,0,0" VerticalAlignment="Center" Cursor="Hand" Checked="All_Checked" Unchecked="All_Unchecked" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Orientation="Vertical" Margin="0,0,20,0">
            <Label Content="각도 목록" HorizontalContentAlignment="Center" Width="150" Background="#FF808080" Foreground="#FF000000" ToolTip="선택 목록에 있는 각도만 촬영" ToolTipService.InitialShowDelay="100" />
            <Border BorderBrush="#FF808080" BorderThickness="1" HorizontalAlignment="Center" Width="150">
              <ListBox Name="ListBoxUserAngleChecked" Width="150" Height="170" VerticalAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Margin="35 0 0 -10" Text="{Binding UserAngleName}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ListBox>
            </Border>
          </StackPanel>
          <Button Grid.Row="0" Grid.Column="2" Width="200" Style="{StaticResource MaterialDesignRaisedButton}" VerticalAlignment="Top" Command="{Binding TurnTableUserStartCommand}">
            <StackPanel Orientation="Horizontal" Cursor="">
              <materialDesign:PackIcon Kind="CameraEnhanceOutline" Height="25" Width="25" />
              <TextBlock Text="지정 촬영" Margin="5" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 15 0 0">
            <Label Content="선택 :" VerticalContentAlignment="Bottom" />
            <Label VerticalContentAlignment="Bottom" Content="{Binding UserAngleSelectedCount}" />
            <Label Content="[개]" VerticalContentAlignment="Bottom" />
          </StackPanel>
        </Grid>
      </GroupBox>
    </materialDesign:Card>
    <Rectangle Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Fill="#FFD3D3D3" Margin="0,4,-5,0" />
    <Label Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" Foreground="#FF000000" Margin="10,0,0,0" Content="{Binding FolderPath}" />
  </Grid>
</Window>