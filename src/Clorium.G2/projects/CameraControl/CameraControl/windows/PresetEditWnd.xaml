<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="CameraControl.windows.PresetEditWnd" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:my="clr-namespace:CameraControl.windows" xmlns:Core="clr-namespace:CameraControl.Core;assembly=CameraControl.Core" xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro" xmlns:T="clr-namespace:CameraControl.Core.Translation;assembly=CameraControl.Core" Height="355" Width="520" WindowStartupLocation="CenterScreen" TextElement.Foreground="{DynamicResource MaterialDesignBody}" TextElement.FontWeight="Regular" TextElement.FontSize="13" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto" Background="{DynamicResource MaterialDesignPaper}" FontFamily="{DynamicResource MaterialDesignFont}" Title="{T:Translate PresetEditWindowTitle}" Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="10*" />
      <RowDefinition Height="257*" />
      <RowDefinition Height="39*" />
      <RowDefinition Height="10*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="10*" />
      <ColumnDefinition Width="150*" />
      <ColumnDefinition Width="10" />
      <ColumnDefinition Width="230*" />
      <ColumnDefinition Width="10*" />
    </Grid.ColumnDefinitions>
    <ListBox Name="lst_preset" Grid.Column="1" Grid.Row="1" ItemsSource="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=CameraPresets}" SelectedItem="{Binding Path=SelectedCameraPreset, RelativeSource={RelativeSource FindAncestor, AncestorType=my:PresetEditWnd, AncestorLevel=1}}" />
    <ListBox Name="lst_properties" Grid.Column="3" Grid.Row="1" ItemsSource="{Binding Path=SelectedCameraPreset.Values, RelativeSource={RelativeSource FindAncestor, AncestorType=my:PresetEditWnd, AncestorLevel=1}}">
      <ItemsControl.ItemTemplate>
        <HierarchicalDataTemplate>
          <WrapPanel>
            <Label FontStyle="Oblique" Margin="0,0,5,0" Content="{Binding Path=Name}" />
            <Label Content="{Binding Path=Value}" />
          </WrapPanel>
        </HierarchicalDataTemplate>
      </ItemsControl.ItemTemplate>
    </ListBox>
    <Button Name="btn_del_preset" Grid.Column="1" Grid.Row="2" Height="23" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,14,0,0" Width="130" Content="{T:Translate ButtonDeletePreset}" Click="btn_del_preset_Click" />
    <Button Name="btn_del_prop" Grid.Column="3" Grid.Row="2" Height="23" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,1,0" Width="130" Content="{T:Translate ButtonDeleteProperty}" Click="btn_del_prop_Click" />
  </Grid>
</Window>