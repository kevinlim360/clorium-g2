<Window x:Class="CameraControl.windows.PreviewWnd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Core="clr-namespace:CameraControl.Core;assembly=CameraControl.Core" xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:translation="clr-namespace:CameraControl.Core.Translation;assembly=CameraControl.Core"
        Title="{translation:TranslateExtension LabelPreviewWindows}" Height="600" Width="800"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
     TextElement.FontWeight="Regular"
     TextElement.FontSize="13"
     TextOptions.TextFormattingMode="Ideal"
     TextOptions.TextRenderingMode="Auto"
     Background="{DynamicResource MaterialDesignPaper}"
     FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl >
            <TabItem Header="{translation:TranslateExtension LabelTransformed}">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,0">
                    <Border Name="PreviewAestheticImageBorder"><Border.Style>
  <Style TargetType="Border">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="4" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=IsAestheticImprovementActive}" Value="True">
        <Setter Property="BorderBrush" Value="#FFFF8A00" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
</Border.Style><Image Name="Image" MouseMove="Image_MouseMove" MouseDown="Image_MouseDown"/></Border>
                </Grid>
            </TabItem>
            <TabItem Header="{translation:TranslateExtension LabelOriginal}">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,0">
                    <Border Name="PreviewAestheticImageOBorder"><Border.Style>
  <Style TargetType="Border">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="4" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=IsAestheticImprovementActive}" Value="True">
        <Setter Property="BorderBrush" Value="#FFFF8A00" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
</Border.Style><Image Name="ImageO" MouseMove="Image_MouseMove" MouseDown="Image_MouseDown"/></Border>
                </Grid>
            </TabItem>
        </TabControl>
        <StatusBar Grid.Row="1">
            <StackPanel Orientation="Horizontal">
            <Label Content="Color "/>
            <Label Name="Label" Width="40"/>
                <TextBox Name="TextBox" Width="70" IsReadOnly="True" Margin="2"/>
                <Label Content="Click on image to copy in clipboard"/>
            </StackPanel>
        </StatusBar>
    </Grid>
</Window>
