<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="CameraControl.windows.BarcodeWnd" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls" xmlns:viewModel="clr-namespace:CameraControl.ViewModel" xmlns:translation="clr-namespace:CameraControl.Core.Translation;assembly=CameraControl.Core" xmlns:T="clr-namespace:CameraControl.Core.Translation;assembly=CameraControl.Core" Height="600" Width="800" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" TextElement.Foreground="{DynamicResource MaterialDesignBody}" TextElement.FontWeight="Regular" TextElement.FontSize="13" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto" Background="{DynamicResource MaterialDesignPaper}" FontFamily="{DynamicResource MaterialDesignFont}" xmlns:windows="clr-namespace:CameraControl.windows" Title="{translation:Translate LabelBarcode}" Closing="MetroWindow_Closing">
  <FrameworkElement.DataContext>
    <viewModel:BarcodeViewModel />
  </FrameworkElement.DataContext>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <GroupBox Header="{translation:Translate LabelScanBarcode}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <TextBox Name="TextBox" TextWrapping="NoWrap" VerticalContentAlignment="Center" FontSize="40" controls:TextBoxHelper.ClearTextButton="True" controls:TextBoxHelper.SelectAllOnFocus="True" Margin="3" Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" KeyDown="TextBox_OnKeyDown" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <StackPanel>
            <CheckBox Margin="4" Content="{translation:Translate LabelCaptureAfterScan}" IsChecked="{Binding CaptureOnEnter}" />
            <CheckBox Margin="4" Content="{translation:Translate LabelKeepWindowActive}" IsChecked="{Binding KeepActive}" />
            <CheckBox Content="Capture with all cameras" Margin="4" IsChecked="{Binding CaptureAllCamera}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </GroupBox>
    <GroupBox Grid.Row="1" Header="{translation:Translate LabelData}">
      <DataGrid ItemsSource="{Binding Data}" SelectedItem="{Binding SelectedRowData}" />
    </GroupBox>
    <GroupBox Grid.Row="2" Header="{translation:Translate SettingsToolTip}">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <Button Margin="4" Content="{translation:Translate LabelImportData}" Command="{Binding ImportCommand}" />
          <Button Margin="4" Content="{translation:Translate LabelExportData}" Command="{Binding ExportCommand}" />
        </StackPanel>
      </Grid>
    </GroupBox>
  </Grid>
</Window>