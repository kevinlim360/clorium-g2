<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="CameraControl.windows.SavePresetWnd" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:my="clr-namespace:CameraControl.windows" xmlns:Core="clr-namespace:CameraControl.Core;assembly=CameraControl.Core" xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro" xmlns:T="clr-namespace:CameraControl.Core.Translation;assembly=CameraControl.Core" Height="152" Width="377" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True" TextElement.Foreground="{DynamicResource MaterialDesignBody}" Background="{DynamicResource MaterialDesignPaper}" Title="{T:Translate SavePresetWindowTitle}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Label Name="label1" Height="28" HorizontalAlignment="Left" Margin="12,12,0,0" VerticalAlignment="Top" Content="{T:Translate LabelPresetName}" />
    <ComboBox Name="textBox1" VerticalAlignment="Top" HorizontalAlignment="Right" Width="253" Height="23" Margin="0,14,12,0" IsEditable="True" Text="{Binding Path=CameraPreset.Name, RelativeSource={RelativeSource FindAncestor, AncestorType=my:SavePresetWnd, AncestorLevel=1}}" ItemsSource="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=CameraPresets}" />
    <Button Name="btn_save" Grid.Row="1" HorizontalAlignment="Left" Margin="16" VerticalAlignment="Bottom" Width="75" Content="{T:Translate ButtonSave}" Click="btn_save_Click" />
    <Button Name="btn_cancel" Grid.Row="1" HorizontalAlignment="Right" Margin="16" VerticalAlignment="Bottom" Width="75" Content="{T:Translate ButtonCancel}" Click="btn_cancel_Click" />
  </Grid>
</Window>