<?xml version="1.0" encoding="utf-8"?>
<!--
  Clorium G2 · 색보정 (design A, light). Tokens/styles: styles/g2theme.xaml.
  Engine: Classes/G2ImageAdjust.cs (Magick.NET / ImageMagick). The original photo is never overwritten.
-->
<Window x:Class="CameraControl.windows.G2ColorAdjustWnd" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="이미지보정" Width="1320" Height="860" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource G2Page}" FontFamily="{DynamicResource G2Font}" TextElement.Foreground="{DynamicResource G2Text}" TextElement.FontSize="13" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/CameraControl;component/styles/g2theme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- slider whose whole track is a colour gradient (colour temperature / tint / per-channel) -->
      <Style x:Key="CcGradientSlider" TargetType="Slider">
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Slider">
              <Grid>
                <Border Height="6" CornerRadius="3" Background="{TemplateBinding Background}" VerticalAlignment="Center" Margin="2,0" />
                <Track x:Name="PART_Track">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource G2SliderRepeat}" Background="Transparent" Command="Slider.DecreaseLarge" />
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource G2SliderRepeat}" Background="Transparent" Command="Slider.IncreaseLarge" />
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Ellipse Width="16" Height="16" Fill="White" Stroke="{StaticResource G2Text}" StrokeThickness="1.5" />
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- centre-zero slider: neutral grey track, thumb in accent -->
      <Style x:Key="CcCenterSlider" TargetType="Slider" BasedOn="{StaticResource CcGradientSlider}">
        <Setter Property="Background" Value="{StaticResource G2Line}" />
      </Style>

      <Style x:Key="CcValueBox" TargetType="TextBox" BasedOn="{StaticResource G2TextBox}">
        <Setter Property="FontFamily" Value="{StaticResource G2Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Width" Value="62" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
      </Style>

      <Style x:Key="CcRowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource G2Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
      </Style>

      <Style x:Key="CcBadge" TargetType="Border">
        <Setter Property="Background" Value="#CC16181C" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,3" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="348" />
    </Grid.ColumnDefinitions>

    <!-- ===================== stage ===================== -->
    <DockPanel Grid.Column="0" Margin="16,14,12,16">
      <Grid DockPanel.Dock="Top" Margin="2,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Viewbox Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0">
          <Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoDrop}" Stroke="{StaticResource G2Accent}" />
        </Viewbox>
        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
          <TextBlock x:Name="FileTitle" Style="{StaticResource G2SectionTitle}" Text="이미지보정" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="FileInfoText" Style="{StaticResource G2Caption}" Margin="0,2,0,0" FontFamily="{StaticResource G2Mono}" Text="" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="PrevSettingsButton" Style="{StaticResource G2GhostButton}" Margin="0,0,8,0" Click="PrevSettings_Click" ToolTip="마지막으로 저장한 보정값을 이 사진에 적용합니다.">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="15" Height="15" Margin="0,0,6,0"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoRestore}" /></Viewbox>
              <TextBlock Text="이전 보정값" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Background="{StaticResource G2Panel2}" CornerRadius="8" Padding="3" ToolTip="보정 후 · 원본 · 보정 전/후 나란히 보기. 사진을 누르고 있거나 \ 키로도 잠깐 원본을 볼 수 있습니다.">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ViewAdjusted" Style="{StaticResource G2Segment}" GroupName="cc-view" IsChecked="True" Checked="View_Checked" Content="보정 후" />
              <RadioButton x:Name="ViewOriginal" Style="{StaticResource G2Segment}" GroupName="cc-view" Checked="View_Checked" Content="원본" />
              <RadioButton x:Name="ViewSide" Style="{StaticResource G2Segment}" GroupName="cc-view" Checked="View_Checked">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="14" Height="14" Margin="0,0,5,0"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoPanel}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></Viewbox>
                  <TextBlock Text="나란히 비교" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <Border Background="{StaticResource G2Stage}" CornerRadius="12" ClipToBounds="True">
        <Grid>
          <Image x:Name="StageImage" Stretch="Uniform" Margin="14" RenderOptions.BitmapScalingMode="HighQuality" MouseLeftButtonDown="Stage_MouseDown" MouseLeftButtonUp="Stage_MouseUp" MouseLeave="Stage_MouseLeave" Cursor="Hand" />
          <Grid x:Name="SidePanel" Margin="14" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
              <Image x:Name="SideBefore" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
              <Border Style="{StaticResource CcBadge}" Background="{StaticResource G2Pr}" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Foreground="White" FontSize="11.5" FontWeight="SemiBold" Text="보정 전" />
              </Border>
            </Grid>
            <Border Grid.Column="1" Width="1" Background="{StaticResource G2Line2}" HorizontalAlignment="Center" />
            <Grid Grid.Column="2">
              <Image x:Name="SideAfter" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
              <Border Style="{StaticResource CcBadge}" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock x:Name="SideAfterText" Foreground="White" FontSize="11.5" FontWeight="SemiBold" Text="보정 후" />
              </Border>
            </Grid>
          </Grid>
          <Border x:Name="StateBadge" Style="{StaticResource CcBadge}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Visibility="Collapsed">
            <TextBlock x:Name="StateBadgeText" Foreground="White" FontSize="11.5" FontWeight="SemiBold" Text="보정 후" />
          </Border>
          <Border x:Name="ProxyBadge" Style="{StaticResource CcBadge}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14" Visibility="Collapsed" ToolTip="미리보기는 축소본입니다. 저장은 원본 해상도로 처리합니다.">
            <TextBlock x:Name="ProxyBadgeText" Foreground="White" FontSize="11" FontFamily="{StaticResource G2Mono}" Text="" />
          </Border>
          <Border x:Name="BusyOverlay" Background="{StaticResource G2Overlay}" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Width="260" Height="4" Foreground="{StaticResource G2Accent}" Background="{StaticResource G2Line}" BorderThickness="0" />
              <TextBlock x:Name="BusyText" Text="사진을 불러오는 중…" Margin="0,12,0,0" HorizontalAlignment="Center" Foreground="{StaticResource G2Sub}" TextAlignment="Center" />
              <TextBlock x:Name="BusyDetail" Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource G2Caption}" FontFamily="{StaticResource G2Mono}" Text="" TextTrimming="CharacterEllipsis" MaxWidth="420" />
              <Button x:Name="BatchStopButton" Style="{StaticResource G2GhostButton}" Margin="0,14,0,0" HorizontalAlignment="Center" Visibility="Collapsed" Click="BatchStop_Click" ToolTip="지금 처리 중인 사진을 저장한 뒤 멈춥니다. 이미 저장된 파일은 그대로 둡니다.">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoStop}" /></Viewbox>
                  <TextBlock Text="현재 사진 저장 후 중지" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </DockPanel>

    <!-- ===================== right panel ===================== -->
    <Border Grid.Column="1" Background="{StaticResource G2Panel}" BorderBrush="{StaticResource G2Line}" BorderThickness="1,0,0,0">
      <DockPanel>
        <!-- footer: save -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource G2Line}" BorderThickness="0,1,0,0" Padding="16,12,16,14">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button x:Name="ResetButton" Style="{StaticResource G2GhostButton}" Click="Reset_Click" ToolTip="모든 보정값을 기본값으로 되돌립니다.">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="15" Height="15" Margin="0,0,6,0"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoRestore}" /></Viewbox>
                  <TextBlock Text="초기화" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="SaveAsButton" Grid.Column="2" Style="{StaticResource G2GhostButton}" Click="SaveAs_Click" ToolTip="저장할 이름과 위치를 직접 지정합니다.">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="15" Height="15" Margin="0,0,6,0"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoFolder}" /></Viewbox>
                  <TextBlock Text="다른 이름으로…" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
            <Button x:Name="SaveButton" Style="{StaticResource G2PrimaryButton}" Height="42" Click="Save_Click" ToolTip="원본 해상도로 보정해 원본 옆에 새 파일(이름_cc)로 저장합니다. 원본은 그대로 둡니다. (Ctrl+S)">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Viewbox Width="16" Height="16" Margin="0,0,8,0"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoApply}" Stroke="White" /></Viewbox>
                <TextBlock Text="새 파일로 저장" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock x:Name="StatusText" Style="{StaticResource G2Caption}" Margin="2,10,0,0" TextWrapping="Wrap" Text="원본은 덮어쓰지 않습니다." />
          </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ControlsPanel" Margin="16,14,16,14">
            <!-- templates -->
            <Border Style="{StaticResource G2Card}" Margin="0,0,0,12">
              <StackPanel>
                <DockPanel Margin="0,0,0,6">
                  <TextBlock x:Name="TemplateCount" DockPanel.Dock="Right" Style="{StaticResource G2Caption}" FontFamily="{StaticResource G2Mono}" FontSize="10.5" VerticalAlignment="Center" Text="" />
                  <Viewbox Width="16" Height="16" Margin="0,0,6,0" DockPanel.Dock="Left"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoStack}" Stroke="{StaticResource G2Sub}" /></Viewbox>
                  <TextBlock Style="{StaticResource G2SectionTitle}" FontSize="12.5" Text="템플릿" />
                </DockPanel>
                <TextBlock x:Name="TemplateEmpty" Style="{StaticResource G2Caption}" FontSize="11" TextWrapping="Wrap" Margin="2,0,2,4" Text="저장된 템플릿이 없습니다. 값을 조절한 뒤 '현재 값 저장'을 누르세요." />
                <ListBox x:Name="TemplateList" Style="{StaticResource G2List}" MaxHeight="176" SelectionChanged="TemplateList_SelectionChanged" MouseDoubleClick="TemplateList_DoubleClick" ToolTip="누르면 이 사진에 바로 적용됩니다. 두 번 누르면 이름을 바꿉니다.">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,4">
                        <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Summary}" FontSize="10.5" FontWeight="Normal" Foreground="{StaticResource G2Sub}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="TemplateState" Style="{StaticResource G2Caption}" FontSize="10.5" Margin="2,4,2,0" TextWrapping="Wrap" Text="" />
                <Grid x:Name="TemplateNameRow" Margin="0,8,0,0" Visibility="Collapsed">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="TemplateNameBox" Style="{StaticResource G2TextBox}" MaxLength="40" KeyDown="TemplateNameBox_KeyDown" ToolTip="템플릿 이름 (Enter 저장 · Esc 취소)" />
                  <Button x:Name="TemplateNameOk" Grid.Column="1" Style="{StaticResource G2GhostButton}" Margin="6,0,0,0" Padding="10,0" Foreground="{StaticResource G2Accent}" FontWeight="SemiBold" Content="저장" Click="TemplateNameOk_Click" />
                  <Button Grid.Column="2" Style="{StaticResource G2GhostButton}" Margin="6,0,0,0" Padding="10,0" Content="취소" Click="TemplateNameCancel_Click" />
                </Grid>
                <Grid x:Name="TemplateButtons" Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Button x:Name="NewTemplateButton" Style="{StaticResource G2GhostButton}" Padding="8,0" Click="NewTemplate_Click" ToolTip="지금 보정값을 새 템플릿으로 저장합니다.">
                    <StackPanel Orientation="Horizontal">
                      <Viewbox Width="14" Height="14" Margin="0,0,5,0"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoPlus}" /></Viewbox>
                      <TextBlock Text="현재 값 저장" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="UpdateTemplateButton" Grid.Column="2" Style="{StaticResource G2GhostButton}" Padding="8,0" Click="UpdateTemplate_Click" ToolTip="선택한 템플릿을 지금 보정값으로 바꿉니다.">
                    <StackPanel Orientation="Horizontal">
                      <Viewbox Width="14" Height="14" Margin="0,0,5,0"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoPencil}" /></Viewbox>
                      <TextBlock Text="덮어쓰기" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="DeleteTemplateButton" Grid.Column="4" Style="{StaticResource G2GhostButton}" Width="34" Padding="0" Click="DeleteTemplate_Click" ToolTip="선택한 템플릿을 삭제합니다.">
                    <Viewbox Width="14" Height="14"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoTrash}" /></Viewbox>
                  </Button>
                </Grid>
                <Button x:Name="BatchButton" Style="{StaticResource G2GhostButton}" Margin="0,8,0,0" Height="34" Click="Batch_Click" ToolTip="폴더 하나를 고르면 그 폴더의 모든 사진(하위 폴더 제외)에 선택한 템플릿을 적용해 폴더\_cc\ 에 저장합니다. 원본은 그대로 둡니다.">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="15" Height="15" Margin="0,0,6,0"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoFolder}" /></Viewbox>
                    <TextBlock Text="일괄 적용…" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>

            <!-- histogram -->
            <Border Style="{StaticResource G2Card}" Padding="12,10,12,10">
              <StackPanel>
                <DockPanel Margin="0,0,0,8">
                  <Viewbox Width="16" Height="16" Margin="0,0,6,0" DockPanel.Dock="Left"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoHistogram}" Stroke="{StaticResource G2Sub}" /></Viewbox>
                  <TextBlock x:Name="ClipText" DockPanel.Dock="Right" Style="{StaticResource G2Caption}" FontFamily="{StaticResource G2Mono}" FontSize="10.5" VerticalAlignment="Center" Text="" ToolTip="검은색으로 뭉친 픽셀(그림자) · 어느 채널이든 최대값에 닿은 픽셀(하이라이트) 비율" />
                  <TextBlock Style="{StaticResource G2SectionTitle}" FontSize="12.5" Text="히스토그램" />
                </DockPanel>
                <Border Background="{StaticResource G2Panel2}" CornerRadius="8" Height="104" ClipToBounds="True">
                  <Viewbox Stretch="Fill" Margin="6,8,6,4">
                    <Canvas Width="256" Height="100">
                      <Path x:Name="HistRed" Fill="#66E5484D" />
                      <Path x:Name="HistGreen" Fill="#6630A46C" />
                      <Path x:Name="HistBlue" Fill="#663E7BFA" />
                      <Path x:Name="HistLuma" Stroke="#B316181C" StrokeThickness="0.9" />
                    </Canvas>
                  </Viewbox>
                </Border>
              </StackPanel>
            </Border>

            <!-- tone -->
            <Border Style="{StaticResource G2Card}" Margin="0,12,0,0">
              <StackPanel x:Name="TonePanel">
                <TextBlock Style="{StaticResource G2SectionTitle}" FontSize="12.5" Text="기본 보정" Margin="0,0,0,4" />
              </StackPanel>
            </Border>

            <!-- white balance -->
            <Border Style="{StaticResource G2Card}" Margin="0,12,0,0">
              <StackPanel x:Name="ColorPanel">
                <TextBlock Style="{StaticResource G2SectionTitle}" FontSize="12.5" Text="색 균형" Margin="0,0,0,4" />
              </StackPanel>
            </Border>

            <!-- per-channel levels -->
            <Border Style="{StaticResource G2Card}" Margin="0,12,0,0">
              <StackPanel x:Name="LevelsPanel">
                <DockPanel Margin="0,0,0,8">
                  <Button DockPanel.Dock="Right" Style="{StaticResource G2IconButton}" Width="24" Height="24" Click="ResetChannel_Click" ToolTip="선택한 채널의 레벨만 되돌립니다.">
                    <Viewbox Width="14" Height="14"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoRestore}" /></Viewbox>
                  </Button>
                  <TextBlock Style="{StaticResource G2SectionTitle}" FontSize="12.5" Text="채널별 레벨" />
                </DockPanel>
                <Border Background="{StaticResource G2Panel2}" CornerRadius="8" Padding="3" Margin="0,0,0,6">
                  <UniformGrid Columns="4">
                    <RadioButton x:Name="ChAll" Style="{StaticResource G2Segment}" GroupName="cc-ch" IsChecked="True" Checked="Channel_Checked" Tag="0" Content="전체" />
                    <RadioButton x:Name="ChRed" Style="{StaticResource G2Segment}" GroupName="cc-ch" Checked="Channel_Checked" Tag="1">
                      <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#FFE5484D" Margin="0,0,5,0" VerticalAlignment="Center" /><TextBlock Text="R" /></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ChGreen" Style="{StaticResource G2Segment}" GroupName="cc-ch" Checked="Channel_Checked" Tag="2">
                      <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#FF30A46C" Margin="0,0,5,0" VerticalAlignment="Center" /><TextBlock Text="G" /></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ChBlue" Style="{StaticResource G2Segment}" GroupName="cc-ch" Checked="Channel_Checked" Tag="3">
                      <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#FF3E7BFA" Margin="0,0,5,0" VerticalAlignment="Center" /><TextBlock Text="B" /></StackPanel>
                    </RadioButton>
                  </UniformGrid>
                </Border>
                <TextBlock x:Name="ChannelSummary" Style="{StaticResource G2Caption}" FontFamily="{StaticResource G2Mono}" FontSize="10.5" Margin="2,0,0,2" Text="" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource G2Caption}" Margin="2,12,2,0" TextWrapping="Wrap" FontSize="11" Text="항목 이름을 두 번 누르면 그 값만 기본값으로 돌아갑니다. 값 칸에 숫자를 입력하고 Enter를 눌러도 됩니다." />
            <TextBlock x:Name="EngineText" Style="{StaticResource G2Caption}" Margin="2,6,2,0" TextWrapping="Wrap" FontSize="10.5" FontFamily="{StaticResource G2Mono}" Text="" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</Window>
