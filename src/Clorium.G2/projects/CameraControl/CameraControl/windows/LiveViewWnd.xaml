                <Controls:NumericUpDown Grid.Row="1" Grid.Column="2" Margin="3,3,3,3" Minimum="0" Value="{Binding SnapshotCaptureCount}" IsEnabled="{Binding IsFree}" />
                <Label Grid.Row="2" Margin="3,3,3,3" Grid.ColumnSpan="2" Content="{T:Translate LabelCaptureDelay}" />
                <Controls:NumericUpDown Grid.Row="2" Grid.Column="2" Margin="3,3,3,3" Minimum="0" Value="{Binding SnapshotCaptureTime}" IsEnabled="{Binding IsFree}" />
              </Grid>
            </Expander>
          </materialDesign:Card>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <materialDesign:Card Grid.Row="2" Grid.Column="2" Width="300" Visibility="{Binding DelayedStart, ConverterParameter=false, Converter={StaticResource BooleanToVisibilityConverter1}}">
      <Grid Name="grid_wait" Margin="4">
        <ProgressBar IsIndeterminate="True" Height="20" />
        <Label HorizontalContentAlignment="Center" Height="67" VerticalAlignment="Center" Content="{T:Translate LabelWaitingForDevice}" />
      </Grid>
    </materialDesign:Card>
    <Ellipse Grid.Row="0" Grid.Column="2" Grid.RowSpan="5" Width="190" Height="190" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8" RenderTransformOrigin="0.5,0.5" StrokeThickness="15" StrokeDashArray="4 1" Visibility="{Binding CountDownVisible, ConverterParameter=false, Converter={StaticResource BooleanToVisibilityConverter1}}">
      <Shape.Stroke>
        <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
          <GradientStop Color="Blue" />
          <GradientStop Color="Red" Offset="0.5" />
          <GradientStop Color="Green" Offset="1" />
        </LinearGradientBrush>
      </Shape.Stroke>
      <UIElement.RenderTransform>
        <RotateTransform />
      </UIElement.RenderTransform>
      <FrameworkElement.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="-360" Duration="0:0:2" RepeatBehavior="Forever" />
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </FrameworkElement.Triggers>
    </Ellipse>
    <Label Grid.Row="0" Grid.Column="2" Grid.RowSpan="4" FontSize="155" Padding="0" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="#AAFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{Binding CountDown}" Visibility="{Binding CountDownVisible, ConverterParameter=false, Converter={StaticResource BooleanToVisibilityConverter1}}" />
    <materialDesign:Snackbar Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" IsActive="{Binding Source={x:Static Devices:StaticHelper.Instance}, Path=IsActive}">
      <materialDesign:SnackbarMessage Content="{Binding Source={x:Static Devices:StaticHelper.Instance}, Path=SystemMessage}" />
    </materialDesign:Snackbar>
  </Grid>
</Window>
