<?xml version="1.0" encoding="utf-8"?>
<!--
  Clorium G2 · 라이브뷰 (G2 design: tokens/styles from styles/g2theme.xaml, 밝은/어두운 화면 via DynamicResource).
  Keeps every element name, binding and handler the code-behind and LiveViewViewModel use.
-->
<Window x:Class="CameraControl.windows.LiveViewWnd" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro" xmlns:local="clr-namespace:CameraControl.Controls" xmlns:T="clr-namespace:CameraControl.Core.Translation;assembly=CameraControl.Core" xmlns:Devices="clr-namespace:CameraControl.Devices;assembly=CameraControl.Devices" xmlns:Classes="clr-namespace:CameraControl.Core.Classes;assembly=CameraControl.Core" xmlns:ViewModel="clr-namespace:CameraControl.ViewModel" xmlns:Core="clr-namespace:CameraControl.Core;assembly=CameraControl.Core" xmlns:wpf="clr-namespace:CameraControl.Core.Wpf;assembly=CameraControl.Core" xmlns:local1="clr-namespace:CameraControl.Core.Controls.ZoomAndPan;assembly=CameraControl.Core" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" Height="937" Width="1180" MinWidth="760" MinHeight="560" AllowDrop="True" UseLayoutRounding="True" TextElement.Foreground="{DynamicResource G2Text}" TextElement.FontWeight="Regular" TextElement.FontSize="13" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto" Background="{DynamicResource G2Page}" FontFamily="{DynamicResource G2Font}" xmlns:windows="clr-namespace:CameraControl.windows" Title="{Binding Title}" Topmost="{Binding StayOnTop, Mode=OneWay}" Closing="Window_Closing" StateChanged="MetroWindow_StateChanged" PreviewKeyDown="MetroWindow_PreviewKeyDown" Drop="MetroWindow_Drop">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/MoreIcons.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.CheckBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.PopupBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.RadioButton.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.TextBlock.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.TextBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ToggleButton.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Snackbar.xaml" />
        <ResourceDictionary Source="pack://application:,,,/CameraControl;component/styles/g2theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter1" />
      <Geometry x:Key="LvIcoZoomOut">M10,4 A6,6 0 1 0 10.001,4 Z M14.5,14.5 L20,20 M7,10 H13</Geometry>
      <Geometry x:Key="LvIcoZoomIn">M10,4 A6,6 0 1 0 10.001,4 Z M14.5,14.5 L20,20 M7,10 H13 M10,7 V13</Geometry>
      <Geometry x:Key="LvIcoEdge">M12,3 A9,9 0 1 0 12.001,3 Z M12,3 V21 M12,8 H18 M12,12 H20 M12,16 H18</Geometry>
      <Geometry x:Key="LvIcoLock">M6,11 H18 V20 H6 Z M8.5,11 V8 A3.5,3.5 0 0 1 15.5,8 V11</Geometry>
      <Geometry x:Key="LvIcoMinus">M5,12 H19</Geometry>
      <Style x:Key="LvToolButton" TargetType="Button" BasedOn="{StaticResource G2IconButton}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource G2Text}" />
      </Style>
      <Style x:Key="LvToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource G2IconToggle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="2" />
      </Style>
      <Style x:Key="LvFocusStep" TargetType="Button" BasedOn="{StaticResource G2GhostButton}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="FontFamily" Value="{StaticResource G2Mono}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="LvFloat" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource G2Overlay}" />
        <Setter Property="BorderBrush" Value="{DynamicResource G2Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="4" />
      </Style>
      <Style x:Key="LvSection" TargetType="Border" BasedOn="{StaticResource G2Card}">
        <Setter Property="Padding" Value="8,2,8,4" />
        <Setter Property="Margin" Value="0,0,0,8" />
      </Style>
      <Style x:Key="LvRowLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource G2Sub}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,6,0,4" />
      </Style>
      <Style x:Key="LvNumeric" TargetType="{x:Type Controls:NumericUpDown}">
        <Setter Property="Foreground" Value="{DynamicResource G2Text}" />
        <Setter Property="Background" Value="{DynamicResource G2Panel2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource G2Line}" />
        <Setter Property="Height" Value="28" />
      </Style>
      <Style x:Key="LvCheck" TargetType="CheckBox" BasedOn="{StaticResource G2CheckBox}">
        <Setter Property="Margin" Value="0,4" />
      </Style>
      <Style x:Key="ZoomStyle" TargetType="{x:Type local1:ZoomAndPanControl}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type local1:ZoomAndPanControl}">
              <Border Visibility="{TemplateBinding local1:ZoomAndPanControl.ZoneOneVisibility}" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
                <ContentPresenter Name="PART_Content" HorizontalAlignment="Left" VerticalAlignment="Top" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <ControlTemplate x:Key="ResizeDecoratorTemplate" TargetType="{x:Type Control}">
        <Grid>
          <wpf:ResizeThumb Width="5" Height="7" Cursor="SizeNWSE" Margin="-2 -3 0 0" VerticalAlignment="Top" HorizontalAlignment="Left" />
          <wpf:ResizeThumb Width="5" Height="7" Cursor="SizeNESW" Margin="0 -3 -2 0" VerticalAlignment="Top" HorizontalAlignment="Right" />
          <wpf:ResizeThumb Width="5" Height="7" Cursor="SizeNESW" Margin="-2 0 0 -3" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
          <wpf:ResizeThumb Width="5" Height="7" Cursor="SizeNWSE" Margin="0 0 -2 -3" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
        </Grid>
      </ControlTemplate>
      <ControlTemplate x:Key="MoveThumbTemplate" TargetType="{x:Type wpf:MoveThumb}">
        <Rectangle Fill="#00FFFFFF" />
      </ControlTemplate>
      <ControlTemplate x:Key="DesignerItemTemplate" TargetType="{x:Type ContentControl}">
        <Grid DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
          <ContentPresenter Content="{TemplateBinding ContentControl.Content}" />
          <wpf:MoveThumb Cursor="SizeAll" Template="{StaticResource MoveThumbTemplate}" />
          <Control Template="{StaticResource ResizeDecoratorTemplate}" />
        </Grid>
      </ControlTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <FrameworkElement.DataContext>
    <ViewModel:LiveViewViewModel />
  </FrameworkElement.DataContext>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===================== side panel ===================== -->
    <Border Grid.Column="0" Width="304" Background="{DynamicResource G2Panel}" BorderBrush="{DynamicResource G2Line}" BorderThickness="0,0,1,0" Visibility="{Binding ElementName=PanelButton, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter1}}">
      <DockPanel Margin="14,14,12,10">
        <Grid DockPanel.Dock="Top" Margin="2,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Viewbox Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0">
            <Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoLive}" Stroke="{DynamicResource G2Accent}" />
          </Viewbox>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource G2SectionTitle}" Text="라이브뷰" />
            <TextBlock Style="{StaticResource G2Caption}" Margin="0,2,0,0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>

        <!-- capture -->
        <Border DockPanel.Dock="Top" Style="{StaticResource G2Card}" Padding="10" Margin="0,0,0,8">
          <StackPanel>
            <Grid>
              <Button Style="{StaticResource G2PrimaryButton}" Height="40" FontWeight="SemiBold" FontSize="14" Command="{Binding CaptureCommand}" IsEnabled="{Binding IsFree}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Viewbox Width="17" Height="17" Margin="0,0,7,0"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoCamera}" Stroke="{DynamicResource G2OnAccent}" /></Viewbox>
                  <TextBlock VerticalAlignment="Center" Text="{T:Translate ButtonCapture}" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource G2GhostButton}" Height="40" Foreground="{DynamicResource G2Err}" FontWeight="SemiBold" Cursor="Hand" Content="{T:Translate ButtonCancel}" Command="{Binding CancelCaptureCommand}" Visibility="{Binding CaptureInProgress, Converter={StaticResource BooleanToVisibilityConverter1}}" />
            </Grid>
            <UniformGrid Columns="3" Margin="0,8,0,0">
              <Button Style="{StaticResource G2GhostButton}" Margin="0,0,4,0" Padding="4,0" Content="{T:Translate ButtonAutoFocus}" Command="{Binding AutoFocusCommand}" Visibility="{Binding ShowAutofocusLiveView, Converter={StaticResource BooleanToVisibilityConverter1}, Source={x:Static Core:ServiceProvider.Branding}}" />
              <Button Style="{StaticResource G2GhostButton}" Margin="2,0" Padding="4,0" Content="{Binding RecButtonText}" Command="{Binding RecordMovieCommand}" IsEnabled="{Binding IsFree}" />
              <Button Style="{StaticResource G2GhostButton}" Margin="4,0,0,0" Padding="4,0" Content="{T:Translate ButtonPreview}" Command="{Binding PreviewCommand}" IsEnabled="{Binding IsFree}" />
            </UniformGrid>
            <CheckBox Style="{StaticResource LvCheck}" Margin="2,10,0,0" Content="{T:Translate LabelMeasure}" ToolTip="{T:Translate LabelMeasure}" IsChecked="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=GetMeasurePicture}" />
          </StackPanel>
        </Border>

        <!-- last capture -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource G2Stage}" CornerRadius="10" Height="183" Margin="0,0,0,8" ClipToBounds="True">
          <Image Name="_previeImage" Width="260" Height="175" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Preview}" MouseDown="canvas_image_MouseDown">
            <FrameworkElement.LayoutTransform>
              <RotateTransform Angle="{Binding Rotation}" />
            </FrameworkElement.LayoutTransform>
          </Image>
        </Border>

        <Button x:Name="SuperfocusLauncher" DockPanel.Dock="Top" Style="{StaticResource G2GhostButton}" Height="36" Margin="0,0,0,8" HorizontalContentAlignment="Left" Visibility="{Binding UseSuperfocus, Converter={StaticResource BooleanToVisibilityConverter1}, Source={x:Static Core:ServiceProvider.Settings}}" Click="SuperfocusOpen_Click" ToolTip="이동 가능한 수퍼포커스 조작 창을 엽니다." ToolTipService.InitialShowDelay="300">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="16" Height="16" Margin="0,0,8,0"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoStack}" /></Viewbox>
            <TextBlock VerticalAlignment="Center" Text="수퍼포커스" />
          </StackPanel>
        </Button>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource LvSection}" Visibility="{Binding ShowOverlayLiveView, Converter={StaticResource BooleanToVisibilityConverter1}, Source={x:Static Core:ServiceProvider.Branding}}">
              <Expander Style="{StaticResource G2Expander}" Name="ExpanderOverlay" IsExpanded="True" Header="{T:Translate LabelOverlay}" Expanded="Expander_Click">
                <Grid Margin="2,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Grid.Row="0" Grid.Column="0">
                    <CheckBox Style="{StaticResource LvCheck}" Content="{T:Translate LabelActivate}" IsChecked="{Binding OverlayActivated}" />
                    <CheckBox Style="{StaticResource LvCheck}" Content="{T:Translate LabelOverlayUseLastCaptured}" IsChecked="{Binding OverlayUseLastCaptured}" IsEnabled="{Binding OverlayActivated}" />
                  </StackPanel>
                  <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource G2IconButton}" Width="32" Height="32" VerticalAlignment="Top" Foreground="{DynamicResource G2Sub}" Command="{Binding ResetOverlayCommand}" ToolTip="{T:Translate LabelReset}">
                    <Viewbox Width="16" Height="16"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoRestore}" /></Viewbox>
                  </Button>
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource LvRowLabel}" Text="{T:Translate LabelOveralayImageFile}" />
                  <ComboBox Style="{StaticResource G2ComboBox}" Grid.Row="2" Grid.Column="0" SelectedValuePath="Value" DisplayMemberPath="Name" SelectedValue="{Binding SelectedOverlay}" ItemsSource="{Binding Overlays}">
                    <FrameworkElement.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="삭제" Command="{Binding PlacementTarget.DataContext.DeleteOverlayItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                      </ContextMenu>
                    </FrameworkElement.ContextMenu>
                  </ComboBox>
                  <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource G2GhostButton}" Width="36" Padding="0" Margin="6,0,0,0" Command="{Binding BrowseOverlayCommand}" ToolTip="{T:Translate LabelOveralayImageFile}">
                    <Viewbox Width="16" Height="16"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoFolder}" /></Viewbox>
                  </Button>
                  <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource LvRowLabel}" Text="{T:Translate LabelOverlayTransparency}" />
                  <Slider Style="{StaticResource G2Slider}" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="{Binding OverlayTransparency}" IsEnabled="{Binding OverlayActivated}" />
                  <Controls:NumericUpDown Grid.Row="4" Grid.Column="1" Style="{StaticResource LvNumeric}" Margin="6,0,0,0" Minimum="0" Maximum="100" NumericInputMode="Numbers" Speedup="False" Width="72" Value="{Binding OverlayTransparency}" IsEnabled="{Binding OverlayActivated}" />
                  <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource LvRowLabel}" Text="{T:Translate LabelScaling}" Visibility="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=ResolutionChange, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <Slider Style="{StaticResource G2Slider}" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Minimum="-100" Maximum="100" Value="{Binding OverlayScale}" IsEnabled="{Binding OverlayActivated}" Visibility="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=ResolutionChange, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <Controls:NumericUpDown Grid.Row="6" Grid.Column="1" Style="{StaticResource LvNumeric}" Margin="6,0,0,0" Minimum="-100" Maximum="100" NumericInputMode="Numbers" Speedup="False" Width="72" Value="{Binding OverlayScale}" IsEnabled="{Binding OverlayActivated}" Visibility="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=ResolutionChange, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Style="{StaticResource LvRowLabel}" Text="{T:Translate LabelHorizontal}" Visibility="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=ResolutionChange, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <Slider Style="{StaticResource G2Slider}" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Minimum="-100" Maximum="100" Value="{Binding OverlayHorizontal}" IsEnabled="{Binding OverlayActivated}" Visibility="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=ResolutionChange, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <Controls:NumericUpDown Grid.Row="8" Grid.Column="1" Style="{StaticResource LvNumeric}" Margin="6,0,0,0" Minimum="-100" Maximum="100" NumericInputMode="Numbers" Speedup="False" Width="72" Value="{Binding OverlayHorizontal}" IsEnabled="{Binding OverlayActivated}" Visibility="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=ResolutionChange, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Style="{StaticResource LvRowLabel}" Text="{T:Translate LabelVertical}" Visibility="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=ResolutionChange, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <Slider Style="{StaticResource G2Slider}" Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Minimum="-100" Maximum="100" Value="{Binding OverlayVertical}" IsEnabled="{Binding OverlayActivated}" Visibility="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=ResolutionChange, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <Controls:NumericUpDown Grid.Row="10" Grid.Column="1" Style="{StaticResource LvNumeric}" Margin="6,0,0,0" Minimum="-100" Maximum="100" NumericInputMode="Numbers" Speedup="False" Width="72" Value="{Binding OverlayVertical}" IsEnabled="{Binding OverlayActivated}" Visibility="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=ResolutionChange, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
              </Expander>
            </Border>

            <Border Style="{StaticResource LvSection}" Visibility="{Binding ShowDisplayLiveView, Converter={StaticResource BooleanToVisibilityConverter1}, Source={x:Static Core:ServiceProvider.Branding}}">
              <Expander Style="{StaticResource G2Expander}" Name="ExpanderDisplay" Header="{T:Translate LabelDisplay}" Expanded="Expander_Click">
                <StackPanel Margin="2,0,0,8">
                  <TextBlock Style="{StaticResource LvRowLabel}" Text="{T:Translate LabelBrightness}" />
                  <Slider Style="{StaticResource G2Slider}" Maximum="255" Minimum="-255" Value="{Binding Brightness}">
                    <FrameworkElement.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{T:Translate LabelReset}" Command="{Binding ResetBrigthnessCommand}" />
                      </ContextMenu>
                    </FrameworkElement.ContextMenu>
                  </Slider>
                  <TextBlock Style="{StaticResource LvRowLabel}" Text="{T:Translate LabelLiveViewRotation}" />
                  <ComboBox Style="{StaticResource G2ComboBox}" SelectedIndex="{Binding RotationIndex}">
                    <ComboBoxItem Content="{T:Translate LabelRotateNone}" />
                    <ComboBoxItem Content="{T:Translate LabelRotate90}" />
                    <ComboBoxItem Content="{T:Translate LabelRotate180}" />
                    <ComboBoxItem Content="{T:Translate LabelRotate270}" />
                  </ComboBox>
                  <TextBlock Style="{StaticResource LvRowLabel}" Text="{T:Translate LabelGridColor}" />
                  <wpf:Colorpicker SelectedColor="{Binding GridColor, Mode=TwoWay}" />
                  <CheckBox Style="{StaticResource LvCheck}" Margin="0,10,0,4" Content="{T:Translate LabelInvert}" IsChecked="{Binding Invert}" />
                  <CheckBox Style="{StaticResource LvCheck}" Content="{T:Translate LabelBW}" IsChecked="{Binding BlackAndWhite}" />
                  <CheckBox Style="{StaticResource LvCheck}" Content="{T:Translate LabelFlip}" IsChecked="{Binding FlipImage}" />
                  <CheckBox Style="{StaticResource LvCheck}" Content="{T:Translate LabelShowFocusRect}" IsChecked="{Binding ShowFocusRect}" />
                  <CheckBox Style="{StaticResource LvCheck}" Name="Check_FocusControl" Content="{T:Translate LabelShowFocusControlBar}" IsChecked="{Binding ShowFocusControlLiveView, Source={x:Static Core:ServiceProvider.Branding}}" />
                  <Grid Margin="0,4,0,0">
                    <Rectangle RadiusX="4" RadiusY="4" Fill="{Binding NoProcessingWarnColor}" />
                    <CheckBox Style="{StaticResource LvCheck}" Margin="4" Content="{T:Translate LabelNoProccesing}" IsChecked="{Binding NoProcessing}" ToolTip="{T:Translate LabelNoProccesingTooltip}" />
                  </Grid>
                </StackPanel>
              </Expander>
            </Border>

            <Border Style="{StaticResource LvSection}">
              <Expander Style="{StaticResource G2Expander}" Name="ExpanderCalibration" Header="{T:Translate LabelCalibration}" Expanded="Expander_Click">
                <Grid Margin="2,0,0,8">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <CheckBox Style="{StaticResource LvCheck}" Name="Centering" Grid.Row="0" Content="{T:Translate LableMeasureCenter}" Checked="CheckedCentering_Click" Unchecked="UncheckedCentering_Click" />
                  <CheckBox Style="{StaticResource LvCheck}" Name="Tilting" Grid.Row="1" Content="{T:Translate LableMeasureTilt}" Checked="CheckedTilting_Click" Unchecked="UncheckedTilting_Click" />
                  <CheckBox Style="{StaticResource LvCheck}" Name="Drawing" Grid.Row="2" Content="{T:Translate LableMeasureLine}" Checked="CheckedDrawing_Click" Unchecked="UncheckedDrawing_Click" />
                  <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,6">
                    <TextBlock Style="{StaticResource LvRowLabel}" Margin="0,0,6,0" Text="{T:Translate LabelReference}" />
                    <TextBox Style="{StaticResource G2TextBox}" Width="56" HorizontalContentAlignment="Center" Text="{Binding CalibrateBase}" />
                    <TextBlock Style="{StaticResource LvRowLabel}" Margin="6,0,8,0" Text="mm" />
                    <Button Style="{StaticResource G2GhostButton}" Padding="10,0" Content="{T:Translate LabelScale}" Command="{Binding CalibrateCommand}" />
                  </StackPanel>
                  <TextBlock Grid.Row="4" Style="{StaticResource LvRowLabel}" Text="{T:Translate LabelScaleValue}" />
                  <TextBox Style="{StaticResource G2TextBox}" Grid.Row="5" IsReadOnly="True" Foreground="{DynamicResource G2Sub}" FontFamily="{StaticResource G2Mono}" Text="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=MetaScale}" />
                  <StackPanel Name="BoxSize" Grid.Row="6" Orientation="Horizontal" Margin="0,8,0,4" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource LvRowLabel}" Margin="0,0,6,0" Text="{T:Translate LabelBoxSize}" />
                    <TextBox Style="{StaticResource G2TextBox}" Width="56" HorizontalContentAlignment="Center" IsReadOnly="True" Foreground="{DynamicResource G2Sub}" Text="{Binding BoxWidth_mm}" />
                    <TextBlock Style="{StaticResource LvRowLabel}" Margin="6,0" Text="x" />
                    <TextBox Style="{StaticResource G2TextBox}" Width="56" HorizontalContentAlignment="Center" IsReadOnly="True" Foreground="{DynamicResource G2Sub}" Text="{Binding BoxHeight_mm}" />
                    <TextBlock Style="{StaticResource LvRowLabel}" Margin="6,0,0,0" Text="mm" />
                  </StackPanel>
                  <StackPanel Name="Result_Center" Grid.Row="7" Orientation="Horizontal" Margin="0,6,0,4" Visibility="Collapsed">
                    <TextBlock Foreground="{DynamicResource G2Err}" FontFamily="{StaticResource G2Mono}" Text="{Binding Center_Disp}" />
                  </StackPanel>
                  <StackPanel Name="Result_Tilt" Grid.Row="8" Orientation="Vertical" Margin="0,6,0,4" Visibility="Collapsed">
                    <TextBlock Foreground="{DynamicResource G2Err}" FontFamily="{StaticResource G2Mono}" Text="{Binding Tilt_Deg}" />
                    <TextBlock Foreground="{DynamicResource G2Pr}" FontFamily="{StaticResource G2Mono}" Text="{Binding Direction_Deg}" />
                    <TextBlock Foreground="{DynamicResource G2Sub}" FontFamily="{StaticResource G2Mono}" Text="{Binding Scale_mm}" />
                  </StackPanel>
                </Grid>
              </Expander>
            </Border>

            <Border Style="{StaticResource LvSection}" Visibility="{Binding ShowLuminosityLiveView, Converter={StaticResource BooleanToVisibilityConverter1}, Source={x:Static Core:ServiceProvider.Branding}}">
              <Expander Style="{StaticResource G2Expander}" Name="ExpanderLuminosity" Header="{T:Translate LabelLuminosity}" IsExpanded="{Binding ShowHistogram}" Expanded="Expander_Click">
                <Border Background="{DynamicResource G2Panel2}" CornerRadius="8" Padding="6" Margin="2,0,0,8">
                  <Grid Height="75">
                    <Polygon Stretch="Fill" Fill="{DynamicResource G2Line2}" Opacity="1" Points="{Binding LuminanceHistogramPoints}" />
                    <Polygon Stretch="Fill" Fill="#FFFF0000" Opacity="0.9" Points="{Binding RedColorHistogramPoints}" />
                    <Polygon Stretch="Fill" Fill="#FF008000" Opacity="0.7" Points="{Binding GreenColorHistogramPoints}" />
                    <Polygon Stretch="Fill" Fill="#FF0000FF" Opacity="0.5" Points="{Binding BlueColorHistogramPoints}" />
                    <CheckBox Style="{StaticResource LvCheck}" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding HighlightUnderExp}" />
                    <CheckBox Style="{StaticResource LvCheck}" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Top" IsChecked="{Binding HighlightOverExp}" />
                  </Grid>
                </Border>
              </Expander>
            </Border>

            <Border Style="{StaticResource LvSection}" Visibility="{Binding ShowControlLiveView, Converter={StaticResource BooleanToVisibilityConverter1}, Source={x:Static Core:ServiceProvider.Branding}}">
              <Expander Style="{StaticResource G2Expander}" Name="ExpanderControl" Header="{T:Translate LabelControl}" IsEnabled="{Binding IsFree}">
                <Grid Margin="2,0,0,8">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="110" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LvRowLabel}" Text="{T:Translate LabelCaptureDelay}" />
                  <Controls:NumericUpDown Grid.Row="0" Grid.Column="1" Style="{StaticResource LvNumeric}" Margin="0,3" Minimum="0" Value="{Binding CaptureDelay}" IsEnabled="{Binding IsFree}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LvRowLabel}" Text="{T:Translate LabelCaptureCount}" />
                  <Controls:NumericUpDown Grid.Row="1" Grid.Column="1" Style="{StaticResource LvNumeric}" Margin="0,3" Minimum="1" Value="{Binding CaptureCount}" IsEnabled="{Binding IsFree}" />
                  <CheckBox Style="{StaticResource LvCheck}" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="{T:Translate LabelAutoFocusBeforCapture}" IsChecked="{Binding AutoFocusBeforCapture}" />
                  <local:LiveViewControlerSimple Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="4,3" DataContext="{Binding CameraDevice}" />
                </Grid>
              </Expander>
            </Border>

            <Border Style="{StaticResource LvSection}" Visibility="{Binding ShowMotionDetectionLiveView, Converter={StaticResource BooleanToVisibilityConverter1}, Source={x:Static Core:ServiceProvider.Branding}}">
              <Expander Style="{StaticResource G2Expander}" Name="ExpanderMotionDetection" Header="{T:Translate LabelMotionDetection}" Expanded="Expander_Click">
                <Grid Margin="2,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="120" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <CheckBox Style="{StaticResource LvCheck}" Grid.ColumnSpan="2" Content="{T:Translate LabelActivateMotionDetection}" IsChecked="{Binding DetectMotion}" />
                  <CheckBox Style="{StaticResource LvCheck}" Grid.Row="1" Grid.ColumnSpan="2" Content="{T:Translate LabelAutofocusBeforeCapture}" IsChecked="{Binding MotionAutofocusBeforCapture}" IsEnabled="{Binding DetectMotion}" />
                  <ComboBox Style="{StaticResource G2ComboBox}" Grid.Row="2" Grid.Column="1" Margin="0,3" SelectedIndex="{Binding MotionAction}">
                    <ComboBoxItem Content="{T:Translate LabelDisabled}" />
                    <ComboBoxItem Content="{T:Translate LabelCapturePhoto}" />
                    <ComboBoxItem Content="{T:Translate LabelRecordVideo}" />
                  </ComboBox>
                  <CheckBox Style="{StaticResource LvCheck}" Grid.Row="3" Grid.ColumnSpan="2" Content="{T:Translate LabelDetectArea}" IsChecked="{Binding DetectMotionArea}" IsEnabled="{Binding DetectMotion}" />
                  <TextBlock Grid.Row="4" Style="{StaticResource LvRowLabel}" Text="{T:Translate LabelVideoLength}" />
                  <Controls:NumericUpDown Grid.Row="4" Grid.Column="1" Style="{StaticResource LvNumeric}" Margin="0,3" Minimum="0" Value="{Binding MotionMovieLength}" IsEnabled="{Binding DetectMotion}" />
                  <TextBlock Grid.Row="5" Style="{StaticResource LvRowLabel}" Text="{T:Translate LabelThreshold}" />
                  <Controls:NumericUpDown Grid.Row="5" Grid.Column="1" Style="{StaticResource LvNumeric}" Margin="0,3" Minimum="1" Maximum="99" Value="{Binding MotionThreshold}" IsEnabled="{Binding DetectMotion}" />
                  <TextBlock Grid.Row="6" Style="{StaticResource LvRowLabel}" Text="{T:Translate LabelWaitMoion}" />
                  <Controls:NumericUpDown Grid.Row="6" Grid.Column="1" Style="{StaticResource LvNumeric}" Margin="0,3" Minimum="0" Maximum="3600" Value="{Binding WaitForMotionSec}" IsEnabled="{Binding DetectMotion}" />
                  <TextBlock Grid.Row="7" Style="{StaticResource LvRowLabel}" Text="{T:Translate LabelCurrentMotion}" />
                  <Grid Grid.Row="7" Grid.Column="1" VerticalAlignment="Center">
                    <ProgressBar Maximum="100" Height="18" Value="{Binding CurrentMotionIndex}" Foreground="{DynamicResource G2Accent}" Background="{DynamicResource G2Panel2}" BorderThickness="0" />
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource G2Mono}" FontSize="11" Text="{Binding CurrentMotionIndex}" />
                  </Grid>
                </Grid>
              </Expander>
            </Border>

            <Border Style="{StaticResource LvSection}" Visibility="{Binding ZoomSupported, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Expander Style="{StaticResource G2Expander}" Name="ExpanderZoom" Header="{T:Translate LabelZoom}" Expanded="Expander_Click">
                <UniformGrid Columns="2" Margin="2,0,0,8">
                  <Button Name="ButtonZoomMinus" Style="{StaticResource G2GhostButton}" Height="36" Margin="0,0,4,0" PreviewMouseDown="ButtonZoomMinus_MouseDown" PreviewMouseUp="ButtonZoomMinus_MouseUp" MouseLeave="ButtonZoomMinus_MouseLeave">
                    <Viewbox Width="16" Height="16"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource LvIcoMinus}" /></Viewbox>
                  </Button>
                  <Button Name="ButtonZoomPlus" Style="{StaticResource G2GhostButton}" Height="36" Margin="4,0,0,0" PreviewMouseDown="ButtonZoomPlus_MouseDown" MouseLeave="ButtonZoomPlus_MouseLeave" PreviewMouseUp="ButtonZoomPlus_MouseUp">
                    <Viewbox Width="16" Height="16"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoPlus}" /></Viewbox>
                  </Button>
                </UniformGrid>
              </Expander>
            </Border>

            <Border Style="{StaticResource LvSection}" Visibility="Collapsed">
              <Expander Style="{StaticResource G2Expander}" Name="ExpanderSnapshot" Visibility="Collapsed" Header="{T:Translate LabelSnapshot}" Expanded="Expander_Click">
                <Grid Margin="2,0,0,8">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="110" />
                  </Grid.ColumnDefinitions>
                  <Button Grid.ColumnSpan="2" Style="{StaticResource G2GhostButton}" Margin="0,4" Content="{T:Translate LabelCaptureSnapshot}" Command="{Binding CaptureSnapshotCommand}" />
                  <TextBlock Grid.Row="1" Style="{StaticResource LvRowLabel}" Text="{T:Translate LabelCaptureCount}" />
                  <Controls:NumericUpDown Grid.Row="1" Grid.Column="1" Style="{StaticResource LvNumeric}" Margin="0,3" Minimum="0" Value="{Binding SnapshotCaptureCount}" IsEnabled="{Binding IsFree}" />
                  <TextBlock Grid.Row="2" Style="{StaticResource LvRowLabel}" Text="{T:Translate LabelCaptureDelay}" />
                  <Controls:NumericUpDown Grid.Row="2" Grid.Column="1" Style="{StaticResource LvNumeric}" Margin="0,3" Minimum="0" Value="{Binding SnapshotCaptureTime}" IsEnabled="{Binding IsFree}" />
                </Grid>
              </Expander>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- panel toggle -->
    <ToggleButton Name="PanelButton" Grid.Column="1" Style="{StaticResource G2IconToggle}" Width="22" Height="44" Margin="2,0" VerticalAlignment="Center" IsChecked="True" ToolTip="설정 패널 보이기/숨기기" Panel.ZIndex="10">
      <Viewbox Width="14" Height="14"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoPanel}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /></Viewbox>
    </ToggleButton>

    <!-- ===================== stage ===================== -->
    <Border Grid.Column="2" Margin="4,12,12,12" Background="{DynamicResource G2Stage}" CornerRadius="12" ClipToBounds="True">
      <Grid>
        <Image Name="_image" Margin="8" Stretch="Uniform" Opacity="1" RenderTransformOrigin="0.5,0.5" Source="{Binding Bitmap}" MouseDown="image1_MouseDown" MouseWheel="_image_MouseWheel">
          <UIElement.InputBindings>
            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding AutoFocusCommand}" />
          </UIElement.InputBindings>
          <FrameworkElement.LayoutTransform>
            <RotateTransform Angle="{Binding Rotation}" />
          </FrameworkElement.LayoutTransform>
        </Image>
        <local1:ZoomAndPanControl Name="zoomAndPanControl" Style="{StaticResource ZoomStyle}" ClipToBounds="True" ZoneOneVisibility="{Binding PreviewBitmapVisible, Converter={StaticResource BooleanToVisibilityConverter1}}" MouseWheel="zoomAndPanControl_MouseWheel" SizeChanged="zoomAndPanControl_SizeChanged" MouseDoubleClick="zoomAndPanControl_MouseDoubleClick">
          <Image Name="PreviewBitmap" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" Source="{Binding PreviewBitmap}" Width="{Binding ActualWidth, ElementName=_image}" Height="{Binding ActualHeight, ElementName=_image}">
            <FrameworkElement.LayoutTransform>
              <RotateTransform Angle="{Binding Rotation}" />
            </FrameworkElement.LayoutTransform>
          </Image>
        </local1:ZoomAndPanControl>
        <Border Name="LiveAestheticImageBorder" Margin="4" CornerRadius="10" IsHitTestVisible="False">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="BorderThickness" Value="4" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=IsAestheticImprovementActive}" Value="True">
                  <Setter Property="BorderBrush" Value="#FFFF8A00" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
        </Border>
        <Grid Margin="8">
          <FrameworkElement.LayoutTransform>
            <RotateTransform Angle="{Binding Rotation}" />
          </FrameworkElement.LayoutTransform>
          <Viewbox Stretch="Fill" ClipToBounds="True" Width="{Binding ActualWidth, ElementName=_image}" Height="{Binding ActualHeight, ElementName=_image}" Visibility="{Binding SettingArea, Converter={StaticResource BooleanToVisibilityConverter1}}">
            <Canvas Name="DrawingCanvas" Width="1000" Height="1000" Background="#00FFFFFF" MouseDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove" MouseUp="Canvas_MouseUp">
              <Line Name="GuideLine" Stroke="#FF00FF00" StrokeThickness="1" Visibility="{Binding IsChecked, ElementName=Drawing, Converter={StaticResource BooleanToVisibilityConverter1}}" />
              <wpf:ResizeThumb Name="StartThumb" Width="5" Height="7" Margin="1 0 0 0" Cursor="Hand" Visibility="{Binding IsChecked, ElementName=Drawing, Converter={StaticResource BooleanToVisibilityConverter1}}" DragDelta="MoveLine_DragDelta" />
              <wpf:ResizeThumb Name="EndThumb" Width="5" Height="7" Margin="-1 0 0 0" Cursor="Hand" Visibility="{Binding IsChecked, ElementName=Drawing, Converter={StaticResource BooleanToVisibilityConverter1}}" DragDelta="MoveLine_DragDelta" />
              <TextBlock Name="DistanceText" Foreground="#FFFF0000" FontWeight="Bold" Visibility="{Binding IsChecked, ElementName=Drawing, Converter={StaticResource BooleanToVisibilityConverter1}}">
                <UIElement.RenderTransform>
                  <TranslateTransform X="-20" Y="-20" />
                </UIElement.RenderTransform>
              </TextBlock>
              <ContentControl Template="{StaticResource DesignerItemTemplate}" Width="{Binding HorizontalMax, Mode=TwoWay}" Height="{Binding VerticalMax, Mode=TwoWay}" Canvas.Top="{Binding VerticalMin, Mode=TwoWay}" Canvas.Left="{Binding HorizontalMin, Mode=TwoWay}">
                <Rectangle Stroke="#FF0000FF" />
              </ContentControl>
            </Canvas>
          </Viewbox>
        </Grid>

        <!-- close the captured-photo preview -->
        <Button Style="{StaticResource G2IconButton}" Width="40" Height="40" Margin="12" Background="{DynamicResource G2Overlay}" Foreground="{DynamicResource G2Text}" HorizontalAlignment="Center" VerticalAlignment="Top" Command="{Binding ClosePreviewCommand}" Visibility="{Binding PreviewBitmapVisible, Converter={StaticResource BooleanToVisibilityConverter1}}" ToolTip="{T:Translate LabelClosePreview}">
          <Viewbox Width="18" Height="18"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoClose}" /></Viewbox>
        </Button>

        <!-- recording / sound -->
        <Border Style="{StaticResource LvFloat}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12" Padding="12,4" Visibility="{Binding Recording, Converter={StaticResource BooleanToVisibilityConverter1}}">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="10" Height="10" Fill="{DynamicResource G2Err}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="REC" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource G2Err}" VerticalAlignment="Center" />
            <TextBlock Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource G2Mono}" VerticalAlignment="Center" Text="{Binding MovieTimeRemain}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource LvFloat}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12" Visibility="{Binding HaveSoundData, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel Orientation="Horizontal">
            <StackPanel>
              <local:VUMeterControl Width="10" Height="50" Margin="2" MaxValue="100" BlockCount="14" HighLevel="13" MiddleLevel="10" Value="{Binding SoundL}" PeakValue="{Binding PeakSoundL}" />
              <TextBlock Text="L" FontSize="11" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel>
              <local:VUMeterControl Width="10" Height="50" Margin="2" MaxValue="100" BlockCount="14" HighLevel="13" MiddleLevel="10" Value="{Binding SoundR}" PeakValue="{Binding PeakSoundL}" />
              <TextBlock Text="R" FontSize="11" HorizontalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- focus bar -->
        <Border Style="{StaticResource LvFloat}" Margin="0,0,0,18" Padding="6" VerticalAlignment="Bottom" HorizontalAlignment="Center" IsEnabled="{Binding FocusingEnabled}" Visibility="{Binding ShowFocusControlLiveView, Converter={StaticResource BooleanToVisibilityConverter1}, Source={x:Static Core:ServiceProvider.Branding}}">
          <StackPanel>
            <FrameworkElement.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{T:Translate LabelCurrentLockNear}" Command="{Binding LockCurrentNearCommand}" />
                <MenuItem Header="{T:Translate LabelCurrentLockFar}" Command="{Binding LockCurrentFarCommand}" />
              </ContextMenu>
            </FrameworkElement.ContextMenu>
            <ProgressBar Height="4" Margin="4,0,4,6" Foreground="{DynamicResource G2Accent}" Background="{DynamicResource G2Panel2}" BorderThickness="0" Visibility="{Binding FocusProgressVisible, Converter={StaticResource BooleanToVisibilityConverter1}}" Value="{Binding FocusProgressValue}" Maximum="{Binding FocusProgressMax}" />
            <StackPanel Name="StackPanel" HorizontalAlignment="Center" Orientation="Horizontal">
              <ToggleButton Style="{StaticResource LvToolToggle}" IsChecked="{Binding LockA}" ToolTip="{T:Translate LabelLockNear}">
                <Viewbox Width="16" Height="16"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource LvIcoLock}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /></Viewbox>
              </ToggleButton>
              <Button Style="{StaticResource LvFocusStep}" Content="&lt;&lt;&lt;" Command="{Binding FocusMMMCommand}" ToolTip="{T:Translate LabelMoveLargeToCamera}" />
              <Button Style="{StaticResource LvFocusStep}" Content="&lt;&lt;" Command="{Binding FocusMMCommand}" ToolTip="{T:Translate LabelMoveMediumToCamera}" />
              <Button Style="{StaticResource LvFocusStep}" Content="&lt;" Command="{Binding FocusMCommand}" ToolTip="{T:Translate LabelMoveSmallToCamera}" />
              <TextBlock MinWidth="54" Margin="6,0" VerticalAlignment="Center" TextAlignment="Center" FontFamily="{StaticResource G2Mono}" FontWeight="SemiBold" Text="{Binding CounterMessage}" ToolTip="{T:Translate LabelDistantFromPoints}" />
              <Button Style="{StaticResource LvFocusStep}" Content="&gt;" Command="{Binding FocusPCommand}" ToolTip="{T:Translate LabelMoveSmallToInfinity}" />
              <Button Style="{StaticResource LvFocusStep}" Content="&gt;&gt;" Command="{Binding FocusPPCommand}" ToolTip="{T:Translate LabelMoveMediumToInfinity}" />
              <Button Style="{StaticResource LvFocusStep}" Content="&gt;&gt;&gt;" Command="{Binding FocusPPPCommand}" ToolTip="{T:Translate LabelMoveLargeToInfinity}" />
              <ToggleButton Style="{StaticResource LvToolToggle}" IsChecked="{Binding LockB}" ToolTip="{T:Translate LabelLockFar}">
                <Viewbox Width="16" Height="16"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource LvIcoLock}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /></Viewbox>
              </ToggleButton>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- view tools -->
        <Border Style="{StaticResource LvFloat}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="12" IsEnabled="{Binding FocusingEnabled}">
          <StackPanel>
            <Button Style="{StaticResource LvToolButton}" ToolTip="Reset Condition" Command="{Binding ResetConditionCommand}">
              <Viewbox Width="17" Height="17"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoRestore}" /></Viewbox>
            </Button>
            <Button Style="{StaticResource LvToolButton}" ToolTip="전체 화면" Command="{Binding FullScreenCommand}">
              <Viewbox Width="17" Height="17"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoExpand}" /></Viewbox>
            </Button>
            <Button Style="{StaticResource LvToolButton}" ToolTip="축소" Command="{Binding ZoomOutCommand}">
              <Viewbox Width="17" Height="17"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource LvIcoZoomOut}" /></Viewbox>
            </Button>
            <Button Style="{StaticResource LvToolButton}" ToolTip="확대" Command="{Binding ZoomInCommand}">
              <Viewbox Width="17" Height="17"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource LvIcoZoomIn}" /></Viewbox>
            </Button>
            <Button Style="{StaticResource LvToolButton}" Content="100" FontFamily="{StaticResource G2Mono}" FontSize="11" FontWeight="SemiBold" ToolTip="100%" Command="{Binding ZoomIn100}" />
            <Button Style="{StaticResource LvToolButton}" ToolTip="격자" Command="{Binding ToggleGridCommand}">
              <Viewbox Width="17" Height="17"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoGrid}" /></Viewbox>
            </Button>
            <ToggleButton Style="{StaticResource LvToolToggle}" IsChecked="{Binding FreezeImage}" ToolTip="{T:Translate ButtonFreezeImage}">
              <Viewbox Width="17" Height="17"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoPause}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /></Viewbox>
            </ToggleButton>
            <ToggleButton Style="{StaticResource LvToolToggle}" IsChecked="{Binding EdgeDetection}" ToolTip="{T:Translate LabelEdgeDetection}">
              <Viewbox Width="17" Height="17"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource LvIcoEdge}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /></Viewbox>
            </ToggleButton>
            <Canvas Width="36" Height="36" Margin="2" RenderTransformOrigin="0.5,0.5" ToolTip="{Binding LevelAngle}" Visibility="{Binding ShowLevelLiveView, Converter={StaticResource BooleanToVisibilityConverter1}, Source={x:Static Core:ServiceProvider.Branding}}">
              <Path Name="Cutter" Width="26" Height="26" RenderTransformOrigin="0.5,0.5" Canvas.Left="5" Canvas.Top="5" Stretch="Fill" Data="F1 M56,36 L56,40 L40,40 L40,56 L36,56 L36,40 L20,40 L20,36 L36,36 L36,20 L40,20 L40,36 L56,36 M8,37 L8,39 L3.01401,39 L3,38 L3.01401,37 L8,37 M13,37 L13,39 L10,39 L10,37 L13,37 M18,37 L18,39 L15,39 L15,37 L18,37 M39,8.00005 L37,8.00005 L37,3.01403 L38,3.00002 L39,3.01403 L39,8.00005 M39,18.0001 L37,18.0001 L37,15.0001 L39,15.0001 L39,18.0001 M37,10.0001 L39,10.0001 L39,13.0001 L37,13.0001 L37,10.0001 M68,39 L68,37 L72.986,37 L73,38 L72.986,39 L68,39 M63,39 L63,37 L66,37 L66,39 L63,39 M57.9999,39 L57.9999,37 L61,37 L61,39 L57.9999,39 M37,68 L39,68 L39,72.986 L38,73 L37,72.986 L37,68 M37,63 L39,63 L39,66 L37,66 L37,63 M37,58 L39,58 L39,61 L37,61 L37,58" Fill="{Binding LevelAngleColor}">
                <UIElement.RenderTransform>
                  <RotateTransform Angle="{Binding LevelAngle}" />
                </UIElement.RenderTransform>
              </Path>
              <Path Width="36" Height="36" Stretch="Uniform" Fill="{DynamicResource G2Sub}" Data="F1 M66.6667,1.52588E-05 C29.907,1.52588E-05 0,29.907 0,66.6667 C0,103.425 29.907,133.333 66.6667,133.333 C103.427,133.333 133.333,103.425 133.333,66.6667 C133.333,29.907 103.427,1.52588E-05 66.6667,1.52588E-05 M72.0429,122.315 L72.0429,104.302 L61.2904,104.302 L61.2904,122.318 C34.7428,119.772 13.5612,98.5912 11.0176,72.043 L29.0332,72.043 L29.0332,61.2904 L11.0176,61.2904 C13.5625,34.7428 34.7428,13.5625 61.2904,11.0176 L61.2904,29.0319 L72.0429,29.0319 L72.0429,11.0176 C98.5912,13.5612 119.772,34.7416 122.315,61.2904 L104.302,61.2904 L104.302,72.043 L122.318,72.043 C119.772,98.5912 98.5912,119.772 72.0429,122.315" />
            </Canvas>
            <Border Style="{StaticResource G2Divider}" Margin="4,4" />
            <TextBlock HorizontalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource G2Sub}" Text="F/s" />
            <TextBlock HorizontalAlignment="Center" Margin="0,0,0,4" FontFamily="{StaticResource G2Mono}" FontSize="12" FontWeight="SemiBold" Text="{Binding Fps}" />
          </StackPanel>
        </Border>

        <!-- waiting for the camera -->
        <Border Style="{StaticResource G2Card}" Width="300" Padding="16,14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding DelayedStart, ConverterParameter=false, Converter={StaticResource BooleanToVisibilityConverter1}}">
          <StackPanel Name="grid_wait">
            <ProgressBar IsIndeterminate="True" Height="4" Foreground="{DynamicResource G2Accent}" Background="{DynamicResource G2Panel2}" BorderThickness="0" />
            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" Text="{T:Translate LabelWaitingForDevice}" />
          </StackPanel>
        </Border>

        <Ellipse Width="190" Height="190" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8" RenderTransformOrigin="0.5,0.5" StrokeThickness="15" StrokeDashArray="4 1" Visibility="{Binding CountDownVisible, ConverterParameter=false, Converter={StaticResource BooleanToVisibilityConverter1}}">
          <Shape.Stroke>
            <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
              <GradientStop Color="Blue" />
              <GradientStop Color="Red" Offset="0.5" />
              <GradientStop Color="Green" Offset="1" />
            </LinearGradientBrush>
          </Shape.Stroke>
          <UIElement.RenderTransform>
            <RotateTransform />
          </UIElement.RenderTransform>
          <FrameworkElement.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="-360" Duration="0:0:2" RepeatBehavior="Forever" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </FrameworkElement.Triggers>
        </Ellipse>
        <TextBlock FontSize="155" FontWeight="Bold" Foreground="#AAFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding CountDown}" Visibility="{Binding CountDownVisible, ConverterParameter=false, Converter={StaticResource BooleanToVisibilityConverter1}}" />
      </Grid>
    </Border>

    <materialDesign:Snackbar Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Bottom" IsActive="{Binding Source={x:Static Devices:StaticHelper.Instance}, Path=IsActive}">
      <materialDesign:SnackbarMessage Content="{Binding Source={x:Static Devices:StaticHelper.Instance}, Path=SystemMessage}" />
    </materialDesign:Snackbar>
  </Grid>
</Window>
