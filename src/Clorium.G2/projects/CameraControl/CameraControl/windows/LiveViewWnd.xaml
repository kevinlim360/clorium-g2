          </materialDesign:Card>
          <materialDesign:Card Margin="4">
            <Expander Name="ExpanderCalibration" Header="{T:Translate LabelCalibration}" Expanded="Expander_Click">
              <Grid Margin="4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <CheckBox Name="Centering" Grid.Row="0" HorizontalContentAlignment="Center" Margin="0,0,0,5" HorizontalAlignment="Left" Content="{T:Translate LableMeasureCenter}" Checked="CheckedCentering_Click" Unchecked="UncheckedCentering_Click" />
                <CheckBox Name="Tilting" Grid.Row="1" HorizontalContentAlignment="Center" Margin="0,0,0,5" HorizontalAlignment="Left" Content="{T:Translate LableMeasureTilt}" Checked="CheckedTilting_Click" Unchecked="UncheckedTilting_Click" />
                <CheckBox Name="Drawing" Grid.Row="2" HorizontalContentAlignment="Center" Margin="0,0,0,5" HorizontalAlignment="Left" Content="{T:Translate LableMeasureLine}" Checked="CheckedDrawing_Click" Unchecked="UncheckedDrawing_Click" />
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,5">
                  <Label Margin="0,4,0,0" Content="{T:Translate LabelReference}" />
                  <TextBox Margin="5,0,0,4" Width="50" HorizontalContentAlignment="Center" VerticalContentAlignment="Bottom" Text="{Binding CalibrateBase}" />
                  <Label Content="[mm]" VerticalContentAlignment="Center" />
                  <Button Margin="3,0,0,0" Width="80" FontSize="12" Padding="0" Content="{T:Translate LabelScale}" Command="{Binding CalibrateCommand}" />
                </StackPanel>
                <TextBox Grid.Row="4" IsReadOnly="True" Foreground="#FF808080" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=MetaScale}" materialDesign:HintAssist.Hint="{T:Translate LabelScaleValue}" />
                <StackPanel Name="BoxSize" Grid.Row="5" Orientation="Horizontal" Margin="0,4,0,5" Visibility="Collapsed">
                  <Label Margin="0,4,0,0" Foreground="#FF808080" Content="{T:Translate LabelBoxSize}" />
                  <TextBox Margin="5,0,0,4" Width="50" HorizontalContentAlignment="Center" IsReadOnly="True" Foreground="#FF808080" Text="{Binding BoxWidth_mm}" />
                  <Label Content="x" VerticalContentAlignment="Center" />
                  <TextBox Margin="0,0,4,4" Width="50" HorizontalContentAlignment="Center" IsReadOnly="True" Foreground="#FF808080" Text="{Binding BoxHeight_mm}" />
                  <Label Content="[mm]" VerticalContentAlignment="Center" Foreground="#FF808080" />
                </StackPanel>
                <StackPanel Name="Result_Center" Grid.Row="6" Orientation="Horizontal" Margin="0,5,0,5" Visibility="Collapsed">
                  <TextBlock Foreground="#FFFF0000" Text="{Binding Center_Disp}" />
                </StackPanel>
                <StackPanel Name="Result_Tilt" Grid.Row="7" Orientation="Vertical" Margin="0,5,0,5" Visibility="Collapsed">
                  <TextBlock Foreground="#FFFF0000" Text="{Binding Tilt_Deg}" />
                  <TextBlock Foreground="#FFFFFF00" Text="{Binding Direction_Deg}" />
                  <TextBlock Foreground="#FF808080" Text="{Binding Scale_mm}" />
                </StackPanel>
              </Grid>
            </Expander>
          </materialDesign:Card>
          <materialDesign:Card Margin="4" Visibility="{Binding ShowLuminosityLiveView, Converter={StaticResource BooleanToVisibilityConverter1}, Source={x:Static Core:ServiceProvider.Branding}}">
            <Expander Name="ExpanderLuminosity" Header="{T:Translate LabelLuminosity}" IsExpanded="{Binding ShowHistogram}" Expanded="Expander_Click">
              <Grid Height="75" Margin="4">
                <Polygon Stretch="Fill" Fill="#FFD3D3D3" Opacity="1" Points="{Binding LuminanceHistogramPoints}" />
                <Polygon Stretch="Fill" Fill="#FFFF0000" Opacity="0.9" Points="{Binding RedColorHistogramPoints}" />
                <Polygon Stretch="Fill" Fill="#FF008000" Opacity="0.7" Points="{Binding GreenColorHistogramPoints}" />
                <Polygon Stretch="Fill" Fill="#FF0000FF" Opacity="0.5" Points="{Binding BlueColorHistogramPoints}" />
                <CheckBox HorizontalAlignment="Left" VerticalAlignment="Top" Width="18" IsChecked="{Binding HighlightUnderExp}" />
                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Top" Width="18" IsChecked="{Binding HighlightOverExp}" />
              </Grid>
            </Expander>
          </materialDesign:Card>
          <materialDesign:Card Margin="4" Visibility="{Binding ShowControlLiveView, Converter={StaticResource BooleanToVisibilityConverter1}, Source={x:Static Core:ServiceProvider.Branding}}">
            <Expander Name="ExpanderControl" Header="{T:Translate LabelControl}" IsEnabled="{Binding IsFree}">
              <Grid Margin="4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Margin="3" Content="{T:Translate LabelCaptureDelay}" />
                <Controls:NumericUpDown Grid.Row="0" Grid.Column="1" Margin="3" Minimum="0" Value="{Binding CaptureDelay}" IsEnabled="{Binding IsFree}" />
                <Label Grid.Row="1" Grid.Column="0" Margin="3" Content="{T:Translate LabelCaptureCount}" />
                <Controls:NumericUpDown Grid.Row="1" Grid.Column="1" Margin="3" Minimum="1" Value="{Binding CaptureCount}" IsEnabled="{Binding IsFree}" />
                <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="3" Content="{T:Translate LabelAutoFocusBeforCapture}" IsChecked="{Binding AutoFocusBeforCapture}" />
                <local:LiveViewControlerSimple Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="20,3" DataContext="{Binding CameraDevice}" />
              </Grid>
            </Expander>
          </materialDesign:Card>
          <materialDesign:Card Margin="4" Visibility="Collapsed">
            <Expander Name="ExpanderFocusStackingAdvanced" Header="{T:Translate LabelFocusStackingAdvanced}" Expanded="ShowFocusControl_Click" Collapsed="HideFocusControl_Click">
              <Grid Margin="4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="{T:Translate LabelNoOfPhots}" />
                <Controls:NumericUpDown Grid.Row="0" Grid.Column="1" Margin="2" Minimum="1" IsEnabled="{Binding IsFree}" Value="{Binding PhotoNo}" />
                <Label Grid.Row="1" Grid.Column="0" Content="{T:Translate LabelFocusStep}" />
                <Controls:NumericUpDown Grid.Row="1" Grid.Column="1" Margin="2" Minimum="1" IsEnabled="{Binding IsFree}" Value="{Binding FocusStep}" />
                <Button Grid.Row="3" Grid.Column="0" Margin="5" Content="{T:Translate ButtonStart}" IsEnabled="{Binding IsFree}" Command="{Binding StartFocusStackingCommand}" />
                <Button Grid.Row="3" Grid.Column="1" Margin="5" Content="{T:Translate ButtonPreview}" IsEnabled="{Binding IsFree}" Command="{Binding PreviewFocusStackingCommand}" />
                <Button Grid.Row="4" Grid.Column="1" Margin="5" Content="{T:Translate ButtonStop}" IsEnabled="{Binding IsFocusStackingRunning}" Command="{Binding StopFocusStackingCommand}" />
                <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center">
                  <Label Content="Count" />
                  <Label Margin="5,0,15,0" Content="{Binding PhotoCount}" />
                  <Label Content="Auto" />
                  <CheckBox ToolTip="Generate Image" HorizontalAlignment="Right" IsChecked="{Binding AutoFocusStackingImage}" />
                </StackPanel>
                <ProgressBar Grid.Row="4" Grid.Column="0" Margin="5" VerticalAlignment="Bottom" Value="{Binding FocusStackingTick}" Maximum="{Binding WaitTime}" />
              </Grid>
            </Expander>
          </materialDesign:Card>
          <materialDesign:Card Margin="4" Visibility="Collapsed">
            <Expander Name="ExpanderFocusStackingSimple" Header="{T:Translate LabelFocusStackingSimple}" Expanded="ShowFocusControl_Click" Collapsed="HideFocusControl_Click">
              <Grid Margin="4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="{T:Translate LabelNoOfPhots}" />
                <Controls:NumericUpDown Grid.Row="0" Grid.Column="1" Margin="2" Minimum="1" Value="{Binding PhotoNumber}" IsEnabled="{Binding IsFree}" />
                <Label Grid.Row="1" Grid.Column="0" Content="{T:Translate LabelDirection}" />
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="2" SelectedIndex="{Binding Direction}" IsEnabled="{Binding IsFree}">
                  <ComboBoxItem Content="{T:Translate LabelFarNear}" />
                  <ComboBoxItem Content="{T:Translate LabelNearFar}" />
                </ComboBox>
                <Label Grid.Row="2" Grid.Column="0" Content="{T:Translate LabelFocusStep}" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="2" SelectedIndex="{Binding FocusStepSize}" IsEnabled="{Binding IsFree}">
                  <ComboBoxItem Content="{T:Translate LabelStepSmall}" />
                  <ComboBoxItem Content="{T:Translate LabelStepMedium}" />
                  <ComboBoxItem Content="{T:Translate LabelStepLarge}" />
                </ComboBox>
                <Button Grid.Row="4" Grid.Column="0" Margin="5" Content="{T:Translate ButtonStart}" IsEnabled="{Binding IsFree}" Command="{Binding StartSimpleFocusStackingCommand}" />
                <Button Grid.Row="4" Grid.Column="1" Margin="5" Content="{T:Translate ButtonPreview}" IsEnabled="{Binding IsFree}" Command="{Binding PreviewSimpleFocusStackingCommand}" />
                <Button Grid.Row="5" Grid.Column="1" Margin="5" Content="{T:Translate ButtonStop}" IsEnabled="{Binding IsFocusStackingRunning}" Command="{Binding StopSimpleFocusStackingCommand}" />
                <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center">
                  <Label Content="Count" />
                  <Label Margin="5,0,15,0" Content="{Binding PhotoCount}" />
                  <Label Content="Auto" />
                  <CheckBox ToolTip="Generate Image" HorizontalAlignment="Right" IsChecked="{Binding AutoFocusStackingImage}" />
                </StackPanel>
                <ProgressBar Grid.Row="5" Grid.Column="0" Margin="5" VerticalAlignment="Bottom" Value="{Binding FocusStackingTick}" Maximum="{Binding WaitTime}" />
              </Grid>
            </Expander>
          </materialDesign:Card>
          <materialDesign:Card Margin="4" Visibility="{Binding ShowMotionDetectionLiveView, Converter={StaticResource BooleanToVisibilityConverter1}, Source={x:Static Core:ServiceProvider.Branding}}">
            <Expander Name="ExpanderMotionDetection" Header="{T:Translate LabelMotionDetection}" Expanded="Expander_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="5" />
                  <ColumnDefinition Width="88*" />
                  <ColumnDefinition Width="5" />
                  <ColumnDefinition Width="90*" />
                  <ColumnDefinition Width="5" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <CheckBox Grid.Column="1" Grid.ColumnSpan="3" Margin="3" VerticalAlignment="Center" Content="{T:Translate LabelActivateMotionDetection}" IsChecked="{Binding DetectMotion}" />
                <ComboBox Grid.Column="3" Grid.Row="2" SelectedIndex="{Binding MotionAction}">
                  <ComboBoxItem Content="{T:Translate LabelDisabled}" />
                  <ComboBoxItem Content="{T:Translate LabelCapturePhoto}" />
                  <ComboBoxItem Content="{T:Translate LabelRecordVideo}" />
                </ComboBox>
                <CheckBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="3" VerticalAlignment="Center" Content="{T:Translate LabelAutofocusBeforeCapture}" IsChecked="{Binding MotionAutofocusBeforCapture}" IsEnabled="{Binding DetectMotion}" />
                <CheckBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="3" VerticalAlignment="Center" Content="{T:Translate LabelDetectArea}" IsChecked="{Binding DetectMotionArea}" IsEnabled="{Binding DetectMotion}" />
                <Label Grid.Row="4" Grid.Column="1" Margin="3" Content="{T:Translate LabelVideoLength}" />
                <Controls:NumericUpDown Grid.Row="4" Grid.Column="3" Margin="3" Minimum="0" Value="{Binding MotionMovieLength}" IsEnabled="{Binding DetectMotion}" />
                <Label Grid.Row="5" Grid.Column="1" Content="{T:Translate LabelThreshold}" />
                <Controls:NumericUpDown Grid.Row="5" Grid.Column="3" Margin="3" Minimum="1" Maximum="99" Value="{Binding MotionThreshold}" IsEnabled="{Binding DetectMotion}" />
                <Label Grid.Row="6" Grid.Column="1" Content="{T:Translate LabelWaitMoion}" />
                <Controls:NumericUpDown Grid.Row="6" Grid.Column="3" Margin="3" Minimum="0" Maximum="3600" Value="{Binding WaitForMotionSec}" IsEnabled="{Binding DetectMotion}" />
                <Label Grid.Row="7" Grid.Column="1" Content="{T:Translate LabelCurrentMotion}" />
                <ProgressBar Grid.Row="7" Grid.Column="3" Maximum="100" Height="18" Value="{Binding CurrentMotionIndex}" />
                <Label Grid.Row="7" Grid.Column="3" HorizontalAlignment="Center" Content="{Binding CurrentMotionIndex}" />
              </Grid>
            </Expander>
          </materialDesign:Card>
          <materialDesign:Card Margin="4" Visibility="{Binding ZoomSupported, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Expander Name="ExpanderZoom" Header="{T:Translate LabelZoom}" Expanded="Expander_Click">
              <Grid Margin="4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Name="ButtonZoomMinus" Height="40" Width="40" Margin="4" Style="{DynamicResource MaterialDesignFloatingActionLightButton}" HorizontalAlignment="Center" PreviewMouseDown="ButtonZoomMinus_MouseDown" PreviewMouseUp="ButtonZoomMinus_MouseUp" MouseLeave="ButtonZoomMinus_MouseLeave">
                  <materialDesign:PackIcon Kind="MinusBox" Width="20" Height="20" />
                </Button>
                <Button Name="ButtonZoomPlus" Grid.Column="1" Height="40" Width="40" Margin="4" Style="{DynamicResource MaterialDesignFloatingActionLightButton}" HorizontalAlignment="Center" PreviewMouseDown="ButtonZoomPlus_MouseDown" MouseLeave="ButtonZoomPlus_MouseLeave" PreviewMouseUp="ButtonZoomPlus_MouseUp">
                  <materialDesign:PackIcon Kind="PlusBox" Width="20" Height="20" />
                </Button>
              </Grid>
            </Expander>
          </materialDesign:Card>
          <materialDesign:Card Margin="4">
            <Expander Name="ExpanderSnapshot" Visibility="Collapsed" Header="{T:Translate LabelSnapshot}" Expanded="Expander_Click">
              <Grid Margin="4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="7*" />
                  <ColumnDefinition Width="11*" />
                  <ColumnDefinition Width="18*" />
                </Grid.ColumnDefinitions>
                <Button Grid.ColumnSpan="3" Margin="5,5,5,5" Content="{T:Translate LabelCaptureSnapshot}" Command="{Binding CaptureSnapshotCommand}" />
