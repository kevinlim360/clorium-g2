                  <ComboBoxItem Content="{T:Translate LabelRotate270}" />
                </ComboBox>
                <Label Grid.Row="2" Grid.Column="1" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Content="{T:Translate LabelGridColor}" />
