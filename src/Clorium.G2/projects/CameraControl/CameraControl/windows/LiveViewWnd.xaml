                <CheckBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="2" Content="{T:Translate LabelFlip}" IsChecked="{Binding FlipImage}" />
                <CheckBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="2" Content="{T:Translate LabelShowFocusRect}" IsChecked="{Binding ShowFocusRect}" />
