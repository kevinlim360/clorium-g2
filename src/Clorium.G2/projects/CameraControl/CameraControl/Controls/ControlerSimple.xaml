<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="CameraControl.Controls.ControlerSimple" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:my="clr-namespace:CameraControl.Controls" xmlns:T="clr-namespace:CameraControl.Core.Translation;assembly=CameraControl.Core" xmlns:Classes="clr-namespace:CameraControl.Classes" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ComboBox.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter1" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Margin="4">
    <StackPanel Orientation="Vertical">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Visibility="{Binding Path=IsBusy, Converter={StaticResource BooleanToVisibilityConverter1}, ConverterParameter=false}">
        <Rectangle Fill="#FF808080" Width="10" Height="10" />
        <ProgressBar Width="100" Margin="2" Value="{Binding Path=TransferProgress}" Style="{x:Null}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <CheckBox Padding="0" IsChecked="{Binding Path=IsChecked}" Content="{Binding Path=DisplayName}" ToolTip="{Binding Path=DisplayName}" />
      </StackPanel>
    </StackPanel>
    <my:ExposureStatusControl ExposureStatus="{Binding Path=ExposureStatus, Mode=TwoWay}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
      <Button Name="btn_capture" Height="35" Width="35" Style="{StaticResource MaterialDesignFloatingActionLightButton}" ToolTip="{T:Translate CapturePhotoToolTip}" IsEnabled="{Binding IsConnected}" Click="btn_capture_Click">
        <materialDesign:PackIcon Kind="CameraIris" Height="30" Width="30" />
      </Button>
      <Button Height="35" Width="35" Margin="4" Style="{StaticResource MaterialDesignFloatingActionLightButton}" Command="{Binding Source={x:Static Classes:WpfCommands.DevicePropertyCommand}}" CommandParameter="{Binding}">
        <ContentControl.Content>
          <materialDesign:PackIcon Kind="Settings" Height="30" Width="30" />
        </ContentControl.Content>
      </Button>
      <Button Height="35" Width="35" Margin="4" Style="{StaticResource MaterialDesignFloatingActionLightButton}" Command="{Binding Source={x:Static Classes:WpfCommands.ShowLiveViewCommand}}" CommandParameter="{Binding}">
        <ContentControl.Content>
          <materialDesign:PackIcon Kind="MovieOpenOutline" Height="30" Width="30" />
        </ContentControl.Content>
      </Button>
    </StackPanel>
    <StackPanel>
      <Border BorderThickness="1" BorderBrush="{Binding Path=Mode.ErrorColor}">
        <ComboBox Name="cmb_mode" Style="{StaticResource MaterialDesignFloatingHintComboBox}" IsEnabled="{Binding Path=Mode.IsEnabled}" ItemsSource="{Binding Path=Mode.Values}" SelectedValue="{Binding Path=Mode.Value}" materialDesign:HintAssist.Hint="{T:Translate Mode}" />
      </Border>
    </StackPanel>
    <StackPanel>
      <Border BorderThickness="1" BorderBrush="{Binding Path=IsoNumber.ErrorColor}">
        <ComboBox Style="{StaticResource MaterialDesignFloatingHintComboBox}" IsEnabled="{Binding Path=IsoNumber.IsEnabled}" ItemsSource="{Binding Path=IsoNumber.Values}" SelectedValue="{Binding Path=IsoNumber.Value}" materialDesign:HintAssist.Hint="{T:Translate Iso}" />
      </Border>
    </StackPanel>
    <StackPanel Margin="2,0">
      <Border BorderThickness="1" BorderBrush="{Binding Path=ShutterSpeed.ErrorColor}">
        <ComboBox Style="{StaticResource MaterialDesignFloatingHintComboBox}" IsEnabled="{Binding Path=ShutterSpeed.IsEnabled}" ItemsSource="{Binding Path=ShutterSpeed.Values}" SelectedValue="{Binding Path=ShutterSpeed.Value}" materialDesign:HintAssist.Hint="{T:Translate ShutterSpeed}" />
      </Border>
    </StackPanel>
    <StackPanel>
      <Border BorderThickness="1" BorderBrush="{Binding Path=FNumber.ErrorColor}">
        <ComboBox Style="{StaticResource MaterialDesignFloatingHintComboBox}" IsEnabled="{Binding Path=FNumber.IsEnabled}" ItemsSource="{Binding Path=FNumber.Values}" SelectedValue="{Binding Path=FNumber.Value}" materialDesign:HintAssist.Hint="{T:Translate Aperture}" />
      </Border>
    </StackPanel>
    <StackPanel>
      <Border BorderThickness="1" BorderBrush="{Binding Path=WhiteBalance.ErrorColor}">
        <ComboBox Style="{StaticResource MaterialDesignFloatingHintComboBox}" IsEnabled="{Binding Path=WhiteBalance.IsEnabled}" ItemsSource="{Binding Path=WhiteBalance.Values}" SelectedValue="{Binding Path=WhiteBalance.Value}" materialDesign:HintAssist.Hint="{T:Translate WhiteBalance}" />
      </Border>
    </StackPanel>
    <StackPanel>
      <Border BorderThickness="1" BorderBrush="{Binding Path=ExposureCompensation.ErrorColor}">
        <ComboBox Style="{StaticResource MaterialDesignFloatingHintComboBox}" IsEnabled="{Binding Path=ExposureCompensation.IsEnabled}" ItemsSource="{Binding Path=ExposureCompensation.Values}" SelectedValue="{Binding Path=ExposureCompensation.Value}" materialDesign:HintAssist.Hint="{T:Translate ExposureComp}" />
      </Border>
    </StackPanel>
    <StackPanel>
      <Border BorderThickness="1" BorderBrush="{Binding Path=FocusMode.ErrorColor}">
        <ComboBox Name="cmb_focus" Style="{StaticResource MaterialDesignFloatingHintComboBox}" IsEnabled="{Binding Path=FocusMode.IsEnabled}" ItemsSource="{Binding Path=FocusMode.Values}" SelectedValue="{Binding Path=FocusMode.Value}" materialDesign:HintAssist.Hint="{T:Translate FocusMode}" />
      </Border>
    </StackPanel>
    <Label Margin="-8 0 0 0" Content="{T:Translate Battery}" />
    <ProgressBar Minimum="0" Maximum="100" Height="20" Value="{Binding Path=Battery}" ToolTip="{Binding Path=Battery}" />
  </StackPanel>
</UserControl>