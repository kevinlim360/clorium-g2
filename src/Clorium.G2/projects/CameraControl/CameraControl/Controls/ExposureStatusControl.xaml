<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="CameraControl.Controls.ExposureStatusControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:CameraControl.Controls;assembly=CameraControl">
  <Grid SnapsToDevicePixels="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="14" />
      <RowDefinition Height="5" />
      <RowDefinition Height="8" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFD1D1D1">0</TextBlock>
    <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FFD1D1D1" FontSize="16" TextAlignment="Right">+</TextBlock>
    <TextBlock Grid.Row="1" Grid.Column="14" FontWeight="Black" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#FFD1D1D1" FontSize="20" TextAlignment="Left">-</TextBlock>
    <Rectangle Grid.Row="2" Grid.Column="1" Fill="#FFD1D1D1" Margin="1" />
    <Rectangle Grid.Row="2" Grid.Column="4" Fill="#FFD1D1D1" Margin="1" />
    <Rectangle Grid.Row="2" Grid.Column="10" Fill="#FFD1D1D1" Margin="1" />
    <Rectangle Grid.Row="2" Grid.Column="13" Fill="#FFD1D1D1" Margin="1" />
    <Polygon Name="PosMax" Grid.Row="3" Grid.Column="0" Fill="#FFD1D1D1" Margin="1" Points="3,3 6,0 10,0 10,6 6,6" HorizontalAlignment="Right" VerticalAlignment="Center" SnapsToDevicePixels="True" />
    <Rectangle Name="Pos6" Grid.Row="3" Grid.Column="1" Fill="#FFD1D1D1" Margin="1" />
    <Rectangle Name="Pos5" Grid.Row="3" Grid.Column="2" Fill="#FFD1D1D1" Margin="1" />
    <Rectangle Name="Pos4" Grid.Row="3" Grid.Column="3" Fill="#FFD1D1D1" Margin="1" />
    <Rectangle Name="Pos3" Grid.Row="3" Grid.Column="4" Fill="#FFD1D1D1" Margin="1" />
    <Rectangle Name="Pos2" Grid.Row="3" Grid.Column="5" Fill="#FFD1D1D1" Margin="1" />
    <Rectangle Name="Pos1" Grid.Row="3" Grid.Column="6" Fill="#FFD1D1D1" Margin="1" />
    <Rectangle Grid.Row="2" Grid.Column="7" Grid.RowSpan="2" Fill="#FFD1D1D1" Margin="1" />
    <Rectangle Name="Neg1" Grid.Row="3" Grid.Column="8" Fill="#FFD1D1D1" Margin="1" />
    <Rectangle Name="Neg2" Grid.Row="3" Grid.Column="9" Fill="#FFD1D1D1" Margin="1" />
    <Rectangle Name="Neg3" Grid.Row="3" Grid.Column="10" Fill="#FFD1D1D1" Margin="1" />
    <Rectangle Name="Neg4" Grid.Row="3" Grid.Column="11" Fill="#FFD1D1D1" Margin="1" />
    <Rectangle Name="Neg5" Grid.Row="3" Grid.Column="12" Fill="#FFD1D1D1" Margin="1" />
    <Rectangle Name="Neg6" Grid.Row="3" Grid.Column="13" Fill="#FFD1D1D1" Margin="1" />
    <Polygon Name="NegMax" Grid.Row="3" Grid.Column="14" Fill="#FFD1D1D1" Margin="1" Points="0,0 4,0 7,3 4,6 0,6" VerticalAlignment="Center" SnapsToDevicePixels="True" />
  </Grid>
</UserControl>