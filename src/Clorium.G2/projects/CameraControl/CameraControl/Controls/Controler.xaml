<?xml version="1.0" encoding="utf-8"?>
<!-- Clorium G2 · camera settings, drawn fresh: label + value rows. Names and handlers used by code-behind are unchanged. -->
<UserControl x:Class="CameraControl.Controls.Controler" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:my="clr-namespace:CameraControl.Controls" xmlns:T="clr-namespace:CameraControl.Core.Translation;assembly=CameraControl.Core" xmlns:Core="clr-namespace:CameraControl.Core;assembly=CameraControl.Core" mc:Ignorable="d" BorderThickness="0">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/CameraControl;component/styles/g2theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <T:TranslateConverter x:Key="converter" />
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <DataTemplate x:Key="G2Translated">
        <TextBlock Text="{Binding Converter={StaticResource converter}}" />
      </DataTemplate>
      <Style x:Key="G2RowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource G2Fs11_5}" />
        <Setter Property="Foreground" Value="{DynamicResource G2Sub}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,0,8,0" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel TextElement.FontFamily="{StaticResource G2Font}" TextElement.Foreground="{DynamicResource G2Text}">
    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="78" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Style="{StaticResource G2RowLabel}" Text="카메라" />
      <ComboBox Grid.Column="1" FontFamily="{StaticResource G2Font}" IsSynchronizedWithCurrentItem="True" DisplayMemberPath="DisplayName" ItemsSource="{Binding ConnectedDevices, Source={x:Static Core:ServiceProvider.DeviceManager}}" SelectedItem="{Binding SelectedCameraDevice, Source={x:Static Core:ServiceProvider.DeviceManager}}" />
    </Grid>
    <StackPanel Name="wrapPanel1">
          <Grid Margin="0,0,0,6" Visibility="{Binding SelectedCameraDevice.Mode.Available, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="78" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource G2RowLabel}" Text="{T:Translate Mode}" />
            <ComboBox Grid.Column="1" Name="cmb_mode" BorderBrush="{Binding Path=SelectedCameraDevice.Mode.ErrorColor}" IsEnabled="{Binding Path=SelectedCameraDevice.Mode.IsEnabled}" ItemsSource="{Binding Path=SelectedCameraDevice.Mode.Values}" SelectedValue="{Binding Path=SelectedCameraDevice.Mode.Value}" />
          </Grid>
          <Grid Margin="0,0,0,6" Visibility="{Binding SelectedCameraDevice.IsoNumber.Available, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="78" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource G2RowLabel}" Text="{T:Translate Iso}" />
            <ComboBox Grid.Column="1" Name="cmb_iso" BorderBrush="{Binding Path=SelectedCameraDevice.IsoNumber.ErrorColor}" IsEnabled="{Binding Path=SelectedCameraDevice.IsoNumber.IsEnabled}" ItemsSource="{Binding Path=SelectedCameraDevice.IsoNumber.Values}" SelectedValue="{Binding Path=SelectedCameraDevice.IsoNumber.Value}" GotFocus="cmb_shutter_GotFocus" />
          </Grid>
          <Grid Margin="0,0,0,6" Visibility="{Binding SelectedCameraDevice.ShutterSpeed.Available, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="78" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource G2RowLabel}" Text="{T:Translate ShutterSpeed}" />
            <ComboBox Grid.Column="1" Name="cmb_shutter" BorderBrush="{Binding Path=SelectedCameraDevice.ShutterSpeed.ErrorColor}" IsEnabled="{Binding Path=SelectedCameraDevice.ShutterSpeed.IsEnabled}" ItemsSource="{Binding Path=SelectedCameraDevice.ShutterSpeed.Values}" SelectedValue="{Binding Path=SelectedCameraDevice.ShutterSpeed.Value}" GotFocus="cmb_shutter_GotFocus" />
          </Grid>
          <Grid Margin="0,0,0,6" Visibility="{Binding SelectedCameraDevice.FNumber.Available, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="78" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource G2RowLabel}" Text="{T:Translate Aperture}" />
            <ComboBox Grid.Column="1" Name="cmb_aperture" BorderBrush="{Binding Path=SelectedCameraDevice.FNumber.ErrorColor}" IsEnabled="{Binding Path=SelectedCameraDevice.FNumber.IsEnabled}" ItemsSource="{Binding Path=SelectedCameraDevice.FNumber.Values}" SelectedValue="{Binding Path=SelectedCameraDevice.FNumber.Value}" GotFocus="cmb_shutter_GotFocus" />
          </Grid>
          <Grid Margin="0,0,0,6" Visibility="{Binding SelectedCameraDevice.ColorTemperature.Available, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="78" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource G2RowLabel}" Text="{T:Translate ColorTemperature}" />
            <ComboBox Grid.Column="1" Name="cmb_colortemperature" BorderBrush="{Binding Path=SelectedCameraDevice.ColorTemperature.ErrorColor}" IsEnabled="{Binding Path=SelectedCameraDevice.ColorTemperature.IsEnabled}" ItemsSource="{Binding Path=SelectedCameraDevice.ColorTemperature.Values}" SelectedValue="{Binding Path=SelectedCameraDevice.ColorTemperature.Value}" ItemTemplate="{StaticResource G2Translated}" GotFocus="cmb_shutter_GotFocus" />
          </Grid>
          <Grid Margin="0,0,0,6" Visibility="{Binding SelectedCameraDevice.WhiteBalance.Available, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="78" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource G2RowLabel}" Text="{T:Translate WhiteBalance}" />
            <ComboBox Grid.Column="1" Name="cmb_WB" BorderBrush="{Binding Path=SelectedCameraDevice.WhiteBalance.ErrorColor}" IsEnabled="{Binding Path=SelectedCameraDevice.WhiteBalance.IsEnabled}" ItemsSource="{Binding Path=SelectedCameraDevice.WhiteBalance.Values}" SelectedValue="{Binding Path=SelectedCameraDevice.WhiteBalance.Value}" ToolTip="{Binding Path=SelectedCameraDevice.WhiteBalance.Value}" ItemTemplate="{StaticResource G2Translated}" GotFocus="cmb_shutter_GotFocus" />
          </Grid>
          <Grid Margin="0,0,0,6" Visibility="{Binding SelectedCameraDevice.ExposureCompensation.Available, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="78" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource G2RowLabel}" Text="{T:Translate ExposureComp}" />
            <ComboBox Grid.Column="1" Name="cmb_EComp" BorderBrush="{Binding Path=SelectedCameraDevice.ExposureCompensation.ErrorColor}" IsEnabled="{Binding Path=SelectedCameraDevice.ExposureCompensation.IsEnabled}" ItemsSource="{Binding Path=SelectedCameraDevice.ExposureCompensation.Values}" SelectedValue="{Binding Path=SelectedCameraDevice.ExposureCompensation.Value}" GotFocus="cmb_shutter_GotFocus" />
          </Grid>
          <Grid Margin="0,0,0,6" Visibility="{Binding SelectedCameraDevice.CompressionSetting.Available, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="78" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource G2RowLabel}" Text="{T:Translate Compression}" />
            <ComboBox Grid.Column="1" Name="cmb_com" BorderBrush="{Binding Path=SelectedCameraDevice.CompressionSetting.ErrorColor}" IsEnabled="{Binding Path=SelectedCameraDevice.CompressionSetting.IsEnabled}" ItemsSource="{Binding Path=SelectedCameraDevice.CompressionSetting.Values}" SelectedValue="{Binding Path=SelectedCameraDevice.CompressionSetting.Value}" ToolTip="{Binding Path=SelectedCameraDevice.CompressionSetting.Value}" GotFocus="cmb_shutter_GotFocus" />
          </Grid>
          <Grid Margin="0,0,0,6" Visibility="{Binding SelectedCameraDevice.ExposureMeteringMode.Available, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="78" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource G2RowLabel}" Text="{T:Translate MeteringMode}" />
            <ComboBox Grid.Column="1" Name="cmb_meter" BorderBrush="{Binding Path=SelectedCameraDevice.ExposureMeteringMode.ErrorColor}" IsEnabled="{Binding Path=SelectedCameraDevice.ExposureMeteringMode.IsEnabled}" ItemsSource="{Binding Path=SelectedCameraDevice.ExposureMeteringMode.Values}" SelectedValue="{Binding Path=SelectedCameraDevice.ExposureMeteringMode.Value}" ToolTip="{Binding Path=SelectedCameraDevice.ExposureMeteringMode.Value}" ItemTemplate="{StaticResource G2Translated}" GotFocus="cmb_shutter_GotFocus" />
          </Grid>
          <Grid Margin="0,0,0,6" Visibility="{Binding SelectedCameraDevice.FocusMode.Available, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="78" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource G2RowLabel}" Text="{T:Translate FocusMode}" />
            <ComboBox Grid.Column="1" Name="cmb_focus" BorderBrush="{Binding Path=SelectedCameraDevice.FocusMode.ErrorColor}" IsEnabled="{Binding Path=SelectedCameraDevice.FocusMode.IsEnabled}" ItemsSource="{Binding Path=SelectedCameraDevice.FocusMode.Values}" SelectedValue="{Binding Path=SelectedCameraDevice.FocusMode.Value}" ToolTip="{Binding Path=SelectedCameraDevice.FocusMode.Value}" ItemTemplate="{StaticResource G2Translated}" GotFocus="cmb_shutter_GotFocus" />
          </Grid>
      <ItemsControl ItemsSource="{Binding Path=SelectedCameraDevice.Properties}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource G2RowLabel}" Text="{Binding Path=Name, Converter={StaticResource converter}}" ToolTip="{Binding Path=Name, Converter={StaticResource converter}}" />
              <ComboBox Grid.Column="1" BorderBrush="{Binding Path=ErrorColor}" IsEnabled="{Binding Path=IsEnabled}" ItemsSource="{Binding Path=Values}" SelectedValue="{Binding Path=Value}" ToolTip="{Binding Value}" ItemTemplate="{StaticResource G2Translated}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl Name="listBox1" ItemsSource="{Binding Path=SelectedCameraDevice.AdvancedProperties}">
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="{x:Type FrameworkElement}">
            <Style.Triggers>
              <DataTrigger Value="False" Binding="{Binding Available}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource G2RowLabel}" Text="{Binding Path=Name, Converter={StaticResource converter}}" ToolTip="{Binding Path=Name, Converter={StaticResource converter}}" />
              <ComboBox Grid.Column="1" BorderBrush="{Binding Path=ErrorColor}" IsEnabled="{Binding Path=IsEnabled}" ItemsSource="{Binding Path=Values}" SelectedValue="{Binding Path=Value}" ToolTip="{Binding Value}" ItemTemplate="{StaticResource G2Translated}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <Grid Margin="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="78" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Style="{StaticResource G2RowLabel}" Text="{T:Translate LabelTransfer}" />
      <ComboBox Grid.Column="1" Name="cmb_transfer" FontFamily="{StaticResource G2Font}" ToolTip="{Binding ElementName=cmb_transfer, Path=SelectedItem}" SelectionChanged="cmb_transfer_SelectionChanged" />
    </Grid>
  </StackPanel>
</UserControl>
