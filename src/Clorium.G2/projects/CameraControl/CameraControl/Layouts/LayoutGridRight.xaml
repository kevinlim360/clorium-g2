<?xml version="1.0" encoding="utf-8"?>
<Layouts:LayoutBase x:Class="CameraControl.Layouts.LayoutGridRight" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:CameraControl.Controls" xmlns:Core="clr-namespace:CameraControl.Core;assembly=CameraControl.Core" xmlns:Layouts="clr-namespace:CameraControl.Layouts" xmlns:viewModel="clr-namespace:CameraControl.ViewModel" xmlns:translation="clr-namespace:CameraControl.Core.Translation;assembly=CameraControl.Core" xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls" xmlns:classes="clr-namespace:CameraControl.Classes" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:zoomandpan="clr-namespace:ZoomAndPan;assembly=ZoomAndPan">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="LayoutBaseResource.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ToggleButton.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Combobox.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <FrameworkElement.DataContext>
    <viewModel:LayoutViewModel />
  </FrameworkElement.DataContext>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300*" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="150*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="0" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RowSpan="2" Margin="0,0,0,0">
      <Grid RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
        <FrameworkElement.LayoutTransform>
          <RotateTransform Angle="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=SelectedBitmap.FileItem.RotationAngle}" />
        </FrameworkElement.LayoutTransform>
        <zoomandpan:ZoomAndPanControl Name="zoomAndPanControl" Background="#00FFFFFF" MouseWheel="zoomAndPanControl_MouseWheel">
          <zoomandpan:ImageColorPicker Name="Image" HorizontalAlignment="Center" Margin="15" Stretch="Uniform" Source="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=SelectedBitmap.DisplayImage}" Width="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=SelectedBitmap.FileItem.FileInfo.Width}" Height="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=SelectedBitmap.FileItem.FileInfo.Height}" Scale="{Binding ElementName=zoomAndPanControl, Path=ViewportZoom}">
            <UIElement.InputBindings>
              <MouseBinding Gesture="LeftDoubleClick" Command="{Binding Path=ImageDoubleClickCommand}" />
            </UIElement.InputBindings>
            <UIElement.Effect>
              <DropShadowEffect ShadowDepth="10" Color="Black" BlurRadius="20" />
            </UIElement.Effect>
          </zoomandpan:ImageColorPicker>
        </zoomandpan:ZoomAndPanControl>
      </Grid>
      <MediaElement Name="VideoControl" Grid.Column="0" Grid.RowSpan="3" LoadedBehavior="Manual" UnloadedBehavior="Close" Visibility="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=SelectedBitmap.FileItem.IsMovie, Converter={StaticResource BooleanToVisibilityConverter}}" Source="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=SelectedBitmap.FileItem.FileName}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=SelectedBitmap.FileItem.IsMovie, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Button Height="50" Width="50" Margin="5" Style="{DynamicResource MaterialDesignFlatButton}" Click="Button_Click">
          <materialDesign:PackIcon Width="24" Height="24" Kind="Play" />
        </Button>
        <Button Height="50" Width="50" Margin="5" Style="{DynamicResource MaterialDesignFlatButton}" Click="Button_Click_1">
          <materialDesign:PackIcon Width="24" Height="24" Kind="Pause" />
        </Button>
        <Button Height="50" Width="50" Margin="5" Style="{DynamicResource MaterialDesignFlatButton}" Click="Button_Click_2">
          <materialDesign:PackIcon Width="24" Height="24" Kind="Stop" />
        </Button>
      </StackPanel>
    </Grid>
    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Grid.RowSpan="3" Margin="0,0,0,25" Background="{DynamicResource ControlBackgroundBrush}" />
    <ListBox Name="ImageLIstBox" Grid.Column="2" Grid.Row="1" BorderThickness="0" Margin="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=DefaultSession.Files, IsAsync=True}">
      <UIElement.InputBindings>
        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding Path=ImageDoubleClickCommand}" />
      </UIElement.InputBindings>
      <FrameworkElement.ContextMenu>
        <ContextMenu>
          <FrameworkElement.DataContext>
            <viewModel:MainMenuViewModel />
          </FrameworkElement.DataContext>
          <MenuItem CommandParameter="ViewExplorer" Header="{translation:Translate LabelShowInExplorer}" Command="{Binding SendCommand}" />
          <MenuItem CommandParameter="ViewExternal" Header="{translation:Translate LabelOpenInExternalViewer}" Command="{Binding SendCommand}" />
          <MenuItem CommandParameter="Del_Image" Header="{translation:Translate LabelDeleteFiles}" Command="{Binding SendCommand}" />
          <MenuItem Header="{translation:Translate LabelCopyFileNameClipboard}" Command="{Binding Path=CopyNameClipboardCommand}" />
        </ContextMenu>
      </FrameworkElement.ContextMenu>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ListBox>
    <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right" Orientation="Horizontal" Background="{DynamicResource WhiteBrush}" Margin="0,5,5,0">
      <Label Margin="0" Padding="0" Content="{Binding SelectedPhotoIndex}" />
      <Label Content="/" Margin="0" Padding="0" />
      <Label Margin="0" Padding="0" Content="{Binding ElementName=ImageLIstBox, Path=Items.Count}" />
    </StackPanel>
    <materialDesign:Card Grid.Row="2" Grid.ColumnSpan="3" Margin="4" Visibility="{Binding Source={x:Static Core:ServiceProvider.Branding}, Path=ShowThumbPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Border BorderBrush="#FF808080" BorderThickness="1">
        <DockPanel UseLayoutRounding="True" Margin="4">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <Button Margin="4" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding PrevImageCommand}">
              <materialDesign:PackIcon Width="24" Height="24" Kind="ArrowLeft" />
            </Button>
            <Button Margin="4" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding NextImageCommand}">
              <materialDesign:PackIcon Width="24" Height="24" Kind="ArrowRight" />
            </Button>
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal" Visibility="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=ShowThumbUpDown, Mode=TwoWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=false}">
              <ToggleButton Height="40" Width="40" Margin="2,-2" Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}" IsChecked="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=SelectedBitmap.FileItem.IsUnLiked}">
                <materialDesign:PackIcon Width="24" Height="24" Kind="ThumbDown" />
              </ToggleButton>
              <ToggleButton Height="40" Width="40" Margin="2,-2" Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}" IsChecked="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=SelectedBitmap.FileItem.IsLiked}">
                <materialDesign:PackIcon Width="24" Height="24" Kind="ThumbUp" />
              </ToggleButton>
            </StackPanel>
            <Button Margin="4" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{DynamicResource MaterialDesignFlatButton}" Command="{Binding Path=SelectNoneCommand}" ToolTip="{translation:Translate LabelSelectNone}">
              <materialDesign:PackIcon Width="24" Height="24" Kind="CheckboxBlankOutline" />
            </Button>
            <Button Margin="4" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{DynamicResource MaterialDesignFlatButton}" Command="{Binding Path=SelectAllCommand}" ToolTip="{translation:Translate LabelSelectAll}">
              <materialDesign:PackIcon Width="24" Height="24" Kind="CheckboxMarkedOutline" />
            </Button>
            <Button Margin="1" VerticalAlignment="Center" Content="Lr" FontSize="20" HorizontalAlignment="Right" Style="{DynamicResource MaterialDesignFlatButton}" Command="{Binding OpenInLightroomCommand}" ToolTip="{translation:Translate LabelOpenLightroom}" Visibility="{Binding LightroomIsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Margin="4" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{DynamicResource MaterialDesignFlatButton}" ToolTip="{translation:Translate LabelDeleteFiles}" Command="{Binding Path=DeleteItemCommand}">
              <materialDesign:PackIcon Width="24" Height="24" Kind="Delete" />
            </Button>
            <Button Margin="4" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{DynamicResource MaterialDesignFlatButton}" ToolTip="{translation:Translate LabelShowInExplorer}" Command="{Binding Path=OpenExplorerCommand}">
              <materialDesign:PackIcon Width="24" Height="24" Kind="FolderImage" />
            </Button>
            <Button Margin="4" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{DynamicResource MaterialDesignFlatButton}" ToolTip="{translation:Translate LabelRestoreFromBackup}" Command="{Binding Path=RestoreCommand}" IsEnabled="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=SelectedBitmap.FileItem.HaveBackupFile}">
              <materialDesign:PackIcon Width="24" Height="24" Kind="BackupRestore" />
            </Button>
            <Button Margin="4" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{DynamicResource MaterialDesignFlatButton}" ToolTip="{translation:Translate LabelRotateCounterclockwise}" Command="{Binding Path=RotateLeftCommand}">
              <materialDesign:PackIcon Width="24" Height="24" Kind="RotateLeftVariant" />
            </Button>
            <Button Margin="4" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{DynamicResource MaterialDesignFlatButton}" ToolTip="{translation:Translate LabelRotateClockwise}" Command="{Binding Path=RotateRightCommand}">
              <materialDesign:PackIcon Width="24" Height="24" Kind="RotateRightVariant" />
            </Button>
            <ItemsControl ItemsSource="{Binding PanelPlugins}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ContentControl Content="{Binding Control}" Visibility="{Binding Path=Visible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
            <ComboBox Width="50" VerticalAlignment="Center" HorizontalContentAlignment="Right" SelectedIndex="{Binding ZoomIndex}">
              <ComboBoxItem Content="Fit" />
              <ComboBoxItem Content="60 %" />
              <ComboBoxItem Content="100 %" />
              <ComboBoxItem Content="200 %" />
            </ComboBox>
          </StackPanel>
        </DockPanel>
      </Border>
    </materialDesign:Card>
  </Grid>
</Layouts:LayoutBase>