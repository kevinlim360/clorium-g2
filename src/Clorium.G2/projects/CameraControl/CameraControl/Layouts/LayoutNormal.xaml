<?xml version="1.0" encoding="utf-8"?>
<!-- Clorium G2 · design A: last captured image (stage) + slim tool bar + same-session thumbnails. -->
<Layouts:LayoutBase x:Class="CameraControl.Layouts.LayoutNormal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Core="clr-namespace:CameraControl.Core;assembly=CameraControl.Core" xmlns:Layouts="clr-namespace:CameraControl.Layouts" xmlns:translation="clr-namespace:CameraControl.Core.Translation;assembly=CameraControl.Core" xmlns:classes="clr-namespace:CameraControl.Classes" xmlns:viewModel="clr-namespace:CameraControl.ViewModel" xmlns:zoomandpan="clr-namespace:ZoomAndPan;assembly=ZoomAndPan" xmlns:i1="http://schemas.microsoft.com/xaml/behaviors" mc:Ignorable="d">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="LayoutBaseResource.xaml" />
        <ResourceDictionary Source="pack://application:,,,/CameraControl;component/styles/g2theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <classes:G2FaceTagConverter x:Key="G2FaceTag" />
      <!-- thumbnails: image only + face tag (PR_F / PR_B / F / B / D) -->
      <Style x:Key="G2ThumbItem" TargetType="ListBoxItem">
        <EventSetter Event="MouseDoubleClick" Handler="DoubleClickHandler" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="ring" Padding="2" CornerRadius="7" BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource G2Line2}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource G2Accent}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="G2ThumbTemplate">
        <Border CornerRadius="5" BorderThickness="1" BorderBrush="{Binding Name, Converter={StaticResource G2FaceTag}, ConverterParameter=border}" Background="{StaticResource G2Panel2}" ClipToBounds="True" Height="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=ThumbHeigh}" ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="20000">
          <FrameworkElement.ToolTip>
            <ToolTip>
              <StackPanel MinWidth="170">
                <TextBlock FontFamily="{StaticResource G2Mono}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,5" Text="{Binding Name}" />
                <Grid TextElement.FontSize="11.5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Opacity="0.7" Text="조리개" /><TextBlock Grid.Row="0" Grid.Column="1" FontFamily="{StaticResource G2Mono}" Text="{Binding F, StringFormat=f/{0}}" />
                  <TextBlock Grid.Row="1" Opacity="0.7" Text="셔터" /><TextBlock Grid.Row="1" Grid.Column="1" FontFamily="{StaticResource G2Mono}" Text="{Binding E}" />
                  <TextBlock Grid.Row="2" Opacity="0.7" Text="ISO" /><TextBlock Grid.Row="2" Grid.Column="1" FontFamily="{StaticResource G2Mono}" Text="{Binding Iso}" />
                  <TextBlock Grid.Row="3" Opacity="0.7" Text="초점거리" /><TextBlock Grid.Row="3" Grid.Column="1" FontFamily="{StaticResource G2Mono}" Text="{Binding FocalLength}" />
                  <TextBlock Grid.Row="4" Opacity="0.7" Text="노출보정" /><TextBlock Grid.Row="4" Grid.Column="1" FontFamily="{StaticResource G2Mono}" Text="{Binding ExposureBias}" />
                </Grid>
              </StackPanel>
            </ToolTip>
          </FrameworkElement.ToolTip>
          <Grid>
            <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Path=Thumbnail}">
              <FrameworkElement.LayoutTransform>
                <RotateTransform Angle="{Binding RotationAngle}" />
              </FrameworkElement.LayoutTransform>
            </Image>
            <Border Margin="4" Padding="5,1" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{Binding Name, Converter={StaticResource G2FaceTag}, ConverterParameter=brush}" Visibility="{Binding Name, Converter={StaticResource G2FaceTag}, ConverterParameter=visibility}">
              <TextBlock FontFamily="{StaticResource G2Mono}" FontSize="10.5" FontWeight="SemiBold" Foreground="White" Text="{Binding Name, Converter={StaticResource G2FaceTag}}" />
            </Border>
            <CheckBox Margin="0,5,5,0" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" ToolTip="선택 (휴지통으로 한꺼번에 삭제)" IsChecked="{Binding Path=IsChecked}">
              <CheckBox.Template>
                <ControlTemplate TargetType="CheckBox">
                  <Border x:Name="box" Width="18" Height="18" CornerRadius="4" BorderThickness="1.5" BorderBrush="#E6FFFFFF" Background="#66000000">
                    <Path x:Name="mark" Data="M4,9 L7.5,12.5 L14,5.5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="box" Property="BorderBrush" Value="White" />
                      <Setter TargetName="box" Property="Background" Value="#99000000" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="box" Property="Background" Value="{StaticResource G2Accent}" />
                      <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource G2Accent}" />
                      <Setter TargetName="mark" Property="Visibility" Value="Visible" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </CheckBox.Template>
            </CheckBox>
            <Ellipse Width="18" Height="18" StrokeThickness="2.5" Stroke="{StaticResource G2Accent}" StrokeDashArray="3 2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Loading, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </Grid>
        </Border>
      </DataTemplate>
      <Style x:Key="G2OverlayChip" TargetType="Border">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{StaticResource G2Overlay}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <FrameworkElement.DataContext>
    <viewModel:LayoutViewModel />
  </FrameworkElement.DataContext>
  <Grid TextElement.FontFamily="{StaticResource G2Font}" TextElement.Foreground="{StaticResource G2Text}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ===== stage: last captured image ===== -->
    <Grid Grid.Row="0" Background="{StaticResource G2Stage}" ClipToBounds="True">
      <Grid RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
        <FrameworkElement.LayoutTransform>
          <RotateTransform Angle="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=SelectedBitmap.FileItem.RotationAngle}" />
        </FrameworkElement.LayoutTransform>
        <zoomandpan:ZoomAndPanControl Name="zoomAndPanControl" Background="#00FFFFFF" MouseWheel="zoomAndPanControl_MouseWheel">
          <Border Name="MainAestheticImageBorder" Margin="56,56,56,64" Background="White">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource G2Line}" />
                <Setter Property="BorderThickness" Value="2" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=IsAestheticImprovementActive}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource G2Pr}" />
                    <Setter Property="BorderThickness" Value="3" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <UIElement.Effect>
              <DropShadowEffect ShadowDepth="2" Color="#FF16181C" BlurRadius="16" Opacity="0.14" />
            </UIElement.Effect>
            <zoomandpan:ImageColorPicker Name="Image" HorizontalAlignment="Center" Margin="0" Stretch="Uniform" Source="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=SelectedBitmap.DisplayImage}" Width="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=SelectedBitmap.FileItem.FileInfo.Width}" Height="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=SelectedBitmap.FileItem.FileInfo.Height}" Scale="{Binding ElementName=zoomAndPanControl, Path=ViewportZoom}">
              <UIElement.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding Path=ImageDoubleClickCommand}" />
              </UIElement.InputBindings>
            </zoomandpan:ImageColorPicker>
          </Border>
        </zoomandpan:ZoomAndPanControl>
      </Grid>
      <MediaElement Name="VideoControl" LoadedBehavior="Manual" UnloadedBehavior="Close" Visibility="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=SelectedBitmap.FileItem.IsMovie, Converter={StaticResource BooleanToVisibilityConverter}}" Source="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=SelectedBitmap.FileItem.FileName}" />

      <!-- top-left badge -->
      <Border Style="{StaticResource G2OverlayChip}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,14,0,0">
        <TextBlock Text="직전 촬영 이미지" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
      </Border>
      <!-- top-right: PR state + zoom -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,16,0">
        <Border Style="{StaticResource G2OverlayChip}" Background="{StaticResource G2PrBg}" Margin="0,0,6,0" Visibility="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=IsAestheticImprovementActive, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Fill="{StaticResource G2Pr}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="미감개선 ON" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource G2Pr}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <ComboBox Width="78" Height="30" Background="{StaticResource G2Overlay}" BorderBrush="Transparent" ToolTip="확대 배율" SelectedIndex="{Binding ZoomIndex}">
          <ComboBoxItem Content="맞춤" />
          <ComboBoxItem Content="60 %" />
          <ComboBoxItem Content="100 %" />
          <ComboBoxItem Content="200 %" />
        </ComboBox>
      </StackPanel>
      <!-- video transport -->
      <Border Style="{StaticResource G2OverlayChip}" Height="40" Padding="4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,66" Visibility="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=SelectedBitmap.FileItem.IsMovie, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource G2IconButton}" Width="32" Height="32" ToolTip="재생" Click="Button_Click"><Viewbox Width="18" Height="18"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoPlay}" /></Viewbox></Button>
          <Button Style="{StaticResource G2IconButton}" Width="32" Height="32" ToolTip="일시정지" Click="Button_Click_1"><Viewbox Width="18" Height="18"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoPause}" /></Viewbox></Button>
          <Button Style="{StaticResource G2IconButton}" Width="32" Height="32" ToolTip="정지" Click="Button_Click_2"><Viewbox Width="18" Height="18"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoStop}" /></Viewbox></Button>
        </StackPanel>
      </Border>
      <!-- bottom info bar: file name + exposure -->
      <Border Style="{StaticResource G2OverlayChip}" Height="40" Padding="14,0,6,0" VerticalAlignment="Bottom" Margin="16,0,16,14" DataContext="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=SelectedBitmap.FileItem}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Margin="12,0,4,0" FontSize="11" Foreground="{StaticResource G2Sub}" VerticalAlignment="Center" Text="F" />
            <TextBlock FontFamily="{StaticResource G2Mono}" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" Text="{Binding F}" />
            <TextBlock Margin="14,0,4,0" FontSize="11" Foreground="{StaticResource G2Sub}" VerticalAlignment="Center" Text="셔터" />
            <TextBlock FontFamily="{StaticResource G2Mono}" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" Text="{Binding E}" />
            <TextBlock Margin="14,0,4,0" FontSize="11" Foreground="{StaticResource G2Sub}" VerticalAlignment="Center" Text="ISO" />
            <TextBlock FontFamily="{StaticResource G2Mono}" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" Text="{Binding Iso}" Margin="0,0,10,0" />
          </StackPanel>
          <TextBlock FontFamily="{StaticResource G2Mono}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
        </DockPanel>
      </Border>
    </Grid>

    <!-- ===== slim bar above thumbnails ===== -->
    <Border Grid.Row="1" Height="36" Background="{StaticResource G2Panel}" BorderBrush="{StaticResource G2Line}" BorderThickness="0,1,0,0" Padding="10,0" Visibility="{Binding Source={x:Static Core:ServiceProvider.Branding}, Path=ShowThumbPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock FontFamily="{StaticResource G2Mono}" FontSize="11.5" Foreground="{StaticResource G2Sub}" VerticalAlignment="Center">
            <Run Text="{Binding SelectedPhotoIndex, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding ElementName=ImageLIstBox, Path=Items.Count, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel.Resources>
            <Style TargetType="Button" BasedOn="{StaticResource G2IconButton}">
              <Setter Property="Margin" Value="0,0,12,0" />
            </Style>
            <Style TargetType="ToggleButton" BasedOn="{StaticResource G2IconToggle}">
              <Setter Property="Margin" Value="0,0,12,0" />
            </Style>
          </StackPanel.Resources>
          <TextBlock Text="이 세션 사진" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,16,0" />
          <Button ToolTip="이전 사진" Command="{Binding PrevImageCommand}"><Viewbox Width="16" Height="16"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoArrowL}" /></Viewbox></Button>
          <Button ToolTip="다음 사진" Command="{Binding NextImageCommand}"><Viewbox Width="16" Height="16"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoArrowR}" /></Viewbox></Button>
          <Border Width="1" Height="16" Background="{StaticResource G2Line}" Margin="0,0,12,0" />
          <StackPanel Orientation="Horizontal" Visibility="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=ShowThumbUpDown, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ToggleButton Width="28" Height="28" ToolTip="별로예요" IsChecked="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=SelectedBitmap.FileItem.IsUnLiked}"><Viewbox Width="16" Height="16"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoThumbDown}" /></Viewbox></ToggleButton>
            <ToggleButton Width="28" Height="28" ToolTip="좋아요" IsChecked="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=SelectedBitmap.FileItem.IsLiked}"><Viewbox Width="16" Height="16"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoThumbUp}" /></Viewbox></ToggleButton>
          </StackPanel>
          <Button ToolTip="{translation:Translate LabelSelectNone}" Command="{Binding Path=SelectNoneCommand}"><Viewbox Width="16" Height="16"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoCheckNone}" /></Viewbox></Button>
          <Button ToolTip="{translation:Translate LabelSelectAll}" Command="{Binding Path=SelectAllCommand}"><Viewbox Width="16" Height="16"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoCheckAll}" /></Viewbox></Button>
          <Button ToolTip="{translation:Translate LabelRotateCounterclockwise}" Command="{Binding Path=RotateLeftCommand}"><Viewbox Width="16" Height="16"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoRotL}" /></Viewbox></Button>
          <Button ToolTip="{translation:Translate LabelRotateClockwise}" Command="{Binding Path=RotateRightCommand}"><Viewbox Width="16" Height="16"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoRotR}" /></Viewbox></Button>
          <Button ToolTip="{translation:Translate LabelShowInExplorer}" Command="{Binding Path=OpenExplorerCommand}"><Viewbox Width="16" Height="16"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoExplorer}" /></Viewbox></Button>
          <Button ToolTip="{translation:Translate LabelRestoreFromBackup}" Command="{Binding Path=RestoreCommand}" IsEnabled="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=SelectedBitmap.FileItem.HaveBackupFile}"><Viewbox Width="16" Height="16"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoRestore}" /></Viewbox></Button>
          <Button Width="NaN" Padding="6,0" ToolTip="{translation:Translate LabelOpenLightroom}" Command="{Binding OpenInLightroomCommand}" Visibility="{Binding LightroomIsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Lr" FontFamily="{StaticResource G2Mono}" FontSize="12" FontWeight="SemiBold" /></Button>
          <Button Foreground="{StaticResource G2Err}" ToolTip="삭제 · 체크한 사진 전부 (체크가 없으면 선택한 사진)" Command="{Binding Path=DeleteItemCommand}"><Viewbox Width="16" Height="16"><Path Style="{StaticResource G2IconPath}" Data="{StaticResource G2IcoTrash}" /></Viewbox></Button>
          <ItemsControl ItemsSource="{Binding PanelPlugins}" VerticalAlignment="Center">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ContentControl Content="{Binding Control}" Visibility="{Binding Path=Visible, Converter={StaticResource BooleanToVisibilityConverter}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== same-session thumbnails ===== -->
    <ListBox Name="ImageLIstBox" Grid.Row="2" Padding="14,10,14,8" Background="{StaticResource G2Panel}" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" IsSynchronizedWithCurrentItem="True" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource G2ThumbItem}" ItemTemplate="{StaticResource G2ThumbTemplate}" ItemsSource="{Binding Source={x:Static Core:ServiceProvider.Settings}, Path=DefaultSession.Files, IsAsync=True}">
      <ListBox.Template>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{TemplateBinding Background}">
            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ItemsPresenter />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </ListBox.Template>
      <i1:Interaction.Behaviors>
        <classes:HorizontalScrollBehavior />
      </i1:Interaction.Behaviors>
      <FrameworkElement.ContextMenu>
        <ContextMenu>
          <FrameworkElement.DataContext>
            <viewModel:MainMenuViewModel />
          </FrameworkElement.DataContext>
          <MenuItem CommandParameter="ViewExplorer" Header="{translation:Translate LabelShowInExplorer}" Command="{Binding SendCommand}" />
          <MenuItem CommandParameter="ViewExternal" Header="{translation:Translate LabelOpenInExternalViewer}" Command="{Binding SendCommand}" />
          <MenuItem CommandParameter="ViewColorCompensation" Header="{translation:Translate LabelShowColorCompensation}" Command="{Binding SendCommand}" />
          <MenuItem CommandParameter="Del_Image" Header="{translation:Translate LabelDeleteFiles}" Command="{Binding SendCommand}" />
          <MenuItem Header="{translation:Translate LabelCopyFileNameClipboard}" Command="{Binding Path=CopyNameClipboardCommand}" />
        </ContextMenu>
      </FrameworkElement.ContextMenu>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel Orientation="Horizontal" VerticalAlignment="Center" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ListBox>
  </Grid>
</Layouts:LayoutBase>
