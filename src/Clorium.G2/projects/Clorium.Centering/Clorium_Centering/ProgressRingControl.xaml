<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Clorium_Centering.ProgressRingControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Visibility="Collapsed" xmlns:clorium_centering="clr-namespace:Clorium_Centering">
  <Grid Background="#44000000">
    <Grid Width="250" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Ellipse Stroke="#FFFFFFFF" StrokeThickness="30" Opacity="0.5" />
      <Ellipse StrokeThickness="30" StrokeDashArray="4 4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
        <Shape.Stroke>
          <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
            <GradientStop Color="Blue" Offset="0.0" />
            <GradientStop Color="Red" Offset="0.2" />
            <GradientStop Color="Green" Offset="1" />
          </LinearGradientBrush>
        </Shape.Stroke>
        <UIElement.RenderTransform>
          <RotateTransform x:Name="rotate" Angle="0" />
        </UIElement.RenderTransform>
        <FrameworkElement.Triggers>
          <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
              <Storyboard RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:2">
                  <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </FrameworkElement.Triggers>
      </Ellipse>
      <TextBlock Text="처리 중..." Foreground="#FFFFFFFF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0" />
    </Grid>
  </Grid>
</UserControl>