<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <TargetFrameworkRootPath>$(MSBuildThisFileDirectory)../../framework-refs/net472/</TargetFrameworkRootPath>
    <EnableFrameworkPathOverride>false</EnableFrameworkPathOverride>
    <NoStdLib>true</NoStdLib>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Clorium AutoSizing</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="mscorlib"><HintPath>../../framework-refs/net472/.NETFramework/v4.7.2/mscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PresentationCore"><HintPath>../../framework-refs/net472/.NETFramework/v4.7.2/PresentationCore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Management"><HintPath>../../framework-refs/net472/.NETFramework/v4.7.2/System.Management.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>../../framework-refs/net472/.NETFramework/v4.7.2/System.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="WindowsBase"><HintPath>../../framework-refs/net472/.NETFramework/v4.7.2/WindowsBase.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Memory"><HintPath>../../dependencies/AutoSizing.Standalone/system.memory.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Text.Json"><HintPath>../../dependencies/AutoSizing.Standalone/system.text.json.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../resources/AutoSizing.Standalone/*.resources" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../resources/AutoSizing.Standalone/costura.*" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
  <Import Project="../../framework-refs/net472/Microsoft.NETFramework.ReferenceAssemblies.net472.targets" />
</Project>